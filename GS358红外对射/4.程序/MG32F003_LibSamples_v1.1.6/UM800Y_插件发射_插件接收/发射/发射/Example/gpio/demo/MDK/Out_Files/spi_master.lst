 148          void spi_irq_init(uint8_t irq_enable, uint8_t spi_irq_type,void (*pfunc)())
 149          {
 150   1        if(irq_enable == SPI_IRQ_ENABLE)
 151   1        {
 152   2          switch(spi_irq_type)
 153   2          {
 154   3            case SPI_RXNE_IE:
 155   3              REG_SPI_SPIIE |= (1<<SPI_RXNE_IE);      //SPI错误中断使能
 156   3              break;
 157   3            case SPI_TXE_IE:
 158   3              REG_SPI_SPIIE |= (1<<SPI_TXE_IE);     //SPI TXBUF空中断使能
 159   3              break;
 160   3            case SPI_ERROR_IE:
 161   3              REG_SPI_SPIIE |= (1<<SPI_ERROR_IE);     //SPI RXBUF非空中断使能
 162   3              break;
 163   3            default:
 164   3              break;
 165   3          }
 166   2          
 167   2        spi_func = pfunc;                   //SPI中断回调函数
 168   2        SPIINTEN = 1;                     //使能SPI中断
 169   2        EA = 1;                         //使能总中断
 170   2        }
 171   1        else
