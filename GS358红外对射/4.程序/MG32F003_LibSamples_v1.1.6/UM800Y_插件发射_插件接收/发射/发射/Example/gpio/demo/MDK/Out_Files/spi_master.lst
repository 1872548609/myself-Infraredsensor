 251          //全双工
 252          uint8_t spi0_master_full_duplex_tranfer(uint8_t *send_buff, uint8_t *rec_buff, uint32_t length)
 253          {
 254   1        uint32_t time_out = 0xFFFFFFFF;
 255   1        while(length--)
 256   1        {
 257   2          while(!(REG_SPI_SPSR & (1<<SPI_TXE_IF)));   //等待发送缓存为空
 258   2          {
 259   3            if((time_out--) == 0)
 260   3            {
 261   4              return 1;
 262   4            }
 263   3          }
 264   2          REG_SPI_TXBUF = *send_buff++;
 265   2          time_out = 0xFFFFFFFF;  
 266   2          while((REG_SPI_SPSR & (1<<SPI_BUSY_IF)));   //等待BUSY=0
 267   2          
 268   2          while(!(REG_SPI_SPSR & (1<<SPI_RXF_IF)));   //等待接收缓存非空，RXBF事件    
 269   2          {
 270   3            if((time_out--) == 0)
 271   3            {
 272   4              return 1;
 273   4            }
 274   3          }
 275   2          *rec_buff++ = REG_SPI_RXBUF;
 276   2        }
 277   1        
 278   1        return 0;
 279   1      }
