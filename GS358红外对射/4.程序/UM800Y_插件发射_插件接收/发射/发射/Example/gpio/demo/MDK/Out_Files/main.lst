  22          /*
  23           * 系统主频：24 MHz
  24           *
  25           * PWM周期：
  26           * 24 MHz × 100 us = 2400
  27           *
  28           * PWM有效脉宽：
  29           * 24 MHz × 10 us = 240
  30           *
  31           * 占空比：
  32           * 10 us / 100 us = 10%
  33           */
  34          #define SYSTEM_CLOCK_HZ           24000000UL
  35          #define PWM_TX_PERIOD_US          100UL
  36          #define PWM_TX_PULSE_US           5UL
  37          
  38          #define PWM_TX_PERIOD_COUNT       \
