  51          /************************************************************************
  52           * Function     : uart2_set_baud_rate
  53           * Description  : uart2 set baud rate
C51 COMPILER V9.60.0.0   UART2                                                             07/12/2022 09:58:33 PAGE 2   

  54           * Input    : uint32_t clk_hz: cpu frequency
  55           *              uint32_t baud_rate: Series rate                 
  56           * Output   : none  
  57           * Return   : none
  58           ************************************************************************/
  59          static void uart2_set_baud_rate(uint32_t clk_hz, uint32_t baud_rate)  
  60          { 
  61   1        uint16_t temp;
  62   1        uint8_t MSbyte, LSbyte;
  63   1          
  64   1        temp = clk_hz / baud_rate;
  65   1        
  66   1        MSbyte = temp>>8;
  67   1        LSbyte = temp;
  68   1        
  69   1        REG_UART2_BRPH = MSbyte;
  70   1        REG_UART2_BRPL = LSbyte+1;    
  71   1      }
  72          
  73          /************************************************************************
  74           * Function     : uart2_init
  75           * Description  : uart2 initial for  baud_rate
  76           * Input    : uint32_t baud_rate: Series rate 
  77           * Output   : none
  78           * Return   : none
  79           ************************************************************************/
  80          void uart2_init(uint32_t baud_rate)
  81          {
  82   1        
  83   1        PCLK1 |= (1<<7);                  //开UART2时钟使能 
  84   1        PRESET1 |= (1<<7);                //UART2正常工作
  85   1        
  86   1        REG_P03_CFG = 0x2;                  //P03复用为UART2_TX
  87   1        REG_P04_CFG = 0x1;                  //P04复用为UART2_RX
  88   1        
  89   1        REG_UART2_CR |= (1<<3);           //无奇偶校验
  90   1        REG_UART2_CR |= (1<<1);           //发送数据使能  
  91   1      
  92   1        uart2_set_baud_rate(system_core_clock,baud_rate);     //设置波特率
  93   1        
  94   1        P0PU &= ~(3<<3);                  //使能P03,P04内部上拉
  95   1      }
