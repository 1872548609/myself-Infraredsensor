 157          /************************************************************************
 158           * Function     : uart2_send_bytes
 159           * Description  : uart2 send bytes  发送多个字节
 160           * Input    : uint8_t* buff: out buffer
 161           *            uint32_t length: buffer length
 162           * Output   : none  
 163           * Return   : none
 164           ************************************************************************/
 165          void uart2_send_bytes(uint8_t *buff, uint32_t length)
 166          {
 167   1        while(length--)
 168   1        {
 169   2          uart2_send_byte(*buff++);
 170   2        } 
 171   1      }
