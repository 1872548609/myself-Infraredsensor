  17          /************************************************************************
  18           * Function     : UART2_IRQHandler
  19           * Description  : uart2 interrupt handling
  20           * Input    : none
  21           * Output   : none   
  22           * Return   : none
  23           ************************************************************************/
  24          void UART2_IRQHandler(void) interrupt 16
  25          {
  26   1        if(REG_UART2_ISR & 0x20)                      //FIFO非空中断
  27   1        {
  28   2          if(uart2_func != NULL)
  29   2          {
  30   3            ((void(*)())(uart2_func))();            //uart2的接收处理回调函数
  31   3            REG_UART2_ISR &= ~(1<<5);             //清除FIFO_NE非空标志位
  32   3          }
  33   2        } 
  34   1      #ifdef UART2_TX_INT_MODE      
                else if(REG_UART2_ISR & 0x02)             //发送完成中断
                {
                  if(!(REG_UART2_ISR & (1<<1)))
                  {
                    uart2_tx_flag = 1;
                    REG_UART2_ISR &= ~(1<<1);             //清除发送完成标志位
                  }
                } 
              #endif
  44   1        else
  45   1        {
  46   2          REG_UART2_ISR = 0x00;                 //清除中断状态
  47   2        }
  48   1      
  49   1      }
