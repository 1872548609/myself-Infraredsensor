 126          /************************************************************************
 127           * Function     : uart2_send_byte
 128           * Description  : uart2 发送一个字节数据
 129           * Input    : char c: out byte
 130           * Output   : none  
 131           * Return   : none
 132           ************************************************************************/
 133          void uart2_send_byte(char c)
 134          {
 135   1        //输出一个字符
 136   1        uint16_t timeout;
 137   1        timeout = 65535;
 138   1        
 139   1        REG_UART2_TDR = c;
 140   1      
 141   1      #ifdef UART2_TX_INT_MODE                    //中断方式
                while(!uart2_tx_flag);    
                uart2_tx_flag = 0;    
              #else                           //查询方式
 145   1        while((REG_UART2_ISR & 0x02) != 0x02)         //等待数据发送完成
 146   1        {   
 147   2          if((timeout--)==0)                //超时等待退出
 148   2          {   
 149   3            break;    
 150   3          }   
 151   2        }   
 152   1        REG_UART2_ISR &= ~(1<<1);               //清除发送完成标志位
 153   1      
 154   1      #endif
 155   1      }
