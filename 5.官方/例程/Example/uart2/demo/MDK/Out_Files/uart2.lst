  97          /************************************************************************
  98           * Function     : uart2_irq_init
  99           * Description  : uart2 interrupt enable
 100           * Input    : uint8_t irqstate: 0 中断失能，1 中断使能
 101           *            *pfunc_recv)(): 接收处理回调函数
 102           * Output   : none
 103           * Return   : none
 104           ************************************************************************/
 105          void uart2_irq_init(uint8_t irqstate,void (*pfunc_recv)())
 106          {
 107   1        if(irqstate == UART2_IRQ_ENABLE)
 108   1        {
 109   2          EA = 1;                   //打开总中断开关
 110   2          UART2INTEN = 1;           //使能UART2中断
 111   2          
 112   2      #ifdef UART2_TX_INT_MODE      //发送采用中断方式
                  REG_UART2_IER = 0x22;     //接收FIFO非空中断使能，发送完成中断使能,enable Rx/Tx_INT,disable else int
              #else                         //发送采用查询方式
 115   2          REG_UART2_IER = 0x20;                 //接收FIFO非空中断使能，发送完成中断不使能,enable Rx_INT,disable Tx_IN
C51 COMPILER V9.60.0.0   UART2                                                             07/12/2022 09:58:33 PAGE 3   

             -T and else int    
 116   2      #endif  
 117   2          uart2_func = pfunc_recv;  //接收中断回调函数
 118   2        }
 119   1        else
 120   1        {
 121   2          UART2INTEN = 0;           //关闭UART2中断
 122   2        }
 123   1          
 124   1      }
