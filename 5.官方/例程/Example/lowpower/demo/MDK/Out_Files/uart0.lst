 150          /************************************************************************
 151           * Function     : uart0_send_bytes
 152           * Description  : uart0 send bytes  发送多个字节
 153           * Input    : uint8_t* buff: out buffer
 154           *            uint32_t length: buffer length
 155           * Output   : none  
 156           * Return   : none
 157           ************************************************************************/
 158          void uart0_send_bytes(uint8_t *buff, uint32_t length)
 159          {
 160   1        while(length--)
 161   1        {
 162   2          uart0_send_byte(*buff++);
 163   2        } 
 164   1      }
