 119          /************************************************************************
 120           * Function     : uart0_send_byte
 121           * Description  : uart0 发送一个字节数据
 122           * Input    : char c: out byte
 123           * Output   : none  
 124           * Return   : none
 125           ************************************************************************/
 126          void uart0_send_byte(char c)
 127          {
 128   1        //输出一个字符
 129   1        uint16_t timeout;
 130   1        timeout = 65535;
 131   1        
 132   1        S0BUF = c;
 133   1      
 134   1      #ifdef UART0_TX_INT_MODE          //中断方式
                while(!tx_flag);
                tx_flag = 0; 
              #else 
 138   1        //查询方式
 139   1          while(!(TI0))                 //等待数据发送完成
 140   1        {
 141   2          if((timeout--) == 0)        //超时等待退出
 142   2              {
 143   3            break;
 144   3              }
 145   2        }
 146   1        TI0 = 0;                      //清除发送完成标志位
 147   1      #endif
 148   1      }
