 381   2          can_rx_msg->recv_data[7] = REG_CAN_RXBUF2;        //获取第8个数据
 382   2          rx_data = REG_CAN_RXBUF3;
 383   2        }
 384   1        
 385   1        REG_CAN_ISR = 0x08;
 386   1      
 387   1      }
