  30   3            ((void(*)())(can_callback))();            //can的回调函数
  31   3          }
  32   2          REG_CAN_ISR = CAN_IMR_RIM;
  33   2        }
  34   1        else 
  35   1        {
  36   2          REG_CAN_ISR = 0x7f;
  37   2        }
  38   1      
  39   1      }
