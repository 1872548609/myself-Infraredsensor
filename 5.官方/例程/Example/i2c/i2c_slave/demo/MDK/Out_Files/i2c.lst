 155           ************************************************************************/
 156          uint8_t i2c_read_byte(void)
 157          {
 158   1        uint8_t byte;
 159   1        
 160   1        REG_I2C_CR0 &= ~MTX;                //作为接收器
 161   1        
 162   1        while(!(REG_I2C_SR1 & RXNE));       //等待接收数据寄存器非空
 163   1        
 164   1        while(!(REG_I2C_SR0 & MTF));        //等待字节传输完成
 165   1        REG_I2C_SR0 = MTF;
 166   1        
 167   1        byte = REG_I2C_DR;
 168   1            
 169   1        return byte;
 170   1      }
