 276          /************************************************************************
 277           * Function     : i2c_slave_init
 278           * Description  : i2c_slave_init  I2C从机初始化
 279           * Input        : none
 280           * Output       : none  
 281           * Return       : none
 282           ************************************************************************/
 283          void i2c_slave_init(void)
 284          {
 285   1        PCLK0 |= (1<<7);              //打开I2C模块时钟
 286   1        PRESET0 |= (1<<7);            //释放I2C复位
 287   1              
 288   1        P0PU &= ~(1<<4);              //P04上拉
 289   1        P1PU &= ~(1<<0);              //P10上拉
 290   1        
 291   1        REG_P04_CFG = 0x03;           //I2C_SDA     
 292   1        REG_P10_CFG = 0x04;           //I2C_SCL 
 293   1        
 294   1        REG_I2C_CR1 |= (1<<5);        //使能开漏模式    
 295   1        REG_I2C_SR0 |= MTF;           //清除传输完成状态位
 296   1        REG_I2C_CR1 |= MTX_ANTO_EN;   //SLAVE模式下自动切换SDA传输方向
 297   1        REG_I2C_CR0 |= (1<<1);        //hold_en使能
 298   1        REG_I2C_CR0 |= MEN;           //I2C使能
 299   1        
 300   1      }
