 328          /************************************************************************
 329          * Function    : i2c_slave_read
 330          * Description : i2c_slave_read
 331          * Input       : uint8_t *rxdata: 要接收的数据
 332          * Output      : none  
 333          * Return      : datalen 数据传输长度
 334          ************************************************************************/
 335          uint8_t i2c_slave_read(uint8_t *rxdata)
 336          {
 337   1        uint8_t datalen;
 338   1        
 339   1        datalen = 0;
 340   1        
 341   1        while((REG_I2C_SR0 & MBB)) //MBB
 342   1        {
 343   2          if((REG_I2C_SR1 & RXNE) == RXNE) //接收时数据寄存器非空
 344   2          { 
 345   3            rxdata[datalen] = i2c_read_byte();
 346   3            datalen++;
 347   3          }
 348   2        }
 349   1        REG_I2C_SR0 = MTF;
 350   1      
 351   1        return datalen;
 352   1      } 
