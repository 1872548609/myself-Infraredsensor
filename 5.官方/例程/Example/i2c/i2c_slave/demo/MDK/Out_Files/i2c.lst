 180          void i2c_irq_enable(uint8_t irq_type,void (*pfunc)())
 181          {
 182   1        EA = 1;                               //打开总中断开关
 183   1        IEN1 |= (1<<5);                       //打开i2c中断开关
 184   1        switch(irq_type)
 185   1        {
 186   2          case I2C_IRQ_MTF:
 187   2          {
 188   3            REG_I2C_CR0 |= MIEN;
 189   3            i2c_irq[0] = pfunc;
 190   3            break;
 191   3          }
 192   2          case I2C_IRQ_MAAS1:
 193   2          {
 194   3            REG_I2C_CR0 |= MAAS1_INT_EN;
 195   3            i2c_irq[1] = pfunc;
 196   3            break;
 197   3          }
 198   2          case I2C_IRQ_MAAS2:
 199   2          {
 200   3            REG_I2C_CR1 |= MAAS2_INT_EN;
 201   3            i2c_irq[2] = pfunc;
 202   3            break;
 203   3          }
 204   2          case I2C_IRQ_RXNE:
 205   2          {
 206   3            REG_I2C_CR1 |= RXNE_INT_EN;
 207   3            i2c_irq[3] = pfunc;
 208   3            break;
 209   3          }
 210   2          case I2C_IRQ_TXE:
 211   2          {
 212   3            REG_I2C_CR1 |= TXE_INT_EN;
 213   3            i2c_irq[4] = pfunc;
 214   3            break;
 215   3          }
 216   2          case I2C_IRQ_WBT:
 217   2          {
 218   3            REG_I2C_CR1 |= WBT_INT_EN;
 219   3            i2c_irq[5] = pfunc;
 220   3            break;
 221   3          }
 222   2        }
 223   1      }
