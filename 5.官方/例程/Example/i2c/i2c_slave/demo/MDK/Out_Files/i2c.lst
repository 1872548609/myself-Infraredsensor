 135           * Output       : none  
 136           * Return       : none
 137           ************************************************************************/
 138          void i2c_write_byte(uint8_t byte)
 139          { 
 140   1        while(!(REG_I2C_SR1 & TXE));        //等待TXE为空
 141   1        
 142   1        REG_I2C_DR = byte;            //发送数据
 143   1        
 144   1        while(!(REG_I2C_SR0 & MTF));        //等待字节传输完成
 145   1        REG_I2C_SR0 = MTF;  
 146   1        
 147   1      }
