 364   1        uint8_t datalen;
C51 COMPILER V9.60.0.0   I2C                                                               04/24/2022 14:30:19 PAGE 7   

 365   1        
 366   1        datalen = 0;
 367   1        
 368   1        while(!(REG_I2C_SR0 & MTF)); 
 369   1        REG_I2C_SR0 = MTF;
 370   1        REG_I2C_DR = txdata[0];   //发送第一个数据
 371   1        
 372   1        datalen++;              //此时为设备地址单元
 373   1      
 374   1        while(REG_I2C_SR0 & MBB)     //MBB add TimeOut
 375   1        {
 376   2          if((REG_I2C_SR1 & TXE))     //等到发送时数据寄存器为空
 377   2          {           
 378   3              REG_I2C_DR = txdata[datalen++];
 379   3          }
 380   2        }
 381   1        REG_I2C_SR0 = MTF;
 382   1        
 383   1        return datalen; 
 384   1      }
