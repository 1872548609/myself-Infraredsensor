  19          /************************************************************************
  20           * Function     : UART3_IRQHandler
  21           * Description  : uart3 interrupt handling
  22           * Input    : none
  23           * Output   : none   
  24           * Return   : none
  25           ************************************************************************/
  26          void UART3_IRQHandler(void) interrupt 17
  27          {
  28   1        if(REG_UART3_ISR & 0x20)            //FIFO非空中断
  29   1        {
  30   2          if(uart3_func != NULL)
  31   2          {
  32   3            ((void(*)())(uart3_func))();    //uart3的接收处理回调函数
  33   3            REG_UART3_ISR &= ~(1<<5);       //清除FIFO_NE非空标志位
  34   3          }
  35   2        }
  36   1      #ifdef UART3_TX_INT_MODE        
                else if(REG_UART3_ISR & 0x02)       //发送完成中断
                {
                  if(!(REG_UART3_ISR & (1<<1)))
                  {
                    uart3_tx_flag = 1;
                    REG_UART3_ISR &= ~(1<<1);       //清除发送完成标志位
                  }
                }
              #endif
  46   1        else
  47   1        {
  48   2          REG_UART3_ISR = 0x00;             //清除中断状态
  49   2        }
  50   1        
  51   1      }
