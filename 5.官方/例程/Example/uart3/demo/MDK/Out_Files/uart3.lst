 129          /************************************************************************
 130           * Function     : uart3_send_byte
 131           * Description  : uart3 发送一个字节数据
 132           * Input    : char c: out byte
 133           * Output   : none  
 134           * Return   : none
 135           ************************************************************************/
 136          void uart3_send_byte(char c)
 137          {
 138   1        //输出一个字符
 139   1        uint16_t timeout;
 140   1        timeout = 65535;
 141   1        
 142   1        REG_UART3_TDR = c;
 143   1      
 144   1      #ifdef UART3_TX_INT_MODE            //中断方式
                while(!uart3_tx_flag);    
                uart3_tx_flag = 0;    
              #else                               //查询方式
 148   1        while((REG_UART3_ISR & 0x02) != 0x02)     //等待数据发送完成
 149   1        {   
 150   2          if((timeout--)==0)              //超时等待退出
 151   2          {   
 152   3            break;    
 153   3          }   
 154   2        }   
 155   1        REG_UART3_ISR &= ~(1<<1);         //清除发送完成标志位
 156   1      
 157   1      #endif
 158   1      }
 159          
 160          /************************************************************************
 161           * Function     : uart3_send_bytes
 162           * Description  : uart3 send bytes  发送多个字节
 163           * Input    : uint8_t* buff: out buffer
 164           *            uint32_t length: buffer length
 165           * Output   : none  
 166           * Return   : none
 167           ************************************************************************/
 168          void uart3_send_bytes(uint8_t *buff, uint32_t length)
 169          {
 170   1        while(length--)
 171   1        {
 172   2          uart3_send_byte(*buff++);
 173   2        } 
 174   1      }
