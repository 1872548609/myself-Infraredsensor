  54           * Function     : uart3_set_baud_rate
  55           * Description  : uart3 set baud rate
  56           * Input    : uint32_t clk_hz: cpu frequency
  57           *            uint32_t baud_rate: Series rate                 
  58           * Output   : none  
  59           * Return   : none
  60           ************************************************************************/
  61          static void uart3_set_baud_rate(uint32_t clk_hz, uint32_t baud_rate)  
  62          { 
  63   1        uint16_t temp;
  64   1        uint8_t MSbyte, LSbyte;
  65   1          
  66   1        temp = clk_hz / baud_rate;
  67   1        
  68   1        MSbyte = temp>>8;
  69   1        LSbyte = temp;
  70   1        
  71   1        REG_UART3_BRPH = MSbyte;
  72   1        REG_UART3_BRPL = LSbyte+1;    //+1：波特率精度补偿
  73   1      }
  74          
  75          /************************************************************************
  76           * Function     : uart3_init
  77           * Description  : uart3 initial for  baud_rate
  78           * Input    : uint32_t baud_rate: Series rate 
  79           * Output   : none
  80           * Return   : none
  81           ************************************************************************/
  82          void uart3_init(uint32_t baud_rate)
  83          {
  84   1        BEEPCTR |= (1<<7);                  //开uart3时钟使能 
  85   1        BEEPCTR |= (1<<6);                  //uart3正常工作
  86   1      
  87   1        REG_P03_CFG = 0x3;                  //P03复用为UART3_RX
  88   1        REG_P25_CFG = 0x1;                  //P25复用为UART3_TX
  89   1        
  90   1        P2PU &= ~(1<<5);                    //使能P25内部上拉  
  91   1        P0PU &= ~(1<<3);                    //使能P03内部上拉   
  92   1        
  93   1        REG_UART3_CR = 0x4;                 //清除接收FIFO中数据和指针
  94   1        REG_UART3_CR = 0x0a;                //无奇偶校验,发送数据使能
  95   1      
  96   1        uart3_set_baud_rate(system_core_clock,baud_rate);     //设置波特率
  97   1      }
  98          
  99          /************************************************************************
 100           * Function     : uart3_irq_init
 101           * Description  : uart3 interrupt enable
 102           * Input    : uint8_t irqstate: 0 中断失能，1 中断使能
 103           *            *pfunc_recv)(): 接收处理回调函数
 104           * Output   : none
 105           * Return   : none
 106           ************************************************************************/
 107          void uart3_irq_init(uint8_t irqstate,void (*pfunc_recv)())
 108          {
 109   1        if(irqstate == UART3_IRQ_ENABLE)
 110   1        {
 111   2          EA = 1;                   //打开总中断开关
 112   2          IEN2 = (1<<0);            //使能uart3中断
 113   2          
 114   2      #ifdef UART3_TX_INT_MODE      //发送采用中断方式
                  REG_UART3_IER = 0x22;     //接收FIFO非空中断使能，发送完成中断使能,enable Rx/Tx_INT,disable else int
C51 COMPILER V9.60.0.0   UART3                                                             07/19/2022 10:44:26 PAGE 3   

              #else                         //发送采用查询方式
 117   2          REG_UART3_IER = 0x20;     //接收FIFO非空中断使能，发送完成中断不使能,enable Rx_INT,disable Tx_INT and els
             -e int  
 118   2      
 119   2      #endif  
 120   2          uart3_func = pfunc_recv;  //接收中断回调函数
 121   2        }
 122   1        else
 123   1        {
 124   2          IEN2 = 0;                 //关闭uart3中断
 125   2        }
 126   1          
 127   1      }
