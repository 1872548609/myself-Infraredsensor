  15          /***********************************************************************
  16           * Function     : GTIM0_IRQHandler
  17           * Description  : GTIM0 interrupt handling
  18           * Input    : none
  19           * Output   : none   
  20           * Return   : none
  21           ***********************************************************************/
  22          void GTIM0_IRQHandler(void) interrupt 21
  23          {
  24   1        if((REG_GTIM0_SR & GTIMER0_UIF)  && (REG_GTIM0_IER & GTIMER0_UIE))    //UE中断
  25   1        {
  26   2          if(gtimer0_callback[0] != NULL)
  27   2          {
  28   3            gtimer0_callback[0]();
  29   3          }
  30   2          REG_GTIM0_SR = GTIMER0_UIF;           //清除UE中断标志
  31   2        }
  32   1        else if((REG_GTIM0_SR & GTIMER0_CCIF)  && (REG_GTIM0_IER & GTIMER0_CCIE))   //比较中断/捕捉中断
  33   1        {
  34   2          if(gtimer0_callback[1] != NULL)
  35   2          {
  36   3            gtimer0_callback[1]();
  37   3          }
  38   2          REG_GTIM0_SR = GTIMER0_CCIF;          //清除中断/捕捉中断
  39   2        }
  40   1        else if((REG_GTIM0_SR & GTIMER0_BKE_IF) && (REG_GTIM0_IER & GTIMER0_BKE_IE))      //刹车中断
  41   1        {
  42   2          if(gtimer0_callback[2] != NULL)
  43   2          {
  44   3            gtimer0_callback[2]();
  45   3          }
  46   2          REG_GTIM0_SR = GTIMER0_BKE_IF;      //清除刹车中断标志
  47   2        }
  48   1        else
  49   1        {
  50   2          REG_GTIM0_SR = 0x7;                 //清除所有中断标志
  51   2        }
  52   1      }  
