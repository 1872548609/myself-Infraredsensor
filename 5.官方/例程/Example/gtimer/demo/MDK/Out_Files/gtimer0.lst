 186          /************************************************************************
 187           * Function     : gtimer0_irq_init
 188           * Description  : gtimer0_irq_init  GTIMER0 中断初始化
 189           * Input    : uint8_t irq_enable    GTIMER0中断使能开关 1：使能 0：禁止
 190           *            uint8_t gtimer_irq_type GTIMER0中断类型选择
 191           *            void (*pfunc)()         GTIMER0中断回调函数
 192           * Output   : none
 193           * Return   : none
 194           ************************************************************************/  
 195          void gtimer0_irq_init(uint8_t irq_enable,uint8_t gtimer_irq_type,void (*pfunc)())
 196          {
 197   1        REG_GTIM0_SR = 0x7;   //清除状态标志
 198   1        
 199   1        if(irq_enable == GTIMER_IRQ_ENABLE)
 200   1        {
 201   2          switch(gtimer_irq_type)
 202   2          {
 203   3            case GTIMER0_UIE_IRQ:
 204   3                gtimer0_callback[0] = pfunc;
 205   3                REG_GTIM0_IER |= GTIMER0_UIE;       //使能UPDATE中断
 206   3                break;
 207   3            case GTIMER0_CCIE_IRQ:
 208   3                gtimer0_callback[1] = pfunc;
 209   3                REG_GTIM0_IER |= GTIMER0_CCIE;      //使能比较/捕捉中断
 210   3                break;  
 211   3            case GTIMER0_BKE_IE_IRQ:
 212   3                gtimer0_callback[2] = pfunc;
 213   3                REG_GTIM0_IER |= GTIMER0_BKE_IE;    //使能刹车中断
 214   3                break;
 215   3            default:
 216   3                break;        
 217   3          } 
 218   2          EA = 1 ;                                  //开启总中断
 219   2          IEN1 |= (1<<0);                           //开启gtimer0中断 
 220   2        }
 221   1        else
 222   1        {
 223   2          switch(gtimer_irq_type)
 224   2          {
 225   3            case GTIMER0_UIE_IRQ:
 226   3                gtimer0_callback[0] = pfunc;
 227   3                REG_GTIM0_IER |= ~GTIMER0_UIE;      //禁止UPDATE中断
 228   3                break;
 229   3            case GTIMER0_CCIE_IRQ:
 230   3                gtimer0_callback[1] = pfunc;
 231   3                REG_GTIM0_IER |= ~GTIMER0_CCIE;     //禁止比较/捕捉中断
 232   3                break;  
 233   3            case GTIMER0_BKE_IE_IRQ:
 234   3                gtimer0_callback[2] = pfunc;
 235   3                REG_GTIM0_IER |= ~GTIMER0_BKE_IE;   //禁止刹车中断
 236   3                break;    
 237   3            default:
 238   3                break;        
 239   3          } 
