 102   1      //  REG_P23_CFG = 0x05;               //P23 CHN 
 103   1        
 104   1        REG_GTIM0_CR0 |= (1<<6);            //使能auto-repload 
 105   1        
 106   1        REG_GTIM0_PSC1 = (psc>>8)&0xFF;     //高8位 FCK_CNT=FCK_PSC/(PSC[15:0]+1);  FCK_PSC = APBCLK 
 107   1        REG_GTIM0_PSC0 = psc&0xFF;          //低8位 FCK_CNT=FCK_PSC/(PSC[15:0]+1);  FCK_PSC = APBCLK 
 108   1        
