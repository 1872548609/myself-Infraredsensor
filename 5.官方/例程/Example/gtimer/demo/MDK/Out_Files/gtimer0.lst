 135          /***********************************************************************
 136           * Function     : gtimer0_capture_init
 137           * Description  : gtimer0_capture_init GTIMER0输入捕获
 138           * Input    : uint16_t arr          装载值
 139           *          : uint8_t capture_div   捕捉源预分频位
 140           *          : uint8_t capssel       捕捉源选择位
 141           * Output   : none
 142           * Return   : none
 143           ***********************************************************************/
 144          void gtimer0_capture_init(uint16_t arr,uint8_t capture_div,uint8_t capssel)
 145          {
 146   1        PCLK1 |= (1<<3);                      //开Gtim0时钟使能
 147   1        PRESET1 |= (1<<3);                    //GTim0正常工作
 148   1          
 149   1        REG_P13_CFG = 0x06;                   //P13 GTIMER0_CH 
 150   1      
 151   1        REG_GTIM0_ARR1 = ((arr-1)>>8)&0xFF;       //高8位 自动装载值 
 152   1        REG_GTIM0_ARR0 = (arr-1)&0xFF;            //低8位 自动装载值 
 153   1          
 154   1        REG_GTIM0_CCMR0 &= ~(1<<7);           //外部计数源滤波使能：无滤波功能 
 155   1        REG_GTIM0_CCMR0 |= (1<<0);            //配置CCS为输入 
 156   1        
 157   1        REG_GTIM0_CCMR1 = (REG_GTIM0_CCMR1&(~(0x03<<0)))|(capssel<<0);      //捕捉源选择位  
 158   1      
 159   1        REG_GTIM0_CCMR1 = (REG_GTIM0_CCMR1&(~(3<<5)))|(capture_div<<5); //分频配置
 160   1          
 161   1        REG_GTIM0_CCMR1 &= ~(0x03<<2);        //捕获沿触发控制位：上升沿触发 
 162   1          
 163   1        REG_GTIM0_CCER |= (1<<0);             //使能捕捉功能 
 164   1        
 165   1      }
 166          
 167          void gtimer0_bke_init(void)
 168          {
 169   1        PCLK1 |= (1<<3);                //开Gtim0时钟使能   
 170   1        PRESET1 |= (1<<3);              //GTim0正常工作 
 171   1      
 172   1        REG_P01_CFG = 0x05;             //P01 GTIMER0_BKE 
 173   1      //  REG_P22_CFG = 0x05;             //P22 GTIMER0_BKE   
 174   1      //  REG_P25_CFG = 0x05;             //P25 GTIMER0_BKE 
 175   1        
 176   1        REG_GTIM0_CR1 &= ~(3<<6);       //PWM刹车触发后，PWM正向电平状态设置位:低电平 
 177   1        REG_GTIM0_CR2 &= ~(3<<0);       // PWM刹车触发后，PWM互补电平状态设置位:低电平 
C51 COMPILER V9.60.0.0   GTIMER0                                                           07/29/2022 10:58:19 PAGE 4   

 178   1      
 179   1        REG_GTIM0_CR1 &= ~(1<<3);       //刹车信号高电平有效
 180   1        
 181   1        REG_GTIM0_CR1 |= (1<<2);        //使能刹车功能 
 182   1      
 183   1        REG_GTIM0_CCER |= (1<<0);       //使能输出 
 184   1      }
