  11          #include  "system_um800x.h"
  12          #include  "config.h"
  13          
  14          uint32_t SystemCoreClock = 0;   //core时钟 , (uint:Hz)
  15          /************************************************************************
  16           * function   : clock_init
  17           * Description: clock init, initil several clock variables
  18           * input : 
  19           *                uint32_t system_clk_hz
  20           * return: none
  21           ************************************************************************/
  22          void clock_init(uint32_t system_clk_hz)
  23          {
  24   1              CLKCON |= (0x1<<2);                                     //RCH时钟源打开
  25   1              while((CLKCON&0x20) != 0x20);           //等待RC16M时钟稳定     
  26   1                                      
  27   1          RCHDIV &= ~(0x3<<0);
  28   1          RCHDIV |= (0x2<<0);                 //RCH 3分频
  29   1          
  30   1              CLKCON &= ~(0x1<<0);                            //RCH 为高速时钟
  31   1              SYSDIV &= ~(7<<0);                                      //高频时钟不分频作为系统时钟    
  32   1                              
  33   1              SystemCoreClock = system_clk_hz;    //系统时钟
  34   1      }
  35          
  36          /************************************************************************
  37           * function   : systeminit
  38           * Description: systeminit
  39           * input : none
  40           * return: none
  41           ************************************************************************/
  42          void systeminit(void)
  43          {
  44   1          clock_init(FCLK); 
  45   1      }
  46          


