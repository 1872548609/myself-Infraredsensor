   1          /***********************************************************************
   2           * 工业红外对射 - 发射端
   3           * 平台：UM800Y / 24MHz
   4           *
   5           * 功能：
   6           * 1. P1.4 输出红外发射 PWM
   7           * 2. 周期约 1ms，窄脉冲发射
   8           * 3. CPU 不参与发射时序，硬件 PWM 自动输出
   9           *
  10           * 引脚：
  11           * P1.4 -> 红外发射驱动
  12           * P1.3 -> 指示灯
  13           ***********************************************************************/
  14          
  15          #include "system_um800y.h"
  16          #include "app.h"
  17          #include "gtimer.h"
  18          #include "pwm.h"
  19          #include "common.h"
  20          #include "config.h"
  21          #include "gpio.h"
  22          #include "adc.h"
  23          
  24          #define IR_TX_PWM_PIN      P1_4
  25          #define IR_TX_LED_PIN      P1_3
  26          
  27          /*
  28           * PWM 参数。
  29           *
  30           * 你旧版仓库里原来就是这组：
  31           * period = 16000
  32           * duty   = 400
  33           *
  34           * 如果示波器看到周期不是约 1ms，优先改 IR_PWM_PERIOD_COUNT。
  35           * 如果红外发射脉冲太窄/太弱，增大 IR_PWM_DUTY_COUNT。
  36           */
  37          #define IR_PWM_PERIOD_COUNT    16000U
  38          #define IR_PWM_DUTY_COUNT      400U
  39          
  40          #define LED_ACTIVE_LEVEL       GPIO_HIGH
  41          #define LED_INACTIVE_LEVEL     GPIO_LOW
  42          
  43          void GPIO_Init(void);
  44          
  45          void main(void)
  46          {
  47   1          system_init();
  48   1      
  49   1          GPIO_Init();
  50   1      
  51   1          /*
  52   1           * 不需要串口时可以注释。
  53   1           * 如果 app.c 里的 uart_init() 会打开中断，建议关掉里面的 uart0_irq_init()。
C51 COMPILER V9.57.0.0   MAIN                                                              06/05/2026 19:00:22 PAGE 2   

  54   1           */
  55   1          uart_init();
  56   1      
  57   1          /*
  58   1           * 发射端不使用中断。
  59   1           * PWM 硬件自己跑。
  60   1           */
  61   1          EA = 0;
  62   1      
