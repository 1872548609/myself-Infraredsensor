 239          
 240          /*
 241           * 脉冲进入阈值迟滞。
 242           *
 243           * 高脉冲有效时：
 244           *  ADC >= g_threshold + RX_ON_MARGIN_ADC
 245           *  才认为进入有效脉冲。
 246           *
 247           * 这样可以避免 ADC 在阈值附近轻微波动时误触发。
 248           */
 249          #define RX_ON_MARGIN_ADC                100U
 250          
 251          /*
 252           * 脉冲离开阈值迟滞。
 253           *
 254           * 高脉冲有效时：
 255           *  ADC <= g_threshold - RX_OFF_MARGIN_ADC
 256           *  才认为当前脉冲已经结束。
 257           *
 258           * 这样可以保证一个宽脉冲只计一次，不会在一个脉冲内部重复计数。
 259           */
 260          #define RX_OFF_MARGIN_ADC               100U
 261          
 262          /*
 263           * 连续有效脉冲确认次数。
 264           *
 265           * 捕捉到 1 个脉冲，不一定马上认为有光；
 266           * 连续捕捉到 RX_PULSE_CONFIRM_COUNT 个有效脉冲后，才确认有光。
 267           *
 268           * 值越大：
 269           *  抗干扰越强；
 270           *  响应越慢。
 271           *
 272           * 值越小：
 273           *  响应越快；
 274           *  但容易被单个干扰脉冲误触发。
 275           */
 276          #define RX_PULSE_CONFIRM_COUNT          2U
 277          
 278          /*
 279           * 丢光超时时间。
 280           *
 281           * 单位：ms。
 282           *
 283           * 5ms / 10us = 500 tick。
 284           *
 285           * 如果 5ms 内没有捕捉到任何有效脉冲，就认为遮光。
 286           *
 287           * 如果你的发射频率较低，或者脉冲周期较长，可以把这个值加大：
 288           *  8  -> 8ms
 289           *  10 -> 10ms
 290           *  15 -> 15ms
 291           */
 292          #define RX_LOST_TIMEOUT_MS              5U
 293          #define RX_LOST_TIMEOUT_TICKS           TIMER0_MS_TO_TICKS(RX_LOST_TIMEOUT_MS)
 294          
 295          /*
 296           * ADJ 阈值更新周期。
 297           *
 298           * 单位：ms。
 299           *
 300           * 50ms / 10us = 5000 tick。
C51 COMPILER V9.57.0.0   MAIN                                                              06/05/2026 18:25:00 PAGE 6   

 301           *
 302           * 为什么 ADJ 不一直扫？
