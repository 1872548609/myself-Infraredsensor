C51 COMPILER V9.57.0.0   MAIN                                                              06/05/2026 18:25:00 PAGE 4   

 178           *
 179           * 计算方式：
 180           *  主频 24MHz；
 181           *  TIMER0_PRESCALER = 24 - 1；
 182           *  Timer 计数频率 = 24MHz / 24 = 1MHz；
 183           *  1 个计数周期 = 1us；
 184           *  自动重装值 10，约等于 10us 溢出一次。
 185           *
 186           * 注意：
 187           *  Timer0 这里只提供时间基准。
 188           *  ADC 不等 Timer0；
 189           *  ADC 在 while(1) 里一直扫。
 190           */
 191          #define TIMER0_TICK_US                  10U
 192          #define TIMER0_10US_RELOAD              10U
 193          #define TIMER0_PRESCALER                (24U - 1U)
 194          
 195          /*
 196           * 时间换算宏。
 197           *
 198           * 后续所有“超时 / 周期”都先写成 ms 或 us，
 199           * 再统一换算成 Timer0 tick。
 200           *
 201           * 这样以后如果 Timer0 从 10us 改成 20us / 50us，
 202           * 只需要改 TIMER0_TICK_US 和 TIMER0_xxUS_RELOAD，
 203           * 不需要到处手动改计数值，避免时间错误。
 204           */
 205          #define TIMER0_US_TO_TICKS(us)          ((uint16_t)(((uint32_t)(us) + (TIMER0_TICK_US - 1U)) / TIMER0_TICK
             -_US))
 206          #define TIMER0_MS_TO_TICKS(ms)          TIMER0_US_TO_TICKS((uint32_t)(ms) * 1000UL)
 207          
