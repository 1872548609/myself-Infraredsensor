 951          /*======================================================================
 952           * 十七、ADJ 阈值更新
 953           *====================================================================*/
 954          static void threshold_update_process(void)
 955          {
 956   1          uint16_t adj;
 957   1          uint16_t new_threshold;
 958   1      
 959   1          /*
 960   1           * 读取 ADJ 电位器。
 961   1           *
 962   1           * 这里只读取一次，不做多次平均。
 963   1           * 原因：
 964   1           *  ADJ 更新函数虽然是低速运行，
 965   1           *  但也不应该长时间占用 ADC，
 966   1           *  否则可能影响接收脉冲捕捉。
 967   1           */
 968   1          adj = adc_read_once(IR_ADJ_ADC_CHANNEL);
 969   1      
 970   1          /*
 971   1           * 保存 ADJ 原始值，方便调试观察。
 972   1           */
 973   1          g_adc_adj = adj;
 974   1      
 975   1          /*
 976   1           * 把 ADJ 原始 ADC 值映射成实际接收阈值。
 977   1           */
 978   1          new_threshold = threshold_map_from_adj(adj);
 979   1      
 980   1          /*
 981   1           * 第一次初始化时，直接同步阈值。
 982   1           *
C51 COMPILER V9.57.0.0   MAIN                                                              06/05/2026 18:25:00 PAGE 17  

 983   1           * 不做 IIR，否则刚上电阈值会慢慢逼近，导致前几十毫秒判断不准。
 984   1           */
 985   1          if(g_threshold_init == 0)
 986   1          {
 987   2              g_threshold_init = 1;
 988   2              g_threshold_filter = ((uint32_t)new_threshold << ADJ_FILTER_SHIFT);
 989   2              g_threshold = new_threshold;
 990   2              return;
 991   2          }
 992   1      
 993   1          /*
 994   1           * IIR 平滑滤波。
 995   1           *
 996   1           * 等价于：
 997   1           *  g_threshold = 7/8 * old + 1/8 * new
 998   1           *
 999   1           * 目的：
1000   1           *  避免电位器轻微抖动导致阈值抖动；
1001   1           *  避免输出在临界点来回跳。
1002   1           */
1003   1          g_threshold_filter -= (g_threshold_filter >> ADJ_FILTER_SHIFT);
1004   1          g_threshold_filter += new_threshold;
1005   1      
1006   1          /*
1007   1           * 还原成实际阈值。
1008   1           */
1009   1          g_threshold = (uint16_t)(g_threshold_filter >> ADJ_FILTER_SHIFT);
1010   1      
1011   1          /*
1012   1           * 阈值限幅。
1013   1           */
1014   1          if(g_threshold < THRESHOLD_MIN_ADC)
1015   1          {
1016   2              g_threshold = THRESHOLD_MIN_ADC;
1017   2          }
1018   1          else if(g_threshold > THRESHOLD_MAX_ADC)
1019   1          {
1020   2              g_threshold = THRESHOLD_MAX_ADC;
1021   2          }
1022   1      }
1023          
1024          static uint16_t threshold_map_from_adj(uint16_t adj)
1025          {
1026   1          uint32_t span;
1027   1          uint16_t threshold;
1028   1      
1029   1          /*
1030   1           * ADJ 限幅到 12 位 ADC 范围。
1031   1           */
1032   1          if(adj > ADC_MAX_VALUE)
1033   1          {
1034   2              adj = ADC_MAX_VALUE;
1035   2          }
1036   1      
1037   1          /*
1038   1           * 阈值范围跨度。
1039   1           */
1040   1          span = (uint32_t)(THRESHOLD_MAX_ADC - THRESHOLD_MIN_ADC);
1041   1      
1042   1          /*
1043   1           * 线性映射：
1044   1           *
C51 COMPILER V9.57.0.0   MAIN                                                              06/05/2026 18:25:00 PAGE 18  

1045   1           *  adj = 0    -> threshold = THRESHOLD_MIN_ADC
1046   1           *  adj = 4095 -> threshold = THRESHOLD_MAX_ADC
1047   1           */
1048   1          threshold = (uint16_t)(THRESHOLD_MIN_ADC +
1049   1                      ((uint32_t)adj * span) / ADC_MAX_VALUE);
1050   1      
1051   1          return threshold;
1052   1      }
