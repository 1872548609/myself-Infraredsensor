1055          /*======================================================================
1056           * 十八、脉冲进入/离开判断
1057           *====================================================================*/
1058          static uint8_t signal_enter_active(uint16_t adc_value)
1059          {
1060   1          uint16_t th;
1061   1      
1062   1      #if RX_SIGNAL_ACTIVE_HIGH
1063   1      
1064   1          /*
1065   1           * 高脉冲有效：
1066   1           *
1067   1           * 只有 ADC 高于：
1068   1           *  g_threshold + RX_ON_MARGIN_ADC
1069   1           * 才认为进入有效脉冲。
1070   1           */
1071   1          th = g_threshold + RX_ON_MARGIN_ADC;
1072   1      
1073   1          /*
1074   1           * 防止阈值超过 ADC 最大值。
1075   1           */
1076   1          if(th > ADC_MAX_VALUE)
1077   1          {
1078   2              th = ADC_MAX_VALUE;
1079   2          }
1080   1      
1081   1          if(adc_value >= th)
1082   1          {
1083   2              return 1;
1084   2          }
1085   1      
1086   1      #else
              
                  /*
                   * 低脉冲有效：
                   *
                   * 只有 ADC 低于：
                   *  g_threshold - RX_ON_MARGIN_ADC
                   * 才认为进入有效脉冲。
                   */
                  if(g_threshold > RX_ON_MARGIN_ADC)
                  {
                      th = g_threshold - RX_ON_MARGIN_ADC;
                  }
                  else
                  {
                      th = 0;
                  }
              
                  if(adc_value <= th)
                  {
                      return 1;
C51 COMPILER V9.57.0.0   MAIN                                                              06/05/2026 18:25:00 PAGE 19  

                  }
              
              #endif
1110   1      
1111   1          return 0;
1112   1      }
1113          
1114          static uint8_t signal_leave_active(uint16_t adc_value)
