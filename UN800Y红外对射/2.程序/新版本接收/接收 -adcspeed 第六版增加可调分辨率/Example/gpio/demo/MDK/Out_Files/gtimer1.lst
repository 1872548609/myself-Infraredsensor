 136          /***********************************************************************
 137           * Function     : gtimer1_capture_init
 138           * Description  : gtimer1_capture_init GTIMER1输入捕获
 139           * Input                : uint16_t arr         装载值
 140           *                                      : uint8_t capture_div  捕捉源预分频位
 141           *                                      : uint8_t capssel                捕捉源选择位
 142           * Output               : none
 143           * Return               : none
 144           ***********************************************************************/
 145          void gtimer1_capture_init(uint16_t arr,uint8_t capture_div,uint8_t capssel)
 146          {
 147   1              PCLK1 |= (1<<5);                                                                            //开Gtim1时钟使能 
 148   1              PRESET1 |= (1<<5);                                                                              //GTim1正常工作 
 149   1              
 150   1              REG_P03_CFG = 0x06;                                                                             //P03 CH 
 151   1              REG_P12_CFG = 0x05;                                                                             //P12 CH
 152   1      //      REG_P26_CFG = 0x05;                                                                     //P26 CH 
 153   1              
 154   1              REG_GTIM1_ARR1 = ((arr-1)>>8)&0xFF;                             //高8位 自动装载值 
 155   1              REG_GTIM1_ARR0 = (arr-1)&0xFF;                                          //低8位 自动装载值 
 156   1                                              
 157   1              REG_GTIM1_CCMR0 &= ~(1<<7);                                             //外部计数源滤波使能：无滤波功能 
 158   1              REG_GTIM1_CCMR0 |= (1<<0);                                              //配置CCS为输入 
 159   1                                      
 160   1              REG_GTIM1_CCMR1 = (REG_GTIM1_CCMR1 &(~(0x03<<0)))|(capssel<<0); //捕捉源选择位  
 161   1              
 162   1              REG_GTIM1_CCMR1 = (REG_GTIM1_CCMR1&(~(3<<5)))|(capture_div<<5);
 163   1                                              
 164   1              REG_GTIM1_CCMR1 &= ~(0x03<<2);                          //捕获沿触发控制位：上升沿触发 
 165   1                                              
 166   1              REG_GTIM1_CCER |= (1<<0);                                                       //使能捕捉功能 
 167   1              
 168   1      }
