  54          /************************************************************************
  55           * Function     : gtimer1_count_init
  56           * Description  : gtimer1_count_init GTIMER1 count初始化
  57           * Input                : uint16_t arr  GTIMER1重载值
  58                                                                  uint16_t psc    GTIMER1分频值
  59           * Output       : none
  60           * Return               : none
  61           ************************************************************************/       
  62          void gtimer1_count_init(uint16_t arr,uint16_t psc)
  63          {
  64   1              PCLK1 |= (1<<5);                                                                                //开Gtim1时钟使能       
  65   1              PRESET1 |= (1<<5);                                                                      //GTim1正常工作
  66   1                      
  67   1              REG_GTIM1_CR0 |= (1<<6);                                                //使能auto-repload
  68   1              
  69   1              REG_GTIM1_PSC1 = (psc>>8)&0xFF;                 //高8位 FCK_CNT=FCK_PSC/(PSC[15:0]+1);  FCK_PSC = APBCLK
  70   1              REG_GTIM1_PSC0 = psc&0xFF;                                      //低8位 FCK_CNT=FCK_PSC/(PSC[15:0]+1);  FCK_PSC = APBCLK
  71   1                      
  72   1              REG_GTIM1_ARR1 = ((arr-1)>>8)&0xFF;                     //高8位 自动装载值
  73   1              REG_GTIM1_ARR0 = (arr-1)&0xFF;                                  //低8位 自动装载值
  74   1                      
  75   1              REG_GTIM1_EGR = 0x1;                                                            //产生UE事件，将PSC的值立即载入shadow寄存器
  76   1              REG_GTIM1_SR |= (1<<0);                                                 //清除UE产生的中断，否则会直接进入中断服务函数
  77   1              
  78   1      }
  79          
