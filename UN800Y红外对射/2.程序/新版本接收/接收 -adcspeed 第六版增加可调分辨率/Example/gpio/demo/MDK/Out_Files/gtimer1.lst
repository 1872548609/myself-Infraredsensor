  14          /***********************************************************************
  15           * Function     : GTIM1_IRQHandler
  16           * Description  : GTIM1 interrupt handling
  17           * Input                : none
  18           * Output               : none   
  19           * Return               : none
  20           ***********************************************************************/
  21          void GTIM1_IRQHandler(void) interrupt 20
  22          {
  23   1              if((REG_GTIM1_SR & GTIMER1_UIF)&& (REG_GTIM1_IER & GTIMER1_UIE))                                //UE中断
  24   1              {
  25   2                      if(gtimer1_callback[0] != NULL)
  26   2                      {
  27   3                              gtimer1_callback[0]();
  28   3                      }
  29   2                      REG_GTIM1_SR = GTIMER1_UIF;                                                     //清除UE中断标志
  30   2              }
  31   1              else if((REG_GTIM1_SR & GTIMER1_CCIF) && (REG_GTIM1_IER & GTIMER1_CCIE))                //比较中断/捕捉中断
  32   1              {
  33   2                      if(gtimer1_callback[1] != NULL)
  34   2                      {
  35   3                              gtimer1_callback[1]();
  36   3                      }
  37   2                      REG_GTIM1_SR = GTIMER1_CCIF;                                                    //清除中断/捕捉中断
  38   2              }
  39   1              else if((REG_GTIM1_SR & GTIMER1_BKE_IF) && (REG_GTIM1_IER & GTIMER1_BKE_IE))            //刹车中断
  40   1              {
  41   2                      if(gtimer1_callback[2] != NULL)
  42   2                      {
  43   3                              gtimer1_callback[2]();
  44   3                      }
  45   2                      REG_GTIM1_SR = GTIMER1_BKE_IF;                                                  //清除刹车中断标志
  46   2              }
  47   1              else
  48   1              {
  49   2                      REG_GTIM1_SR = 0x7;                                                             //清除所有中断标志
  50   2              }
  51   1      }  
