 180   1              PRESET1 |= (1<<5);                                                                      //GTim1正常工作 
 181   1      
 182   1              REG_P04_CFG = 0x05;                                                                     //P04 GTIMER1_BKE 
 183   1      //      REG_P14_CFG = 0x06;                                                             //P14 GTIMER1_BKE 
 184   1      //      REG_P15_CFG = 0x05;                                                             //P15 GTIMER1_BKE 
 185   1              
