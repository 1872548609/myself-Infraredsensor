 198          /************************************************************************
 199           * Function     : gtimer1_irq_init
 200           * Description  : gtimer1_irq_init      GTIMER1 中断初始化
 201           * Input                : uint8_t irq_enable            GTIMER1中断使能开关 1：使能 0：禁止
 202                                                                  uint8_t gtimer_irq_type GTIMER1中断类型选择
 203           *            void (*pfunc)()                                   GTIMER1中断回调函数
 204           * Output       : none
 205           * Return               : none
 206           ************************************************************************/      
 207          void gtimer1_irq_init(uint8_t irq_enable,uint8_t gtimer_irq_type,void (*pfunc)())
 208          {
 209   1              REG_GTIM1_SR = 0x7;                                                                                                     //清除状态标志
 210   1              
 211   1              if(irq_enable == GTIMER_IRQ_ENABLE)
 212   1              {
 213   2                      switch(gtimer_irq_type)
 214   2                      {
 215   3                              case GTIMER1_UIE_IRQ:
 216   3                                              gtimer1_callback[0] = pfunc;
 217   3                                              REG_GTIM1_IER |= GTIMER1_UIE;                           //使能UPDATE中断
 218   3                                              break;
 219   3                              case GTIMER1_CCIE_IRQ:
 220   3                                              gtimer1_callback[1] = pfunc;
 221   3                                              REG_GTIM1_IER |= GTIMER1_CCIE;                  //使能比较/捕捉中断
 222   3                                              break;  
 223   3                              case GTIMER1_BKE_IE_IRQ:
 224   3                                              gtimer1_callback[2] = pfunc;
 225   3                                              REG_GTIM1_IER |= GTIMER1_BKE_IE;                //使能刹车中断
 226   3                                              break;
 227   3                              default:
 228   3                                              break;                          
 229   3                      }       
 230   2                      EA = 1 ;                                                                                                                                        //开启总中断
 231   2                      IEN1 |= (1<<2);                                                                                                         //开启gtimer1中断
 232   2              }
 233   1              else
 234   1              {
 235   2                      switch(gtimer_irq_type)
 236   2                      {
 237   3                              case GTIMER1_UIE_IRQ:
 238   3                                              gtimer1_callback[0] = pfunc;
 239   3                                              REG_GTIM1_IER |= ~GTIMER1_UIE;                  //禁止UPDATE中断
C51 COMPILER V9.57.0.0   GTIMER1                                                           01/29/2026 15:56:04 PAGE 5   

 240   3                                              break;
 241   3                              case GTIMER1_CCIE_IRQ:
 242   3                                              gtimer1_callback[1] = pfunc;
 243   3                                              REG_GTIM1_IER |= ~GTIMER1_CCIE;                 //禁止比较/捕捉中断
 244   3                                              break;  
 245   3                              case GTIMER1_BKE_IE_IRQ:
 246   3                                              gtimer1_callback[2] = pfunc;
 247   3                                              REG_GTIM1_IER |= ~GTIMER1_BKE_IE;               //禁止刹车中断
 248   3                                              break;          
 249   3                              default:
 250   3                                              break;                          
 251   3                      }       
 252   2              }
 253   1              
 254   1      }
