  98   1      //      REG_P26_CFG = 0x05;                                                             //P26 CH 
  99   1              
 100   1              REG_P00_CFG = 0x04;                                                                     //P00 CHN 
 101   1              REG_P11_CFG = 0x06;                                                                     //P11 CHN 
 102   1      //      REG_P27_CFG = 0x05;                                                             //P27 CHN 
 103   1              
 104   1              REG_GTIM1_CR0 |= (1<<6);                                                //使能auto-repload 
 105   1                                              
 106   1              REG_GTIM1_PSC1 = (psc>>8)&0xFF;                 //高8位 FCK_CNT=FCK_PSC/(PSC[15:0]+1);  FCK_PSC = APBCLK
 107   1              REG_GTIM1_PSC0 = psc&0xFF;                                      //低8位 FCK_CNT=FCK_PSC/(PSC[15:0]+1);  FCK_PSC = APBCLK
 108   1                                      
 109   1              REG_GTIM1_ARR1 = ((arr-1)>>8)&0xFF;                     //高8位 自动装载值
 110   1              REG_GTIM1_ARR0 = (arr-1)&0xFF;                                  //低8位 自动装载值 
 111   1                                              
 112   1              REG_GTIM1_ARRN1 = ((arr-1)>>8)&0xFF;            //高8位 自动装载值
 113   1              REG_GTIM1_ARRN0 = (arr-1)&0xFF;                                 //低8位 自动装载值 
 114   1                                              
 115   1              REG_GTIM1_CCR1 = (ccr>>8)&0xFF;                 //高8位 比较寄存器 
C51 COMPILER V9.57.0.0   GTIMER1                                                           01/29/2026 15:56:04 PAGE 3   

 116   1              REG_GTIM1_CCR0 = ccr&0xFF;                                      //低8位 比较寄存器
 117   1                                              
 118   1              REG_GTIM1_CCRN1 = (ccr>>8)&0xFF;                //高8位 比较寄存器 
 119   1              REG_GTIM1_CCRN0 = ccr&0xFF;                                     //低8位 比较寄存器
 120   1                                              
 121   1              REG_GTIM1_CR1 |= (1<<0);                                                //互补PWM和原PWM反相位
