  10          #include  "wdt.h"
  11          
  12          /***********************************************************************
  13           * Function     : wdt_init
  14           * Description  : wdt init
  15           * Input        : none
  16           * Output               : none
  17           * Return               : none
  18           ***********************************************************************/
  19          void wdt_init(void)
  20          {
  21   1              PCLK0 |= (1<<2);                                                                                                                        // 开启WDT时钟 
  22   1              PRESET0 |= (1<<2);                                                                                              // WDT正常工作 
  23   1              WDEN = 1;                                                                                                       // WDT使能 
  24   1      }
  25          
  26          /***********************************************************************
  27           * Function     : wdt_load
  28           * Description  : 设置溢出周期最小值
  29           * Input        : uint8_t arr：arr_1_ms，arr_4_ms...
  30           * Output               : none
  31           * Return               : none
  32           ***********************************************************************/
  33          void wdt_load(uint8_t arr)
  34          {
  35   1        RSTSTAT &= ~(7<<0);  
  36   1              RSTSTAT |= (arr<<0);
  37   1      }
  38          
  39          
  40          /***********************************************************************
  41           * Function     : wdt_feed
  42           * Description  : 喂狗
  43           * Input        : uint8_t arr：arr_1_ms，arr_4_ms...
  44           * Output               : none
  45           * Return               : none
  46           ***********************************************************************/
  47          void wdt_feed(uint8_t arr)
  48          {
  49   1              RSTSTAT &= ~(7<<0); 
  50   1              RSTSTAT |= (arr<<0);
  51   1      }
