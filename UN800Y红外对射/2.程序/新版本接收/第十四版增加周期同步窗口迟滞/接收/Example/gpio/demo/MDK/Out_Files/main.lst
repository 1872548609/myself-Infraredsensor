 313   2              /* GTIMER0 在 RX_WINDOW_INTERVAL_TICK 周期回卷。 */
 314   2              elapsed = (uint16_t)((RX_WINDOW_INTERVAL_TICK - start_tick) + now_tick);
 315   2          }
 316   1      
 317   1          return elapsed;
 318   1      }
