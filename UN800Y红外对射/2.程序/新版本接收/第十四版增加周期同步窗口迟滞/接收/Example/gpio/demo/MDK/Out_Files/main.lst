  36          /*======================================================================
  37           * 一、接收算法参数
  38           *====================================================================*/
  39          
  40          /*
  41           * 系统主频 24MHz，GTIMER0 使用 24 分频：
  42           * 24MHz / 24 = 1MHz，1 tick = 1us。
  43           */
  44          
  45          #define RX_CONFIRM_COUNT              3U
  46          
  47          /*
  48           * 定时器窗口间隔周期。
  49           * 默认 1000us，也就是同步后每隔 1ms 打开一次 ADC 扫描窗口。
  50           * 如果发射端周期不是 1ms，只需要改这里。
  51           */
  52          #define RX_WINDOW_INTERVAL_TICK       1000U
  53          
C51 COMPILER V9.57.0.0   MAIN                                                              06/17/2026 16:38:40 PAGE 2   

  54          /*
  55           * 同步中断后的第一次窗口起点间隔。
  56           *
  57           * 这个参数只影响“同步后的第一次 ADC 窗口”。
  58           * 第一次窗口之后，后续窗口仍然保持 RX_WINDOW_INTERVAL_TICK，也就是 1000us。
  59           *
  60           * 调试方法：
  61           * - 如果示波器看到 ADC 窗口整体偏后，就把这里调小，例如 950、900、850。
  62           * - 如果示波器看到 ADC 窗口整体偏前，就把这里调大，最大不要超过 RX_WINDOW_INTERVAL_TICK。
  63           *
  64           * 例：
  65           * - 1000U：等同旧版，同步后 1000us 才打开第一次窗口。
  66           * - 900U ：同步后 900us 打开第一次窗口，相当于后续相位整体提前 100us。
  67           */
  68          #define RX_FIRST_WINDOW_DELAY_TICK    900U
  69          
  70          /*
  71           * ADC 连续扫描窗口宽度。
  72           * 默认 40us。
  73           *
  74           * 发射有效脉宽约 25us 时：
  75           * - 窗口太小：容易因为相位偏差漏掉脉冲；
  76           * - 窗口太大：平均值会被窗口内的低电平拉低，需要适当降低 adc_set；
  77           * - 建议先用 30~60us 调试。
  78           */
  79          #define RX_ADC_WINDOW_WIDTH_TICK      100U
  80          
  81          /*
  82           * 连续多少个 ADC 窗口无效后判定遮光。
  83           * 默认 3 个窗口，即约 3ms 遮光确认，响应约 333Hz。
  84           * 如果想更快，可以改 2；如果现场抖动明显，可以改 4 或 5。
  85           */
  86          #define RX_LOST_WINDOW_COUNT          3U
  87          
  88          /*
  89           * 周期性强制重新同步功能。
  90           *
  91           * 作用：
  92           * 同步后虽然 GTIMER0 每 1ms 周期本身稳定，但接收端本地定时器和发射端周期
  93           * 之间可能有微小频差，累计一段时间后 ADC 窗口会相对发射脉冲慢慢漂移。
  94           * 所以每处理 RX_RESYNC_WINDOW_COUNT 个窗口后，主动退出当前 1ms 周期采样，
  95           * 重新打开 P1_4 同步中断，等下一次发射脉冲边沿重新校准相位。
  96           *
  97           * 注意：
  98           * 强制重同步不会把输出拉成遮光，只是暂停周期窗口并等待下一次同步边沿。
  99           * 如果确实已经遮光，则仍然由 RX_LOST_WINDOW_COUNT 个无效窗口走遮光逻辑。
 100           *
 101           * 默认 100 个周期，即约每 100ms 重新同步一次。
 102           * 如果漂移很快，可以改 50 或 20；如果现场很稳，可以改 200。
 103           */
 104          #define RX_RESYNC_ENABLE              1U
 105          #define RX_RESYNC_WINDOW_COUNT        3U
 106          
 107          /*
 108           * 强制重同步等待超时。
 109           * 周期性强制重同步时，接收端会停止 GTIMER0 窗口采样并重新打开 P1_4。
 110           * 如果 2ms 内没有收到新的 P1_4 同步边沿，就认为当前已经遮光。
 111           * 这个超时只用于“已经有光后的强制重同步等待期”，上电遮光等待不启动。
 112           */
 113          #define RX_SYNC_WAIT_TIMEOUT_TICK     2000U
 114          
