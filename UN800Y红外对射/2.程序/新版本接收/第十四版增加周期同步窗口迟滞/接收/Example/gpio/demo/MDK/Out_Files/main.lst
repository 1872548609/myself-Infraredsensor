 519   1          if (sample_count != 0)
 520   1          {
 521   2              *sample_count = count;
 522   2          }
 523   1      
 524   1          if (count == 0U)
 525   1          {
 526   2              return ADC_INVALID;
 527   2          }
 528   1      
 529   1          return (uint16_t)(sum / count);
