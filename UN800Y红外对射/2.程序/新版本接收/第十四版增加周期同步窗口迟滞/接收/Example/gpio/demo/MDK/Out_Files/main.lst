 506   1          {
 507   2              value = rx_adc_read_once(ch);
 508   2      
 509   2              if (value < RX_ADC_MAX_VALID)
 510   2              {
 511   3                  sum += value;
 512   3                  count++;
 513   3              }
 514   2          }
 515   1          while (rx_timer_elapsed_from(start_tick) < window_tick);
 516   1      
 517   1          gpio_io_set(P1_0, GPIO_HIGH);
