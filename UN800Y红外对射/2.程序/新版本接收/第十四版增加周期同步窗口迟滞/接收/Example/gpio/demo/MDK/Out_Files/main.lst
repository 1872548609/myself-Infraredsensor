 382   1          REG_GTIM0_CR0 &= ~(1 << 0);
 383   1      
 384   1          REG_GTIM0_CNT0 = (uint8_t)(preload_tick & 0x00FFU);
 385   1          REG_GTIM0_CNT1 = (uint8_t)((preload_tick >> 8) & 0x00FFU);
 386   1      
 387   1          REG_GTIM0_CR0 |= (1 << 0);
 388   1      }
