  12          void eeprom_init(uint32_t system_clk_hz)  
  13          {       
  14   1              uint8_t system_clk_mhz;
  15   1              
  16   1              if(system_clk_hz < 2000000)
  17   1              {
  18   2                      return;
  19   2              }
  20   1              
  21   1              system_clk_mhz = system_clk_hz/1000000;
  22   1              
  23   1              OPSET |= (0<<3);                                 //RD_WAIT = 0
  24   1          
  25   1              if(((*(volatile uint8_t xdata *)(0x9000+0x1B0)) ) == ~((*(volatile uint8_t xdata *)(0x9000+0x1B0+2))))
  26   1          {
  27   2              OUS = (*(volatile uint8_t xdata *)(0x9000+0x1B0));
  28   2          }
  29   1          else
  30   1          {
  31   2              OUS = 0x0f;      
  32   2          }
  33   1              
  34   1              OINTUS = 0x3f;                                   //清除所有中断标志位
  35   1              OINTEN = 0x00;                                   //关闭所有中断功能
  36   1                      
  37   1      }
  38          
  39          void eeprom_erase_page(uint16_t page_addr)      
  40          {
  41   1              OPSET &= ~(7<<0);
  42   1              OPSET |= EFC_NVR_SET_MODE;              //开启eeprom擦写使能
  43   1              OPSET |= EFC_PAGE_ERASE_MODE;           //开启page擦除模式
  44   1              OADR = page_addr;
  45   1              OCTRL |= (0x1<<3);                                      //PUMP_SEL = 6.75v
  46   1              OCTRL |= (1<<6);                                        //PUMP_EN=1
  47   1              while(!(OCTRL & (1<<1)));                       //wait for PUMP OK
  48   1              OCTRL |= (1<<7);                                        //VPPO_EN = 1
  49   1              while((OCTRL & (1<<7)));                        //wait for VPPO_EN = 0
  50   1              OCTRL &= ~(1<<6);                                       //PUMP_EN=0
  51   1              OPSET &= ~EFC_PAGE_ERASE_MODE;          //关闭page擦除模式
  52   1              OPSET &= ~EFC_NVR_SET_MODE;             //关闭eeprom擦写使能
  53   1      }
