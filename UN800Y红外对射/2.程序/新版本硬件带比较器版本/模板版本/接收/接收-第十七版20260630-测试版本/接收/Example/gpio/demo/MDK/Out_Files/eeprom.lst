  55          void eeprom_write_byte(uint16_t addr,uint8_t value)      
  56          {
  57   1              OPSET &= ~(7<<0);
  58   1              OPSET |= EFC_NVR_SET_MODE;              //开启eeprom擦写使能
  59   1              OPSET |= EFC_WRITE_MODE;                        //使能写模式    
  60   1              OADR = addr;
  61   1              ODATA = value;
  62   1              OCTRL |= (0x1<<3);                                      //PUMP_SEL = 6.75v
  63   1              OCTRL |= (1<<6);                                        //PUMP_EN=1
  64   1              while(!(OCTRL & (1<<1)));                       //wait for PUMP OK;
  65   1              OCTRL |= (1<<7);                                        //VPPO_EN = 1
  66   1              while((OCTRL & (1<<7)));                        //wait for VPPO_EN = 0
  67   1              OCTRL &= ~(1<<6);                                       //PUMP_EN=0
  68   1      
  69   1              OPSET &= ~EFC_WRITE_MODE;                       //关闭写模式
  70   1              OPSET &= ~EFC_NVR_SET_MODE;             //关闭eeprom擦写使能
  71   1              
  72   1      }
  73          
  74          void eeprom_write_bytes(uint16_t addr, uint8_t *buff, uint32_t length)   
  75          { 
  76   1              OPSET &= ~(7<<0);
  77   1              OPSET |= EFC_NVR_SET_MODE;              //开启eeprom擦写使能
  78   1              OPSET |= EFC_WRITE_MODE;                        //使能写模式 
  79   1          while(length--)
  80   1          {
  81   2              OADR = addr++;
  82   2              ODATA = *buff++;
  83   2              OCTRL |= (0x1<<3);                              //PUMP_SEL = 6.75v
  84   2              OCTRL |= (1<<6);                                //PUMP_EN=1
  85   2              while(!(OCTRL & (1<<1)));           //wait for PUMP OK;
  86   2              OCTRL |= (1<<7);                                //VPPO_EN = 1
  87   2              while((OCTRL & (1<<7)));            //wait for VPPO_EN = 0
  88   2              OCTRL &= ~(1<<6);                               //PUMP_EN=0     
  89   2          }
  90   1              OPSET &= ~EFC_WRITE_MODE;                       //关闭写模式
  91   1              OPSET &= ~EFC_NVR_SET_MODE;             //关闭eeprom擦写使能
  92   1      }
  93          
  94          uint8_t eeprom_read_byte(uint16_t addr)
  95          {
  96   1              uint8_t value;
  97   1      
  98   1              value = (*(volatile uint8_t xdata *)(addr));
  99   1            
 100   1              return value;
 101   1      
 102   1      }
 103          
 104          uint32_t eeprom_read_bytes(uint16_t addr, uint8_t *buff, uint32_t length)
 105          {
 106   1              uint32_t index;
 107   1          
 108   1          for(index = 0; index<length; index++)
 109   1          {
 110   2              buff[index] = (*(volatile uint8_t xdata *)(addr+index));        
 111   2          }
 112   1              
 113   1              return index;
 114   1      }
