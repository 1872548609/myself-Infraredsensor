diff --git a/接收/Driver/src/wdt.c b/接收/Driver/src/wdt.c
--- a/接收/Driver/src/wdt.c
+++ b/接收/Driver/src/wdt.c
@@
 void wdt_init(void)
 {
+    CLKCON |= (1 << 3);   /* WDT 使用 RC38K，先显式打开 RC38K */
     PCLK0 |= (1<<2);
     PRESET0 |= (1<<2);
     WDEN = 1;
 }

