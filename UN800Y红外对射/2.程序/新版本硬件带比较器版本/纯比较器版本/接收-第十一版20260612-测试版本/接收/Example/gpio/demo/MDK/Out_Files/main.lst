 156   3                  gpio_io_set(P1_3, GPIO_HIGH);
 157   3                  gpio_io_set(P1_0, GPIO_LOW);
 158   3      
 159   3                  adcount = 0;
 160   3              }
 161   2      
 162   2              REG_GTIM0_CR0 |= (1 << 0);
 163   2          }
 164   1      }
