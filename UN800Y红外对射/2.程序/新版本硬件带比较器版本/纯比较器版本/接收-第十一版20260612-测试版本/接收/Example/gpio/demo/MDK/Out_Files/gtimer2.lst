 174          /***********************************************************************
 175           * Function     : gtimer2_bke_init
 176           * Description  : gtimer2_bke_init GTIMER2刹车
 177           * Input                : none
C51 COMPILER V9.57.0.0   GTIMER2                                                           07/23/2026 17:30:32 PAGE 4   

 178           * Output               : none
 179           * Return               : none
 180           ***********************************************************************/
 181          void gtimer2_bke_init(void)
 182          {
 183   1              PCLK1 |= (1<<6);                                                                                        //开Gtim2时钟使能       
 184   1              PRESET1 |= (1<<6);                                                                              //GTim2正常工作 
 185   1      
 186   1      //      REG_P00_CFG = 0x05;                                                                     //P00 GTIMER2_BKE 
 187   1              REG_P23_CFG = 0x06;                                                                             //P23 GTIMER2_BKE       
 188   1      //      REG_P27_CFG = 0x06;                                                                             //P27 GTIMER2_BKE 
 189   1              
 190   1              REG_GTIM2_CR1 &= ~(3<<6);                                                       //PWM刹车触发后，PWM正向电平状态设置位:低电平 
 191   1              REG_GTIM2_CR2 &= ~(3<<0);                                                       //PWM刹车触发后，PWM互补电平状态设置位:低电平 
 192   1                                      
 193   1              REG_GTIM2_CR1 &= ~(1<<3);                                                       //刹车信号高电平有效
 194   1                                      
 195   1              REG_GTIM2_CR1 |= (1<<2);                                                        //使能刹车功能 
 196   1                                      
 197   1              REG_GTIM2_CCER |= (1<<0);                                                       //使能输出 
 198   1      }
