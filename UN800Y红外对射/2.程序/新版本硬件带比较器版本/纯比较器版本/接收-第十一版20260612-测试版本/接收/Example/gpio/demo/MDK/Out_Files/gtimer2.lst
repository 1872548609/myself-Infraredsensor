 138          /***********************************************************************
 139           * Function     : gtimer2_capture_init
 140           * Description  : gtimer2_capture_init gtimer2输入捕获
 141           * Input                : uint16_t arr          装载值
 142           *                                      : uint8_t capture_div   捕捉源预分频位
 143           *                                      : uint8_t capssel                       捕捉源选择位
 144           * Output               : none
 145           * Return               : none
 146           ***********************************************************************/
 147          void gtimer2_capture_init(uint16_t arr,uint8_t capture_div,uint8_t capssel)
 148          {
 149   1              PCLK1 |= (1<<6);                                                                                //开Gtim2时钟使能 
 150   1              PRESET1 |= (1<<6);                                                                              //GTim2正常工作 
 151   1              
 152   1              REG_P10_CFG = 0x06;                                                                             //P10 CH 
 153   1              REG_P15_CFG = 0x06;                                                                             //P15 CH 
 154   1      //      REG_P26_CFG = 0x06;                                                                     //P26 CH 
 155   1              
 156   1              REG_GTIM2_ARR1 = ((arr-1)>>8)&0xFF;                             //高8位 自动装载值
 157   1              REG_GTIM2_ARR0 = (arr-1)&0xFF;                                          //低8位 自动装载值
 158   1                                      
 159   1              REG_GTIM2_CCMR0 &= ~(1<<7);                                             //外部计数源滤波使能：无滤波功能
 160   1              REG_GTIM2_CCMR0 |= (1<<0);                                              //配置CCS为输入 
 161   1              
 162   1              REG_GTIM2_CCMR1 = (REG_GTIM2_CCMR1&(~(0x03<<0)))|(capssel<<0);                  //捕捉源选择位 
 163   1              
 164   1              REG_GTIM2_CCMR1 = (REG_GTIM2_CCMR1&(~(3<<5)))|(capture_div<<5);
 165   1                                      
 166   1              REG_GTIM2_CCMR1 &= ~(0x03<<2);                          //捕获沿触发控制位：上升沿触发 
 167   1      
 168   1              REG_GTIM2_CCER |= (1<<0);                                                       //使能捕捉功能 
 169   1              
 170   1      }
