  93          void gtimer2_pwm_init(uint16_t arr, uint16_t psc, uint16_t ccr)
  94          {
  95   1              PCLK1 |= (1<<6);                                                                          //开Gtim2时钟使能     
  96   1              PRESET1 |= (1<<6);                                                                      //GTim2正常工作
  97   1              
  98   1              REG_P10_CFG = 0x06;                                                                     //P10 CH 
  99   1              REG_P15_CFG = 0x06;                                                                     //P15 CH
 100   1      //      REG_P26_CFG = 0x06;                                                             //P26 CH
 101   1      
 102   1              REG_P01_CFG = 0x06;                                                                     //P01 CHN
 103   1              REG_P04_CFG = 0x06;                                                                     //P04 CHN 
 104   1              REG_P22_CFG = 0x06;                                                                     //P22 CHN
 105   1              
 106   1              REG_GTIM2_CR0 |= (1<<6);                                                //使能auto-repload
 107   1                                              
 108   1              REG_GTIM2_PSC1 = (psc>>8)&0xFF;                 //高8位 FCK_CNT=FCK_PSC/(PSC[15:0]+1);  FCK_PSC = APBCLK 
 109   1              REG_GTIM2_PSC0 = psc&0xFF;                                      //低8位 FCK_CNT=FCK_PSC/(PSC[15:0]+1);  FCK_PSC = APBCLK 
 110   1                                      
 111   1              REG_GTIM2_ARR1 = ((arr-1)>>8)&0xFF;                     //高8位 自动装载值 
 112   1              REG_GTIM2_ARR0 = (arr-1)&0xFF;                                  //低8位 自动装载值
 113   1                                              
 114   1              REG_GTIM2_ARRN1 = ((arr-1)>>8)&0xFF;            //高8位 自动装载值 
 115   1              REG_GTIM2_ARRN0 = (arr-1)&0xFF;                                 //低8位 自动装载值 
C51 COMPILER V9.57.0.0   GTIMER2                                                           07/23/2026 17:30:32 PAGE 3   

 116   1                                              
 117   1              REG_GTIM2_CCR1 = (ccr>>8)&0xFF;                 //高8位 比较寄存器 
 118   1              REG_GTIM2_CCR0 = ccr&0xFF;                                      //低8位 比较寄存器 
 119   1                                      
 120   1              REG_GTIM2_CCRN1 = (ccr>>8)&0xFF;                //高8位 比较寄存器 
 121   1              REG_GTIM2_CCRN0 = ccr&0xFF;                                     //低8位 比较寄存器 
 122   1                                              
 123   1              REG_GTIM2_CR1 |= (1<<0);                                                //互补PWM和原PWM反相位 
 124   1                                      
 125   1              REG_GTIM2_CR1 |= (1<<1);                                                //避免死区功能使能 
 126   1                                              
 127   1              REG_GTIM2_EGR = 0x1;                                                            //产生UE事件，将PSC的值立即载入shadow寄存器
 128   1              REG_GTIM2_SR |= (1<<0);                                                 //清除UE产生的中断，否则会直接进入中断服务函数 
 129   1                              
 130   1              REG_GTIM2_CR2 |= (1<<2);                                                //输出总使能
 131   1                                              
 132   1              REG_GTIM2_CCER |= (1<<0);                                               //使能输出
 133   1              
 134   1              
 135   1      }
