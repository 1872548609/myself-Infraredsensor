 201          /************************************************************************
 202           * Function     : gtimer2_irq_init
 203           * Description  : gtimer2_irq_init      GTIMER2 中断初始化
 204           * Input                : uint8_t irq_enable            GTIMER2中断使能开关 1：使能 0：禁止
 205                                                                  uint8_t gtimer_irq_type GTIMER2中断类型选择
 206           *            void (*pfunc)()                                   GTIMER2中断回调函数
 207           * Output       : none
 208           * Return               : none
 209           ************************************************************************/      
 210          void gtimer2_irq_init(uint8_t irq_enable,uint8_t gtimer_irq_type,void (*pfunc)())
 211          {
 212   1              REG_GTIM2_SR = 0x7;             //清除状态标志
 213   1              
 214   1              if(irq_enable == GTIMER_IRQ_ENABLE)
 215   1              {
 216   2                      switch(gtimer_irq_type)
 217   2                      {
 218   3                              case GTIMER2_UIE_IRQ:
 219   3                                              gtimer2_callback[0] = pfunc;
 220   3                                              REG_GTIM2_IER |= GTIMER2_UIE;                           //使能UPDATE中断
 221   3                                              break;
 222   3                              case GTIMER2_CCIE_IRQ:
 223   3                                              gtimer2_callback[1] = pfunc;
 224   3                                              REG_GTIM2_IER |= GTIMER2_CCIE;                  //使能比较/捕捉中断
 225   3                                              break;  
 226   3                              case GTIMER2_BKE_IE_IRQ:
 227   3                                              gtimer2_callback[2] = pfunc;
 228   3                                              REG_GTIM2_IER |= GTIMER2_BKE_IE;                //使能刹车中断
 229   3                                              break;
 230   3                              default:
 231   3                                              break;                          
 232   3                      }       
 233   2                      EA = 1 ;                                                                                                                                        //开启总中断
 234   2                      IEN1 |= (1<<6);                                                                                                         //开启GTIMER2中断
 235   2              }
 236   1              else
 237   1              {
 238   2                      switch(gtimer_irq_type)
 239   2                      {
C51 COMPILER V9.57.0.0   GTIMER2                                                           07/23/2026 17:30:32 PAGE 5   

 240   3                              case GTIMER2_UIE_IRQ:
 241   3                                              gtimer2_callback[0] = pfunc;
 242   3                                              REG_GTIM2_IER |= ~GTIMER2_UIE;                          //禁止UPDATE中断
 243   3                                              break;
 244   3                              case GTIMER2_CCIE_IRQ:
 245   3                                              gtimer2_callback[1] = pfunc;
 246   3                                              REG_GTIM2_IER |= ~GTIMER2_CCIE;                         //禁止比较/捕捉中断
 247   3                                              break;  
 248   3                              case GTIMER2_BKE_IE_IRQ:
 249   3                                              gtimer2_callback[2] = pfunc;
 250   3                                              REG_GTIM2_IER |= ~GTIMER2_BKE_IE;                       //禁止刹车中断
 251   3                                              break;          
 252   3                              default:
 253   3                                              break;                          
 254   3                      }       
 255   2              }
 256   1              
 257   1      }
