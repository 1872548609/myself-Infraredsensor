  14          /***********************************************************************
  15           * Function     : GTIM2_IRQHandler
  16           * Description  : GTIM2 interrupt handling
  17           * Input                : none
  18           * Output               : none   
  19           * Return               : none
  20           ***********************************************************************/
  21          void GTIM2_IRQHandler(void) interrupt 19
  22          {
  23   1              if((REG_GTIM2_SR & GTIMER2_UIF) && (REG_GTIM2_IER & GTIMER2_UIE))                       //UE中断
  24   1              {
  25   2                      if(gtimer2_callback[0] != NULL)
  26   2                      {
  27   3                              gtimer2_callback[0]();
  28   3                      }
  29   2                      REG_GTIM2_SR = GTIMER2_UIF;                                                     //清除UE中断标志
  30   2              }
  31   1              else if((REG_GTIM2_SR & GTIMER2_CCIF) && (REG_GTIM2_IER & GTIMER2_CCIE))                //比较中断/捕捉中断
  32   1              {
  33   2                      if(gtimer2_callback[1] != NULL)
  34   2                      {
  35   3                              gtimer2_callback[1]();
  36   3                      }
  37   2                      REG_GTIM2_SR = GTIMER2_CCIF;                                                    //清除中断/捕捉中断
  38   2              }
  39   1              
  40   1              else if((REG_GTIM2_SR & GTIMER2_BKE_IF)&& (REG_GTIM2_IER & GTIMER2_BKE_IE))     //刹车中断
  41   1              {
  42   2                      if(gtimer2_callback[2] != NULL)
  43   2                      {
  44   3                              gtimer2_callback[2]();
  45   3                      }
  46   2                      REG_GTIM2_SR = GTIMER2_BKE_IF;          //清除刹车中断标志
  47   2              }
  48   1              else
  49   1              {
  50   2                      REG_GTIM2_SR = 0x7;                                                             //清除所有中断标志
  51   2              }
  52   1      } 
