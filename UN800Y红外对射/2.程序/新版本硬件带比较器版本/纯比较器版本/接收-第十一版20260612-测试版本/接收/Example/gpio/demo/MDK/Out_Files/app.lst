  77           * function     : adc_continuous_pro
  78           * Description  : adc call back function of continuous mode
  79           * input                : none
  80           * return               : none
  81           ************************************************************************/
  82          void adc_continuous_pro(void)
  83          {
  84   1                      REG_GTIM1_CR0 &= ~(1<<0);                                       //不使能计数器
  85   1                      temp=0;
  86   1                      temp = REG_GTIM1_CNT0;
  87   1                      temp |= REG_GTIM1_CNT1<<8;
  88   1                      REG_GTIM1_CNT0=0;
  89   1                      REG_GTIM1_CNT1=0;
  90   1                      printfS("%u\r\n", temp);
  91   1                      REG_GTIM1_CR0 |= (1<<0);                                                //使能计数器    
  92   1      
  93   1      }
