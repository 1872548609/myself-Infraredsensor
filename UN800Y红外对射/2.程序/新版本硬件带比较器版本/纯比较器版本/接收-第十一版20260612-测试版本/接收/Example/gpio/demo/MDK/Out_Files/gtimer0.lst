  16          /***********************************************************************
  17           * Function     : GTIM0_IRQHandler
  18           * Description  : GTIM0 interrupt handling
  19           * Input                : none
  20           * Output               : none   
  21           * Return               : none
  22           ***********************************************************************/
  23          void GTIM0_IRQHandler(void) interrupt 21
  24          {
  25   1              if((REG_GTIM0_SR & GTIMER0_UIF)  && (REG_GTIM0_IER & GTIMER0_UIE))              //UE中断
  26   1              {
  27   2                      if(gtimer0_callback[0] != NULL)
  28   2                      {
  29   3                              gtimer0_callback[0]();
  30   3                      }
  31   2                      REG_GTIM0_SR = GTIMER0_UIF;                                             //清除UE中断标志
  32   2              }
  33   1              else if((REG_GTIM0_SR & GTIMER0_CCIF)  && (REG_GTIM0_IER & GTIMER0_CCIE))               //比较中断/捕捉中断
  34   1              {
  35   2                      if(gtimer0_callback[1] != NULL)
  36   2                      {
  37   3                              gtimer0_callback[1]();
  38   3                      }
  39   2                      REG_GTIM0_SR = GTIMER0_CCIF;                                    //清除中断/捕捉中断
  40   2              }
  41   1              else if((REG_GTIM0_SR & GTIMER0_BKE_IF) && (REG_GTIM0_IER & GTIMER0_BKE_IE))                    //刹车中断
  42   1              {
  43   2                      if(gtimer0_callback[2] != NULL)
  44   2                      {
  45   3                              gtimer0_callback[2]();
  46   3                      }
  47   2                      REG_GTIM0_SR = GTIMER0_BKE_IF;                  //清除刹车中断标志
  48   2              }
  49   1              else
  50   1              {
  51   2                      REG_GTIM0_SR = 0x7;                                                                     //清除所有中断标志
  52   2              }
  53   1      }  
