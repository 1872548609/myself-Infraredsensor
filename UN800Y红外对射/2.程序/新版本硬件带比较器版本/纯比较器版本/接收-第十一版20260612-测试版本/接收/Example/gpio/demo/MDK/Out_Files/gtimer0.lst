  56          /************************************************************************
  57           * Function     : gtimer0_count_init
  58           * Description  : gtimer0_count_init GTIMER0 初始化
  59           * Input                : uint8_t arr   GTIMER0重载值
  60                                                                  uint8_t psc GTIMER0分频值
  61           * Output       : none
  62           * Return               : none
  63           ************************************************************************/      
  64          void gtimer0_count_init(uint16_t arr,uint16_t psc)
  65          {
  66   1              PCLK1 |= (1<<3);                                                                          //开Gtim0时钟使能     
  67   1              PRESET1 |= (1<<3);                                                                      //GTim0正常工作
  68   1              
  69   1              REG_GTIM0_CR0 |= (1<<6);                                                //使能auto-repload 
  70   1      
  71   1              REG_GTIM0_PSC1 = (psc>>8)&0xFF;                 //高8位 FCK_CNT=FCK_PSC/(PSC[15:0]+1);  FCK_PSC = APBCLK 
  72   1              REG_GTIM0_PSC0 = psc&0xFF;                                      //低8位 FCK_CNT=FCK_PSC/(PSC[15:0]+1);  FCK_PSC = APBCLK 
  73   1              
  74   1              REG_GTIM0_ARR1 = ((arr-1)>>8)&0xFF;                     //高8位 自动装载值
  75   1              REG_GTIM0_ARR0 = (arr-1)&0xFF;                                  //低8位 自动装载值
  76   1              
  77   1              REG_GTIM0_EGR = 0x1;                                                            //产生UE事件，将PSC的值立即载入shadow寄存器
  78   1              REG_GTIM0_SR |= (1<<0);                                                 //清除UE产生的中断，否则会直接进入中断服务函数
  79   1              
  80   1      }
  81          
  82          
