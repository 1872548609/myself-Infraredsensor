 136          /***********************************************************************
 137           * Function     : gtimer0_capture_init
 138           * Description  : gtimer0_capture_init GTIMER0输入捕获
 139           * Input                : uint16_t arr          装载值
 140           *                                      : uint8_t capture_div   捕捉源预分频位
 141           *                                      : uint8_t capssel                       捕捉源选择位
 142           * Output               : none
 143           * Return               : none
 144           ***********************************************************************/
 145          void gtimer0_capture_init(uint16_t arr,uint8_t capture_div,uint8_t capssel)
 146          {
 147   1              PCLK1 |= (1<<3);                                                                                //开Gtim0时钟使能
 148   1              PRESET1 |= (1<<3);                                                                              //GTim0正常工作
 149   1                      
 150   1              REG_P13_CFG = 0x06;                                                                             //P13 GTIMER0_CH 
 151   1      
 152   1              REG_GTIM0_ARR1 = ((arr-1)>>8)&0xFF;                             //高8位 自动装载值 
 153   1              REG_GTIM0_ARR0 = (arr-1)&0xFF;                                          //低8位 自动装载值 
 154   1                      
 155   1              REG_GTIM0_CCMR0 &= ~(1<<7);                                             //外部计数源滤波使能：无滤波功能 
 156   1              REG_GTIM0_CCMR0 |= (1<<0);                                              //配置CCS为输入 
 157   1              
 158   1              REG_GTIM0_CCMR1 = (REG_GTIM0_CCMR1&(~(0x03<<0)))|(capssel<<0);                  //捕捉源选择位  
 159   1      
 160   1              REG_GTIM0_CCMR1 = (REG_GTIM0_CCMR1&(~(3<<5)))|(capture_div<<5); //分频配置
 161   1                      
 162   1              REG_GTIM0_CCMR1 &= ~(0x03<<2);                          //捕获沿触发控制位：上升沿触发 
 163   1                      
 164   1              REG_GTIM0_CCER |= (1<<0);                                                       //使能捕捉功能 
 165   1              
 166   1      }
