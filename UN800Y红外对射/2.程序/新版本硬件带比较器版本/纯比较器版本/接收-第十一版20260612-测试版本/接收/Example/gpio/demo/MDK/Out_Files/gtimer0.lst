 187          /************************************************************************
 188           * Function     : gtimer0_irq_init
 189           * Description  : gtimer0_irq_init      GTIMER0 中断初始化
 190           * Input                : uint8_t irq_enable            GTIMER0中断使能开关 1：使能 0：禁止
 191           *                                              uint8_t gtimer_irq_type GTIMER0中断类型选择
 192           *            void (*pfunc)()                                   GTIMER0中断回调函数
 193           * Output       : none
 194           * Return               : none
 195           ************************************************************************/      
 196          void gtimer0_irq_init(uint8_t irq_enable,uint8_t gtimer_irq_type,void (*pfunc)())
 197          {
 198   1              REG_GTIM0_SR = 0x7;             //清除状态标志
 199   1              
 200   1              if(irq_enable == GTIMER_IRQ_ENABLE)
 201   1              {
 202   2                      switch(gtimer_irq_type)
 203   2                      {
 204   3                              case GTIMER0_UIE_IRQ:
 205   3                                              gtimer0_callback[0] = pfunc;
 206   3                                              REG_GTIM0_IER |= GTIMER0_UIE;                           //使能UPDATE中断
 207   3                                              break;
 208   3                              case GTIMER0_CCIE_IRQ:
 209   3                                              gtimer0_callback[1] = pfunc;
 210   3                                              REG_GTIM0_IER |= GTIMER0_CCIE;                  //使能比较/捕捉中断
 211   3                                              break;  
 212   3                              case GTIMER0_BKE_IE_IRQ:
 213   3                                              gtimer0_callback[2] = pfunc;
 214   3                                              REG_GTIM0_IER |= GTIMER0_BKE_IE;                //使能刹车中断
 215   3                                              break;
 216   3                              default:
 217   3                                              break;                          
 218   3                      }       
 219   2                      EA = 1 ;                                                                                                                                        //开启总中断
 220   2                      IEN1 |= (1<<0);                                                                                                         //开启gtimer0中断 
 221   2              }
 222   1              else
 223   1              {
 224   2                      switch(gtimer_irq_type)
 225   2                      {
 226   3                              case GTIMER0_UIE_IRQ:
 227   3                                              gtimer0_callback[0] = pfunc;
 228   3                                              REG_GTIM0_IER |= ~GTIMER0_UIE;                  //禁止UPDATE中断
 229   3                                              break;
 230   3                              case GTIMER0_CCIE_IRQ:
 231   3                                              gtimer0_callback[1] = pfunc;
 232   3                                              REG_GTIM0_IER |= ~GTIMER0_CCIE;                 //禁止比较/捕捉中断
 233   3                                              break;  
 234   3                              case GTIMER0_BKE_IE_IRQ:
 235   3                                              gtimer0_callback[2] = pfunc;
 236   3                                              REG_GTIM0_IER |= ~GTIMER0_BKE_IE;               //禁止刹车中断
 237   3                                              break;          
 238   3                              default:
 239   3                                              break;                          
