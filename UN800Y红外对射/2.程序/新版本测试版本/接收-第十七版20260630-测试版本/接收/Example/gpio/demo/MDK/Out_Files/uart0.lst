 154          /************************************************************************
 155           * Function     : uart0_send_bytes
 156           * Description  : uart0 send bytes      发送多个字节
 157           * Input                : uint8_t* buff: out buffer
 158           *                        uint32_t length: buffer length
 159           * Output               : none  
 160           * Return               : none
 161           ************************************************************************/
 162          void uart0_send_bytes(uint8_t *buff, uint32_t length)
 163          {
 164   1              while(length--)
 165   1              {
 166   2                      uart0_send_byte(*buff++);
 167   2              }       
 168   1      }
