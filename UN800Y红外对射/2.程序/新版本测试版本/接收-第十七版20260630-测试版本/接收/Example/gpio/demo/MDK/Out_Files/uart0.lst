 123          /************************************************************************
 124           * Function     : uart0_send_byte
 125           * Description  : uart0 发送一个字节数据
 126           * Input                : char c: out byte
 127           * Output               : none  
 128           * Return               : none
 129           ************************************************************************/
 130          void uart0_send_byte(char c)
 131          {
 132   1              //输出一个字符
 133   1              uint16_t timeout;
 134   1              timeout = 65535;
 135   1              
 136   1              S0BUF = c;
 137   1      
 138   1      #ifdef UART0_TX_INT_MODE                //中断方式
                      while(!tx_flag);
                      tx_flag = 0; 
              #else 
 142   1              //查询方式
 143   1          while(!(TI0))                       //等待数据发送完成
 144   1              {
 145   2                      if((timeout--) == 0)            //超时等待退出
 146   2              {
 147   3                              break;
 148   3              }
 149   2              }
 150   1              TI0 = 0;                                //清除发送完成标志位
 151   1      #endif
 152   1      }
