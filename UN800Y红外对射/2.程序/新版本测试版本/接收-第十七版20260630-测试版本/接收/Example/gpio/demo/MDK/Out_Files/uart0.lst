  47          /************************************************************************
  48           * Function     : uart0_set_baud_rate
  49           * Description  : uart0 set baud rate
  50           * Input                : uint32_t clk_hz: cpu frequency
  51           *                        uint32_t baud_rate: Series rate         Baud Rate = SYSCK/(16*(1024-S0REL))   SYSCK:RC16M                             
             -                
  52           * Output               : none  
C51 COMPILER V9.57.0.0   UART0                                                             06/30/2026 17:38:31 PAGE 2   

  53           * Return               : none
  54           ************************************************************************/
  55          static void uart0_set_baud_rate(uint32_t clk_hz, uint32_t baud_rate)    
  56          {       
  57   1              uint32_t temp;
  58   1              uint8_t MSbyte, LSbyte;
  59   1          
  60   1              temp = baud_rate * 16;
  61   1          temp = (clk_hz + (temp / 2))/ temp;
  62   1              temp = 1024 - temp ;
  63   1        
  64   1              MSbyte = temp>>8;
  65   1              LSbyte = temp;
  66   1              
  67   1              S0RELH = MSbyte & 0x3;
  68   1              S0RELL = LSbyte;                
  69   1      }
  70          
  71          /************************************************************************
  72           * Function     : uart0_init
  73           * Description  : uart0 initial for  baud_rate
  74           * Input                : uint32_t baud_rate: Series rate 
  75           * Output               : none
  76           * Return               : none
  77           ************************************************************************/
  78          void uart0_init(uint32_t baud_rate)
  79          {
  80   1              
  81   1              PCLK0 |= (1<<0);                                                                               //开UART0时钟使能        
  82   1              PRESET0 |= (1<<0);                                                                                 //UART0正常工作
  83   1              EUARTEN |= (1<<0);                                                                                 //打开EUART0功能，P2.6作UART0_TX，P2.7作UART0_RX
  84   1      
  85   1        tx_flag = 0;
  86   1          
  87   1              SM0 = 0;
  88   1              SM1 = 1;                                                          //选择模式一
  89   1                      
  90   1              TI0 = 0;                                                  //发送完成中断状态清除
  91   1              RI0 = 0;                                                      //接收完成中断状态清除
  92   1              
  93   1              uart0_set_baud_rate(system_core_clock, baud_rate);        //设置波特率
  94   1              REN0 = 1;                                                 //使能接收    
  95   1              
  96   1              P2PU &= ~(3<<6);                                                                                                //使能P2.6,P2.7内部上拉  
  97   1      }
  98          
  99          /************************************************************************
 100           * Function     : uart0_irq_init
 101           * Description  : uart0 interrupt enable
 102           * Input                : uint8_t irqstate: 0 中断失能，1 中断使能
 103           *                                *pfunc_recv)(): 接收处理回调函数
 104           * Output               : none
 105           * Return               : none
 106           ************************************************************************/
 107          void uart0_irq_init(uint8_t irqstate,void (*pfunc_recv)())
 108          {
 109   1          if(irqstate == UART0_IRQ_ENABLE)
 110   1          {
 111   2              EA = 1;                                         //EA总中断开启
 112   2              ES0 = 1;                                        //UART0中断使能   
 113   2              
 114   2              uart0_func = pfunc_recv;       
