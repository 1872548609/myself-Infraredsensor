 528   1      
 529   1          first_delay_tick = RX_FIRST_WINDOW_DELAY_TICK;
 530   1      
 531   1          /*
 532   1           * 0us 容易造成定时器重装异常。
 533   1           * 如果确实要同步后马上补采，使用 RX_FIRST_WINDOW_IMMEDIATE。
 534   1           */
 535   1          if (first_delay_tick == 0U)
 536   1          {
 537   2              first_delay_tick = 1U;
 538   2          }
 539   1      
 540   1          /*
 541   1           * 这里做保护：起点间隔最大不超过后续周期。
 542   1           * 本需求主要用于“前移一点”，所以通常应小于 1000us。
 543   1           */
 544   1          if (first_delay_tick > RX_WINDOW_INTERVAL_TICK)
 545   1          {
 546   2              first_delay_tick = RX_WINDOW_INTERVAL_TICK;
 547   2          }
 548   1      
C51 COMPILER V9.57.0.0   MAIN                                                              06/17/2026 22:13:31 PAGE 10  

 549   1          return first_delay_tick;
 550   1      }
