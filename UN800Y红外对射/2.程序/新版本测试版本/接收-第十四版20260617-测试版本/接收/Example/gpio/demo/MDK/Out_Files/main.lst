  93          /*======================================================================
  94           * 一、接收算法参数
  95           *====================================================================*/
  96          
  97          /*
  98           * 系统主频 24MHz，GTIMER0 使用 24 分频：
  99           * 24MHz / 24 = 1MHz，1 tick = 1us。
 100           */
 101          
 102          /*
 103           * 【有光确认次数】
 104           * 连续 3 个 ADC 窗口有效才确认有光。
 105           * 作用：防止单个窗口偶然采到噪声就立即输出有光。
 106           * 影响：越大，来光响应越慢；越小，越容易误亮。
 107           */
 108          #define RX_CONFIRM_COUNT              3U
 109          
 110          /*
 111           * 定时器窗口间隔周期。
 112           * 默认 1000us，也就是同步后每隔 1ms 打开一次 ADC 扫描窗口。
 113           * 如果发射端周期不是 1ms，只需要改这里。
 114           */
 115          /*
C51 COMPILER V9.57.0.0   MAIN                                                              06/17/2026 22:13:31 PAGE 3   

 116           * 【窗口周期】
 117           * GTIMER0 后续每 1000us 触发一次 ADC 扫描窗口。
 118           * 注意：这里只是“窗口起点周期”，不是 ADC 窗口宽度。
 119           * 如果发射端有效脉冲周期不是 1ms，这里必须跟着改。
 120           */
 121          #define RX_WINDOW_INTERVAL_TICK       1000U
 122          
 123          /*
 124           * 同步中断后的第一次窗口起点间隔。
 125           *
 126           * 这个参数只影响“同步后的第一次 ADC 窗口”。
 127           * 第一次窗口之后，后续窗口仍然保持 RX_WINDOW_INTERVAL_TICK，也就是 1000us。
 128           *
 129           * 调试方法：
 130           * - 如果示波器看到 ADC 窗口整体偏后，就把这里调小，例如 950、900、850。
 131           * - 如果示波器看到 ADC 窗口整体偏前，就把这里调大，最大不要超过 RX_WINDOW_INTERVAL_TICK。
 132           *
 133           * 例：
 134           * - 1000U：等同旧版，同步后 1000us 才打开第一次窗口。
 135           * - 900U ：同步后 900us 打开第一次窗口，相当于后续相位整体提前 100us。
 136           */
 137          /*
 138           * 【第一次窗口延迟】
 139           * 收到 P1_4 同步边沿后，不是立刻采 ADC，而是等待 880us 再打开第一次窗口。
 140           * 这个值决定采样窗口相对于发射脉冲的位置。
 141           *
 142           * 排查点：
 143           * - 如果这个值偏差太大，窗口可能扫不到脉冲，导致误遮光。
 144           * - 如果窗口扫到脉冲尾部，平均值会偏低，可能刚好低于阈值。
 145           */
 146          #define RX_FIRST_WINDOW_DELAY_TICK    880U
 147          
 148          /*
 149           * ADC 连续扫描窗口宽度。
 150           * 默认 40us。
 151           *
 152           * 发射有效脉宽约 25us 时：
 153           * - 窗口太小：容易因为相位偏差漏掉脉冲；
 154           * - 窗口太大：平均值会被窗口内的低电平拉低，需要适当降低 adc_set；
 155           * - 建议先用 30~60us 调试。
 156           */
 157          /*
 158           * 【ADC 窗口宽度】
 159           * 每次窗口持续 100us，在这 100us 内连续读 ADC 并求平均。
 160           *
 161           * 排查点：
 162           * - 发射有效脉宽如果只有约 25us，100us 求平均会把峰值稀释。
 163           * - 例如 25us 有效 + 75us 无信号，平均值大约只有峰值的 1/4。
 164           * - 所以 adc_set 必须按“窗口平均值”标定，不是按峰值标定。
 165           */
 166          #define RX_ADC_WINDOW_WIDTH_TICK      100U
 167          
 168          /*
 169           * 连续多少个 ADC 窗口无效后判定遮光。
 170           * 默认 3 个窗口，即约 3ms 遮光确认，响应约 333Hz。
 171           * 如果想更快，可以改 2；如果现场抖动明显，可以改 4 或 5。
 172           */
 173          /*
 174           * 【遮光确认次数】
 175           * 连续 3 个窗口无效才判定遮光。
 176           * 正常情况下遮光响应约为：3 * 1ms = 3ms。
 177           *
C51 COMPILER V9.57.0.0   MAIN                                                              06/17/2026 22:13:31 PAGE 4   

 178           * 排查点：
 179           * 如果遮光时偶尔还能采到有效值，rx_lost_window_count 会被清零，
 180           * 就会表现为“明明遮挡了，但偶尔不判断遮光”。
 181           */
 182          #define RX_LOST_WINDOW_COUNT          3U
 183          
 184          /*
 185           * 周期性强制重新同步功能。
 186           *
 187           * 作用：
 188           * 同步后虽然 GTIMER0 每 1ms 周期本身稳定，但接收端本地定时器和发射端周期
 189           * 之间可能有微小频差，累计一段时间后 ADC 窗口会相对发射脉冲慢慢漂移。
 190           * 所以每处理 RX_RESYNC_WINDOW_COUNT 个窗口后，主动退出当前 1ms 周期采样，
 191           * 重新打开 P1_4 同步中断，等下一次发射脉冲边沿重新校准相位。
 192           *
 193           * 注意：
 194           * 强制重同步不会把输出拉成遮光，只是暂停周期窗口并等待下一次同步边沿。
 195           * 如果确实已经遮光，则仍然由 RX_LOST_WINDOW_COUNT 个无效窗口走遮光逻辑。
 196           *
 197           * 默认 100 个周期，即约每 100ms 重新同步一次。
 198           * 如果漂移很快，可以改 50 或 20；如果现场很稳，可以改 200。
 199           */
 200          /*
 201           * 【是否启用强制重同步】
 202           * 1 = 启用；0 = 关闭。
 203           *
 204           * 排查建议：
 205           * 若出现“遮光偶尔不判断”，可以先临时改成 0U。
 206           * 如果关闭后问题消失，说明问题在强制重同步等待链路。
 207           */
 208          #define RX_RESYNC_ENABLE              1U
 209          /*
 210           * 【强制重同步窗口数】
 211           * 当前为 3U，表示每 3 个有效窗口就强制重同步一次。
 212           *
 213           * 重要排查点：
 214           * - 这个值和上方注释里“默认 100 个周期”不一致。
 215           * - 3U 太频繁，大约每 3ms 停一次 GTIMER0 ADC 窗口。
 216           * - 停止 ADC 窗口后，遮光不再走 rx_lost_window_count，
 217           *   而是依赖 GTIMER1 的 2ms 同步等待超时。
 218           * - 如果 GTIMER1 超时没有被主循环及时处理，输出可能保持有光。
 219           *
 220           * 建议调试：先改 100U 或关闭 RX_RESYNC_ENABLE 验证。
 221           */
 222          #define RX_RESYNC_WINDOW_COUNT        3U
 223          
 224          /*
 225           * 强制重同步等待超时。
 226           * 周期性强制重同步时，接收端会停止 GTIMER0 窗口采样并重新打开 P1_4。
 227           * 如果 2ms 内没有收到新的 P1_4 同步边沿，就认为当前已经遮光。
 228           * 这个超时只用于“已经有光后的强制重同步等待期”，上电遮光等待不启动。
 229           */
 230          /*
 231           * 【强制重同步等待超时】
 232           * 已经有光时进入强制重同步，如果 2ms 内没有新的 P1_4 同步边沿，
 233           * 就认为可能已经遮光。
 234           *
 235           * 排查点：
 236           * 只有 rx_force_resync_from_main() 里 rx_light_state != 0 时才启动。
 237           * 上电无光等待同步时不会启动这个超时。
 238           */
 239          #define RX_SYNC_WAIT_TIMEOUT_TICK     2000U
