 498          {
 499   1          uint16_t now_tick;
 500   1          uint16_t elapsed;
 501   1      
 502   1          now_tick = rx_timer_get_count();
 503   1      
 504   1          if (now_tick >= start_tick)
 505   1          {
 506   2              elapsed = (uint16_t)(now_tick - start_tick);
 507   2          }
 508   1          else
 509   1          {
 510   2              /* GTIMER0 在 RX_WINDOW_INTERVAL_TICK 周期回卷。 */
 511   2              elapsed = (uint16_t)((RX_WINDOW_INTERVAL_TICK - start_tick) + now_tick);
 512   2          }
 513   1      
 514   1          return elapsed;
 515   1      }
