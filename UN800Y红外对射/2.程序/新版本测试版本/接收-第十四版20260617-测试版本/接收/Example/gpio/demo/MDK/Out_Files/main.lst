 476          {
 477   1          uint16_t cnt;
 478   1      
 479   1          cnt  = REG_GTIM0_CNT0;
 480   1          cnt |= ((uint16_t)REG_GTIM0_CNT1 << 8);
 481   1      
 482   1          return cnt;
 483   1      }
