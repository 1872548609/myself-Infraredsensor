 438          static void capture_timer_start(void)
 439          {
 440   1          /*
 441   1           * 每一帧重新从 0 开始计时。
 442   1           * 这里相当于打开本帧采集定时。
 443   1           */
 444   1          REG_GTIM0_SR = 0x07;
 445   1          REG_GTIM0_CNT0 = 0x00;
 446   1          REG_GTIM0_CNT1 = 0x00;
 447   1          gtimer0_start();
 448   1      }
 449          
 450          static void capture_timer_close(void)
 451          {
 452   1          /*
 453   1           * 旧工程库里只使用 gtimer0_start()，没有统一暴露 stop 接口。
 454   1           * 所以这里做“逻辑关闭”：本帧结束后不再读取 Timer0 判断采集时间，
 455   1           * 下一帧开始时重新清零计数器。
 456   1           */
