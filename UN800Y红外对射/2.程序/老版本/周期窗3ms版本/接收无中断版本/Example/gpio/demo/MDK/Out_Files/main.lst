 344   2               * ADJ 不在采集窗口中读取，避免抢占接收 ADC 时间。
 345   2               * 每若干帧更新一次即可。
 346   2               */
 347   2              g_adj_update_frame_count++;
 348   2              if(g_adj_update_frame_count >= ADJ_UPDATE_FRAME_COUNT)
 349   2              {
