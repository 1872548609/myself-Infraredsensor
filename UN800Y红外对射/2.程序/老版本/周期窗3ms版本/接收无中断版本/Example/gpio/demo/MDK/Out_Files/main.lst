 370   1          gpio_io_set(IR_OUT_NO_PIN, OUT_INACTIVE_LEVEL);
 371   1      
 372   1          REG_P12_CFG = 0x00;
 373   1          gpio_init(IR_OUT_NC_PIN);
 374   1          gpio_dir_set(IR_OUT_NC_PIN, GPIO_DIR_OUT);
 375   1          gpio_dr_set(IR_OUT_NC_PIN, GPIO_SR_HIGH);
 376   1      #if RX_NC_WINDOW_DEBUG_ENABLE
 377   1          /* 调试模式下，NC 先保持关闭，采集窗口开始时再打开。 */
 378   1          gpio_io_set(IR_OUT_NC_PIN, OUT_INACTIVE_LEVEL);
 379   1      #else
                  /* 正常模式下，NC 作为常闭输出，初始为闭合/动作状态。 */
                  gpio_io_set(IR_OUT_NC_PIN, OUT_ACTIVE_LEVEL);
              #endif
 383   1      
 384   1          REG_P13_CFG = 0x00;
 385   1          gpio_init(IR_LED_PIN);
 386   1          gpio_dir_set(IR_LED_PIN, GPIO_DIR_OUT);
 387   1          gpio_dr_set(IR_LED_PIN, GPIO_SR_HIGH);
