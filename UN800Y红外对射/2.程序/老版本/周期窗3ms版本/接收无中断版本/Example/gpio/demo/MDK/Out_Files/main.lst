 364          void GPIO_Init(void)
 365          {
 366   1          REG_P10_CFG = 0x00;
 367   1          gpio_init(IR_OUT_NO_PIN);
 368   1          gpio_dir_set(IR_OUT_NO_PIN, GPIO_DIR_OUT);
