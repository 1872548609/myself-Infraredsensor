 118          
 119          /* 24MHz / (23 + 1) = 1MHz，所以 Timer0 每 1us 加 1。 */
 120          #define TIMER0_1US_RELOAD               0xFFFFU
 121          #define TIMER0_1US_PRESCALER            23U
 122          
 123          /*
 124           * 每帧采集窗口。
 125           * 发射周期约 1ms，脉冲宽度约 25us。
 126           *
 127           * 如果只采 1ms，边界处可能刚好把脉冲切开。
 128           * 这里默认采 1.2ms，基本能覆盖至少一个完整脉冲。
 129           *
 130           * 响应速度估算：
 131           *  1.2ms 一帧；
 132           *  连续 2 帧确认有光约 2.4ms，约 416Hz；
 133           *  连续 5 帧确认遮光约 6ms，约 166Hz。
 134           */
 135          #define RX_CAPTURE_WINDOW_US            1100U
 136          
 137          /*
 138           * 一帧最多保存多少个 ADC 点。
 139           * 旧版 384 点处理量偏大；本快速版限制为 160 点。
 140           * 采集窗口仍持续 1100us，但数组满后不再写入，后续处理只处理 160 点，
 141           * 可以显著缩短“窗口关闭到下一窗口打开”的处理间隔。
 142           */
 143          #define RX_ADC_FRAME_MAX_SAMPLES        160U
 144          
 145          /* 如果一帧采样点数太少，说明 ADC 或定时器异常，本帧直接判无效。 */
 146          #define RX_FRAME_MIN_SAMPLES            16U
 147          
 148          /*======================================================================
 149           * 七、数组均值化处理参数
 150           *====================================================================*/
 151          
 152          /*
 153           * 信号均值使用一帧里最强的若干个点。
 154           * 25us 脉冲内通常能采到多个点，取最强点平均可抗单点尖峰。
 155           */
 156          #define RX_SIGNAL_TOP_AVG_COUNT         4U
 157          
 158          /*
 159           * 背景基线均值使用一帧里最弱的若干个点。
 160           * 因为一帧中绝大部分时间都没有红外脉冲，所以低端样本通常代表环境背景。
 161           */
 162          #define RX_BASELINE_AVG_COUNT           8U
 163          
 164          /* 一帧中至少要有多少个点超过幅度阈值，才认为真的有脉冲。 */
 165          #define RX_ACTIVE_POINT_MIN             2U
 166          
 167          /*
 168           * 有效点数量上限百分比。
 169           * 真实 25us / 1200us 约 2.1%。考虑运放拖尾和采样误差，放宽到 35%。
 170           * 如果一帧中超过阈值的点太多，通常不是 25us 脉冲，而是饱和、环境干扰或基线错误。
 171           */
 172          #define RX_ACTIVE_POINT_MAX_PERCENT     35U
