  32          /*======================================================================
  33           * 一、接收算法参数
  34           *====================================================================*/
  35          
  36          /*
  37           * 系统主频 24MHz，GTIMER0 使用 24 分频：
  38           *
  39           * 定时器频率 = 24MHz / 24 = 1MHz
  40           * 1 tick = 1us
  41           *
  42           * 发射周期 = 1ms
  43           * 发射占空比 = 0.025
  44           * 有效脉宽 ≈ 25us
  45           *
  46           * 当前判断策略：
  47           *
  48           * 1. P1_4 每 1ms 应收到一次比较器脉冲。
  49           * 2. 小于 600us 的重复边沿，不可能是下一次真实发射脉冲，
  50           *    直接认为是毛刺、振铃或双边沿。
  51           * 3. 连续 3 个合格脉冲确认有光。
  52           * 4. 1.5ms 内没有新的合格脉冲，判定遮光。
  53           *
C51 COMPILER V9.57.0.0   MAIN                                                              06/16/2026 14:42:23 PAGE 2   

  54           * 注意：
  55           * RX_LOST_TIMEOUT_TICK = 1500U 比较激进。
  56           * 它只允许 1ms 周期有约 500us 余量。
  57           * 如果现场 TO 频繁增加、输出仍然抖动，
  58           * 可以把它改成 2500U 或 3000U，仍然满足 200Hz 响应要求。
  59           */
  60          
  61          #define RX_CONFIRM_COUNT          3U
  62          
  63          #define RX_MIN_PERIOD_TICK        600U     /* 600us 内重复边沿认为是毛刺 */
  64          
  65          /*
  66           * RX_MAX_PERIOD_TICK 必须小于 RX_LOST_TIMEOUT_TICK。
  67           *
  68           * 当前丢光超时是 1500us。
  69           * 如果这里写 1600us，那么还没进入“周期过长”判断，
  70           * 定时器就已经先超时了。
  71           */
  72          #define RX_MAX_PERIOD_TICK        1300U    /* 大于 1.3ms 认为周期偏长 */
  73          
  74          /*
  75           * 1.5ms 丢光超时。
  76           *
  77           * 优点：
  78           *      遮光响应非常快，约 667Hz。
  79           *
  80           * 缺点：
  81           *      只要漏掉一个 1ms 脉冲，或者某次 ADC 没过阈值，
  82           *      就可能触发丢光，抗抖余量较小。
  83           */
  84          #define RX_LOST_TIMEOUT_TICK      2500U
  85          
  86          
  87          /*======================================================================
  88           * 二、ADC 迟滞参数
  89           *====================================================================*/
  90          
  91          /*
  92           * adc_set 是 ADC 有效上阈值。
  93           *
  94           * 当前默认：
  95           *      adc_set = 200
  96           *      RX_ADC_HYS_VALUE = 120
  97           *
  98           * 因此：
  99           *      ADC >= 200 ：ADC 状态切换为有效；
 100           *      ADC <= 80  ：ADC 状态切换为无效；
 101           *      80 ~ 200   ：保持上一次 ADC 状态。
 102           *
 103           * 这样可以明显减少 ADC 在阈值附近跳动导致的输出抖动。
 104           *
 105           * 注意：
 106           * RX_ADC_HYS_VALUE 越大，抗抖越强，但 ADC 状态释放越慢。
 107           * 如果遮光后 ADC 残余值仍然高于 80，并且 P1_4 仍然有毛刺，
 108           * 可能会导致输出不容易释放。
 109           *
 110           * 调试判断：
 111           * 1. AF 持续增加：说明 ADC 经常不过阈值，可能 TH 太高或采样时机偏晚。
 112           * 2. L 不释放但 S 在 80~200：说明迟滞下阈值太低，可以减小 HYS。
 113           * 3. S 在 TH 附近抖：可以适当增大 HYS。
 114           */
