 333          static uint16_t rx_adc_read_once(uint8_t ch)
 334          {
 335   1          uint16_t value;
 336   1      
 337   1          adc_convert_start(ch);
 338   1      
 339   1          while ((ADCGCR1 & 0x04) != 0);
 340   1          while (!(ADCCSTAT & 0x01));
 341   1      
 342   1          ADCCSTAT = 0x01;
 343   1      
 344   1          /*
 345   1           * 这里沿用你原工程里的 adc_get_value()。
 346   1           */
 347   1          value = adc_get_value();
 348   1      
 349   1          if (value > ADC_MAX_VALUE)
 350   1          {
 351   2              value = ADC_MAX_VALUE;
 352   2          }
 353   1      
 354   1          return value;
 355   1      }
 356          
