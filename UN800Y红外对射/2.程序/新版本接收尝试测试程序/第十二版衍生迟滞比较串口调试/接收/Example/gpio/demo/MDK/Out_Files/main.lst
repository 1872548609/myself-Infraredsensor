 369          static uint8_t rx_adc_hysteresis_check(uint16_t adc)
 370          {
 371   1          uint16_t adc_on_th;
 372   1          uint16_t adc_off_th;
 373   1      
 374   1          /*
 375   1           * 异常值保护。
 376   1           */
 377   1          if (adc >= RX_ADC_MAX_VALID)
 378   1          {
 379   2              rx_adc_valid_state = 0;
 380   2              return 0;
 381   2          }
 382   1      
 383   1          adc_on_th  = adc_set;
 384   1          adc_off_th = rx_adc_calc_off_threshold();
 385   1      
 386   1          if (rx_adc_valid_state == 0)
 387   1          {
 388   2              /*
 389   2               * 当前 ADC 状态为无效。
 390   2               * 必须超过上阈值，才切换为有效。
 391   2               */
 392   2              if (adc >= adc_on_th)
 393   2              {
 394   3                  rx_adc_valid_state = 1;
 395   3              }
 396   2          }
 397   1          else
 398   1          {
 399   2              /*
 400   2               * 当前 ADC 状态为有效。
 401   2               * 必须低于下阈值，才切换为无效。
 402   2               */
 403   2              if (adc <= adc_off_th)
 404   2              {
 405   3                  rx_adc_valid_state = 0;
 406   3              }
 407   2          }
 408   1      
 409   1          return rx_adc_valid_state;
 410   1      }
