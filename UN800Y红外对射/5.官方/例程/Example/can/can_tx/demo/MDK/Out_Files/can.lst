  14          /************************************************************************
  15           * function   : CAN_IRQHandler
  16           * Description: CAN IRQ Handler
  17           * input : none
  18           * return: none
  19           ************************************************************************/
  20          void CAN_IRQHandler(void) interrupt 8
  21          {
  22   1        uint8_t irq_status;
  23   1        
  24   1        irq_status = REG_CAN_ISR;
  25   1        
  26   1        if(irq_status & CAN_IMR_TIM) 
  27   1        {
  28   2          if(can_callback != NULL)
  29   2          {
  30   3            ((void(*)())(can_callback))();  //can的回调函数
  31   3          }
  32   2          REG_CAN_ISR = CAN_IMR_TIM;      //清除中断状态
  33   2        }
  34   1        else 
  35   1        {
  36   2          REG_CAN_ISR = 0x7f;
  37   2        }
  38   1        
  39   1      }
  40          /************************************************************************
  41          * function   : can_init
  42          * Description: can_init
  43          * input    : baudrate 速率可以选择为1M/500k/250k/125k bps
  44            
  45            Fpclk=16Mhz,
  46            CAN波特率 BitRate = Fpclk/2*((BRP+1)*(TS1+TS2+3)), 有个约定:TS1>=TS2
  47          
  48            设波特率为1M的参数：
  49              设置BRP=0(2分频), BitRate = 1M = 16M/2((0+1)*(TS1+TS2+3)),所以可以设置TS1=3,TS2=2
  50          
  51            设波特率为500K的参数：
  52              设置BRP=1(4分频), BitRate = 0.5M = 16M/2((1+1)*(TS1+TS2+3)),所以可以设置TS1=3,TS2=2
  53          
  54            设波特率为250K的参数：
C51 COMPILER V9.60.0.0   CAN                                                               04/24/2022 14:06:18 PAGE 2   

  55              设置BRP=3(8分频), BitRate = 0.25M = 16M/2((3+1)*(TS1+TS2+3)),所以可以设置TS1=3,TS2=2
  56            
  57            设波特率为125K的参数：
  58              设置BRP=7(16分频), BitRate = 0.125M = 16M/2((7+1)*(TS1+TS2+3)),所以可以设置TS1=3,TS2=2
  59          
  60          
  61           * return: none
  62          
  63           ************************************************************************/
  64          void can_init(uint8_t baudrate)
  65          {
  66   1        BEEPCTR |= (1<<5);        //CAN时钟打开
  67   1        BEEPCTR |= (1<<3);        //CAN复位释放
  68   1        
  69   1        REG_P12_CFG = 0x7;        //P12复用为CAN_TX
  70   1      
  71   1        REG_P23_CFG = 0x7;        //P23复用为CAN_RX
  72   1      
  73   1        REG_CAN_MR |= (1<<2);       //CAN工作复位模式
  74   1      
  75   1        switch(baudrate)
  76   1          {
  77   2               case 0:                                          //1M bps
  78   2              REG_CAN_BTR0 = (REG_CAN_BTR0&(~(0x03<<6)))|(1<<6);  //SJW同步跳跃宽度 2个时间单元
  79   2              REG_CAN_BTR0 = (REG_CAN_BTR0&(~(0x3f<<0)))|(0<<0);  //BRP 2分频
  80   2              REG_CAN_BTR1 = (REG_CAN_BTR1&(~(0x0f<<0)))|(8<<0);  //TS1 5个时间单元
  81   2              REG_CAN_BTR1 = (REG_CAN_BTR1&(~(0x07<<4)))|(1<<4);  //TS2 6个时间单元间单元
  82   2           
  83   2              break;
  84   2           
  85   2           case 1:                                          //500k bps
  86   2              REG_CAN_BTR0 = (REG_CAN_BTR0&(~(0x03<<6)))|(1<<6);  //SJW同步跳跃宽度 2个时间单元
  87   2              REG_CAN_BTR0 = (REG_CAN_BTR0&(~(0x3f<<0)))|(1<<0);  //BRP 4分频
  88   2              REG_CAN_BTR1 = (REG_CAN_BTR1&(~(0x0f<<0)))|(3<<0);  //TS1 4个时间单元
  89   2              REG_CAN_BTR1 = (REG_CAN_BTR1&(~(0x07<<4)))|(2<<4);  //TS2 3个时间单元
  90   2              break;
  91   2           
  92   2           case 2:                                          //250k bps     
  93   2              REG_CAN_BTR0 = (REG_CAN_BTR0&(~(0x03<<6)))|(1<<6);  //SJW同步跳跃宽度 2个时间单元
  94   2              REG_CAN_BTR0 = (REG_CAN_BTR0&(~(0x3f<<0)))|(3<<0);  //BRP 8分频
  95   2              REG_CAN_BTR1 = (REG_CAN_BTR1&(~(0x0f<<0)))|(3<<0);  //TS1 4个时间单元
  96   2              REG_CAN_BTR1 = (REG_CAN_BTR1&(~(0x07<<4)))|(2<<4);  //TS2 3个时间单元
  97   2              break;
  98   2           
  99   2           case 3:                                          //125k bps 
 100   2              REG_CAN_BTR0 = (REG_CAN_BTR0&(~(0x03<<6)))|(1<<6);  //SJW同步跳跃宽度 2个时间单元
 101   2              REG_CAN_BTR0 = (REG_CAN_BTR0&(~(0x3f<<0)))|(7<<0);  //BRP 16分频
 102   2              REG_CAN_BTR1 = (REG_CAN_BTR1&(~(0x0f<<0)))|(3<<0);  //TS1 4个时间单元
 103   2              REG_CAN_BTR1 = (REG_CAN_BTR1&(~(0x07<<4)))|(2<<4);  //TS2 3个时间单元
 104   2              break;
 105   2           
 106   2           default:
 107   2             
 108   2              break;
 109   2        }
 110   1        
 111   1        
 112   1        REG_CAN_ISR = 0x7F;       //清除中断标志
 113   1        
 114   1        REG_CAN_AMR0 = 0xFF;
 115   1        REG_CAN_AMR1 = 0xFF;
 116   1        REG_CAN_AMR2 = 0xFF;
