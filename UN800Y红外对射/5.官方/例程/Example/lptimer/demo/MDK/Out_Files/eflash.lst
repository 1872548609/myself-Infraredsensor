  61          void eflash_init(uint32_t system_clk_hz)  
  62          {       
  63   1              OPSET |= (0<<3);                                 //RD_WAIT = 0
  64   1          
  65   1          OUS = (system_clk_hz/2)-1;
  66   1              
  67   1              OINTUS = 0x3f;                                   //清除所有中断标志位
  68   1              OINTEN = 0x00;                                   //关闭所有中断功能
  69   1                      
  70   1      }
  71          
  72          
  73          void eflash_write_byte(uint16_t addr,uint8_t value)      
  74          {
  75   1              OPSET &= ~(7<<0);
  76   1              OPSET |= EFC_WRITE_MODE;                        //使能写模式
  77   1              
  78   1              OADR = addr;
  79   1              ODATA = value;
  80   1              OCTRL |= (0x1<<3);                                      //PUMP_SEL = 6.75v
  81   1              OCTRL |= (1<<6);                                        //PUMP_EN=1
  82   1              while(!(OCTRL & (1<<1)));                       //wait for PUMP OK;
  83   1              OCTRL |= (1<<7);                                        //VPPO_EN = 1
  84   1              while((OCTRL & (1<<7)));                        //wait for VPPO_EN = 0
  85   1              OCTRL &= ~(1<<6);                                       //PUMP_EN=0
  86   1      
  87   1              OPSET &= ~EFC_WRITE_MODE;                       //关闭写模式
  88   1              
  89   1      }
  90          
  91          void eflash_write_word(uint16_t addr,uint16_t value)     
  92          {
  93   1              uint8_t i;
  94   1              
  95   1              OPSET &= ~(7<<0);
  96   1              OPSET |= EFC_WRITE_MODE;                        //使能写模式
  97   1              
  98   1              for(i=0 ;i<2;i++)
  99   1              {
 100   2                      OADR = addr + i;
 101   2                      ODATA = value >> (i*8);
 102   2                      OCTRL |= (0x1<<3);                              //PUMP_SEL = 6.75v
 103   2                      OCTRL |= (1<<6);                                //PUMP_EN=1
 104   2                      while(!(OCTRL & (1<<1)));               //wait for PUMP OK
 105   2                      OCTRL |= (1<<7);                                //VPPO_EN = 1
 106   2                      while((OCTRL & (1<<7)));                //wait for VPPO_EN = 0
 107   2                      OCTRL &= ~(1<<6);                               //PUMP_EN=0
 108   2              }
 109   1              
 110   1              OPSET &= ~EFC_WRITE_MODE;                       //关闭写模式
 111   1      }
