 135          void lptim_timer_test(void)
 136          {
 137   1        //普通定时器
 138   1        lptimer_init(TIMER_TMODE, LPTIMER_LSCLK, DIV1);                 //普通定时器模式
 139   1        lptimer_irq_init(LPTIMER_IRQ_ENABLE,LPTIE_OV,lptim_ov_pro);    //计数器溢出中断设置
 140   1          lptimer_set_time(38000);                                        //定时1s     
 141   1          lptimer_start();                                                //定时启动
 142   1          printfS("lptimer timing start !!\r\n");   
 143   1        
 144   1        
 145   1      }
 146          void lptimer_trigger_test()
