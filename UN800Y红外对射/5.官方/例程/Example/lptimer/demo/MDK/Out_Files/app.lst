 199          /*******************************************************************
 200          * Function    : lptim_pwm_test
 201          * Description : lptim pwm 输出
 202          * Input     : none
 203          * Output    : none
 204          * Return    : none
 205          ********************************************************************/
 206          void lptim_pwm_test(void)
 207          {
 208   1          lptimer_pwm_init(LPTIMER_SYSCLK, DIV1);                                 //pwm输出初始化
 209   1      
 210   1      #ifdef PWM1
 211   1        /* pwm通道1 */
 212   1        printfS("lptimer PWM1 test start!!\r\n");
 213   1        lptimer_pwm_channel_config(PWM_CHANGE1, POLAR1);            //通道1使能
 214   1        //pwm频率 =时钟频率/16000 =1000hz, 占空比 50%
 215   1        lptimer_pwm_set(PWM_CHANGE1,16000,50);                  //通道1配置 
 216   1        lptimer_irq_init(LPTIMER_IRQ_ENABLE,LPTIE_COMP1,lptim_comp_pro);        //计数器匹配中断设置
 217   1        lptimer_io_config(LPOUT1);                                               //P0_3作为LPOUT1
 218   1      #endif  
 219   1        
 220   1      #ifdef PWM2 
                //pwm通道2
                printfS("lptimer PWM2 test start!!\r\n");
                lptimer_pwm_channel_config(PWM_CHANGE2, POLAR1);            //通道2使能
                //pwm频率 =时钟频率/8000 =2000hz, 占空比 30% 
                lptimer_pwm_set(PWM_CHANGE2,8000, 30);                  //通道2
                lptimer_irq_init(LPTIMER_IRQ_ENABLE,LPTIE_COMP2,lptim_comp_pro);        //计数器匹配中断设置 
                lptimer_io_config(LPOUT2);                                               //p04作为LPOUT2
              #endif
 229   1        
 230   1        lptimer_start();                                                        //定时启动 
 231   1        printfS("lptimer pwm test start !!\r\n"); 
 232   1        
 233   1      }
