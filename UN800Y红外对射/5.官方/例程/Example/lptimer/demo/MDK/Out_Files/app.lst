  55          /************************************************************************
  56           * Function     : my_memcpy
  57           * Description  : my_memcpy
  58           * Input    : uint8_t *dst  目的地址
  59           *          uint8_t *src  源地址
  60           *          uint16_t n   数据长度
  61           * Output     : none
  62           * Return   : none
  63           ************************************************************************/
  64          void my_memcpy(uint8_t *dst,uint8_t *src,uint16_t n)
  65          {
  66   1        while(n--)
  67   1        { 
  68   2          *dst++ = *src++;
  69   2        }
  70   1      }
