 151   1        lptimer_io_config(LPEXT);                         // P1_1作为EXTRIGGER_IO_IEN
 152   1        lptimer_irq_init(LPTIMER_IRQ_ENABLE,LPTIE_TRIG,lptim_trig_pro); //计数器溢出中断设置
