  12          void eflash_init(uint32_t system_clk_hz)  
  13          { 
  14   1        uint8_t system_clk_mhz;
  15   1        
  16   1        if(system_clk_hz < 2000000)
  17   1        {
  18   2          return;
  19   2        }
  20   1        
  21   1        system_clk_mhz = system_clk_hz/1000000;
  22   1        
  23   1        OPSET |= (0<<3);               //RD_WAIT = 0
  24   1          
  25   1        //OUS = (system_clk_mhz/2)-1;      //系统时钟频率(MHz)/2-1
  26   1          OUS = 0x0f; 
  27   1        OINTUS = 0x3f;                 //清除所有中断标志位
  28   1        OINTEN = 0x00;                 //关闭所有中断功能
  29   1          
  30   1      }
  31          
  32          void eflash_erase_page(uint16_t page_addr)  
  33          {
  34   1        OPSET &= ~(7<<0);
  35   1        OPSET |= EFC_PAGE_ERASE_MODE;     //开启page擦除模式
  36   1        
  37   1        OADR = page_addr;
  38   1        OCTRL |= (0x1<<3);          //PUMP_SEL = 6.75v
  39   1        OCTRL |= (1<<6);          //PUMP_EN=1
  40   1        while(!(OCTRL & (1<<1)));     //wait for PUMP OK
  41   1        OCTRL |= (1<<7);          //VPPO_EN = 1
  42   1        while((OCTRL & (1<<7)));      //wait for VPPO_EN = 0
  43   1        OCTRL &= ~(1<<6);         //PUMP_EN=0
  44   1        
  45   1        OPSET &= ~EFC_PAGE_ERASE_MODE;    //关闭page擦除模式
  46   1      }
  47          
  48          void eflash_write_byte(uint16_t addr,uint8_t value)  
  49          {
  50   1        OPSET &= ~(7<<0);
  51   1        OPSET |= EFC_WRITE_MODE;      //使能写模式
  52   1        
  53   1        OADR = addr;
C51 COMPILER V9.60.0.0   EFLASH                                                            04/26/2022 18:18:02 PAGE 2   

  54   1        ODATA = value;
