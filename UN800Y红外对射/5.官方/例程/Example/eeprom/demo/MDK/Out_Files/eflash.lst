  56   1        OCTRL |= (1<<6);          //PUMP_EN=1
  57   1        while(!(OCTRL & (1<<1)));     //wait for PUMP OK;
  58   1        OCTRL |= (1<<7);          //VPPO_EN = 1
  59   1        while((OCTRL & (1<<7)));      //wait for VPPO_EN = 0
  60   1        OCTRL &= ~(1<<6);         //PUMP_EN=0
  61   1      
  62   1        OPSET &= ~EFC_WRITE_MODE;     //关闭写模式
  63   1        
  64   1      }
  65          
  66          void eflash_write_bytes(uint16_t addr, uint8_t *buff, uint32_t length)   
  67          { 
  68   1        OPSET &= ~(7<<0);
  69   1        OPSET |= EFC_WRITE_MODE;      //使能写模式
  70   1          
  71   1          while(length--)
  72   1          {
  73   2              OADR = addr++;
  74   2              ODATA = *buff++;
  75   2              OCTRL |= (0x1<<3);        //PUMP_SEL = 6.75v
  76   2              OCTRL |= (1<<6);        //PUMP_EN=1
  77   2              while(!(OCTRL & (1<<1)));     //wait for PUMP OK;
  78   2              OCTRL |= (1<<7);        //VPPO_EN = 1
  79   2              while((OCTRL & (1<<7)));      //wait for VPPO_EN = 0
  80   2              OCTRL &= ~(1<<6);       //PUMP_EN=0     
  81   2          }
  82   1      
  83   1        OPSET &= ~EFC_WRITE_MODE;     //关闭写模式
  84   1      }
