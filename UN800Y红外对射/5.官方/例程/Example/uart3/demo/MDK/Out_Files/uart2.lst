 125          /************************************************************************
 126           * Function     : uart2_send_byte
 127           * Description  : uart2 发送一个字节数据
 128           * Input    : char c: out byte
 129           * Output   : none  
 130           * Return   : none
 131           ************************************************************************/
 132          void uart2_send_byte(char c)
 133          {
 134   1        //输出一个字符
 135   1        uint16_t timeout;
 136   1        timeout = 65535;
 137   1        
 138   1        REG_UART2_TDR = c;
 139   1      
 140   1      #ifdef UART2_TX_INT_MODE                    //中断方式
                while(!uart2_tx_flag);    
                uart2_tx_flag = 0;    
              #else                           //查询方式
 144   1        while((REG_UART2_ISR & 0x02) != 0x02)         //等待数据发送完成
 145   1        {   
 146   2          if((timeout--)==0)                //超时等待退出
 147   2          {   
 148   3            break;    
 149   3          }   
 150   2        }   
 151   1        REG_UART2_ISR &= ~(1<<1);               //清除发送完成标志位
 152   1      
 153   1      #endif
 154   1      }
 155          
 156          /************************************************************************
 157           * Function     : uart2_send_bytes
 158           * Description  : uart2 send bytes  发送多个字节
 159           * Input    : uint8_t* buff: out buffer
 160           *            uint32_t length: buffer length
 161           * Output   : none  
 162           * Return   : none
 163           ************************************************************************/
 164          void uart2_send_bytes(uint8_t *buff, uint32_t length)
 165          {
 166   1        while(length--)
 167   1        {
 168   2          uart2_send_byte(*buff++);
 169   2        } 
 170   1      }
