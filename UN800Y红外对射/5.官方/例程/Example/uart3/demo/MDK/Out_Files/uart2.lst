  50          /************************************************************************
  51           * Function     : uart2_set_baud_rate
  52           * Description  : uart2 set baud rate
  53           * Input    : uint32_t clk_hz: cpu frequency
C51 COMPILER V9.60.0.0   UART2                                                             01/12/2022 15:19:30 PAGE 2   

  54           *              uint32_t baud_rate: Series rate                 
  55           * Output   : none  
  56           * Return   : none
  57           ************************************************************************/
  58          static void uart2_set_baud_rate(uint32_t clk_hz, uint32_t baud_rate)  
  59          { 
  60   1        uint16_t temp;
  61   1        uint8_t MSbyte, LSbyte;
  62   1          
  63   1        temp = clk_hz / baud_rate;
  64   1        
  65   1        MSbyte = temp>>8;
  66   1        LSbyte = temp;
  67   1        
  68   1        REG_UART2_BRPH = MSbyte;
  69   1        REG_UART2_BRPL = LSbyte+1;    
  70   1      }
  71          
  72          /************************************************************************
  73           * Function     : uart2_init
  74           * Description  : uart2 initial for  baud_rate
  75           * Input    : uint32_t baud_rate: Series rate 
  76           * Output   : none
  77           * Return   : none
  78           ************************************************************************/
  79          void uart2_init(uint32_t baud_rate)
  80          {
  81   1        uint32_t uart_clk_hz;
  82   1        uart_clk_hz = FCLK;   
  83   1            
  84   1        PCLK1 |= (1<<7);                  //开UART2时钟使能 
  85   1        PRESET1 |= (1<<7);                //UART2正常工作
  86   1        
  87   1        REG_P00_CFG = 0x1;                //P00复用为UART2_RX
  88   1        REG_P01_CFG = 0x1;                //P01复用为UART2_TX
  89   1        
  90   1        REG_UART2_CR |= (1<<3);           //无奇偶校验
  91   1        REG_UART2_CR |= (1<<1);           //发送数据使能  
  92   1      
  93   1        uart2_set_baud_rate(uart_clk_hz,baud_rate);     //设置波特率
  94   1      }
