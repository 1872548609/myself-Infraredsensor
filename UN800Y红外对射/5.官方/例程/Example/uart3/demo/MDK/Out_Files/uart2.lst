  96          /************************************************************************
  97           * Function     : uart2_irq_init
  98           * Description  : uart2 interrupt enable
  99           * Input    : uint8_t irqstate: 0 中断失能，1 中断使能
 100           *            *pfunc_recv)(): 接收处理回调函数
 101           * Output   : none
 102           * Return   : none
 103           ************************************************************************/
 104          void uart2_irq_init(uint8_t irqstate,void (*pfunc_recv)())
 105          {
 106   1        if(irqstate == UART2_IRQ_ENABLE)
 107   1        {
 108   2          EA = 1;                   //打开总中断开关
 109   2          UART2INTEN = 1;           //使能UART2中断
 110   2          
 111   2      #ifdef UART2_TX_INT_MODE      //发送采用中断方式
                  REG_UART2_IER = 0x22;     //接收FIFO非空中断使能，发送完成中断使能,enable Rx/Tx_INT,disable else int
              #else                         //发送采用查询方式
 114   2          REG_UART2_IER = 0x20;                 //接收FIFO非空中断使能，发送完成中断不使能,enable Rx_INT,disable Tx_IN
             -T and else int    
C51 COMPILER V9.60.0.0   UART2                                                             01/12/2022 15:19:30 PAGE 3   

 115   2      #endif  
 116   2          uart2_func = pfunc_recv;  //接收中断回调函数
 117   2        }
 118   1        else
 119   1        {
 120   2          UART2INTEN = 0;           //关闭UART2中断
 121   2        }
 122   1          
 123   1      }
