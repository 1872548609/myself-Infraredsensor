  16          /************************************************************************
  17           * Function     : UART2_IRQHandler
  18           * Description  : uart2 interrupt handling
  19           * Input    : none
  20           * Output   : none   
  21           * Return   : none
  22           ************************************************************************/
  23          void UART2_IRQHandler(void) interrupt 16
  24          {
  25   1        if(REG_UART2_ISR & 0x20)                      //FIFO非空中断
  26   1        {
  27   2          if(uart2_func != NULL)
  28   2          {
  29   3            ((void(*)())(uart2_func))();            //uart2的接收处理回调函数
  30   3            REG_UART2_ISR &= ~(1<<5);             //清除FIFO_NE非空标志位
  31   3          }
  32   2        } 
  33   1      #ifdef UART2_TX_INT_MODE      
                else if(REG_UART2_ISR & 0x02)             //发送完成中断
                {
                  if(!(REG_UART2_ISR & (1<<1)))
                  {
                    uart2_tx_flag = 1;
                    REG_UART2_ISR &= ~(1<<1);             //清除发送完成标志位
                  }
                } 
              #endif
  43   1        else
  44   1        {
  45   2          REG_UART2_ISR = 0x00;                 //清除中断状态
  46   2        }
  47   1      
  48   1      }
