 367          /************************************************************************
 368          * Function    : i2c_master_read_data
 369          * Description : i2c_master_read_data
 370          * Input     : uint8_t slave_addr: 设备地址
 371          *             uint8_t* buffer: 要接收的数据
 372          *             uint16_t len: 数据传输长度
 373          * Output    : none  
 374          * Return    : 1：fail 0:success
 375          ************************************************************************/
 376          uint8_t i2c_master_read_data(uint8_t slave_addr, uint8_t *buffer, uint16_t len)
 377          {
 378   1        i2c_write_addr(slave_addr|0x01);        //设备地址+R
 379   1        i2c_start();                  //发送起始信号
 380   1        while(1)
 381   1        {
 382   2          if(i2c_wait_ack())
 383   2          {
 384   3            i2c_write_addr(slave_addr|0x01);    //设备地址+R
 385   3            REG_I2C_CR0 |= MSTA;          //重新发送start 
 386   3          }
 387   2          else
 388   2          {
 389   3            break;
 390   3          }
 391   2        }
 392   1      
 393   1        while(len--)
 394   1        {
 395   2          if(len == 0)          //最后一个字节发送完后发送停止位
 396   2          {
 397   3            i2c_stop();         //TACK,传输应答位/STOP条件  
 398   3          }
 399   2          *buffer++ = i2c_read_byte();  //I2C_CR0_TACK = 0;默认接收完数据自动Ack
 400   2        }
 401   1        
 402   1        while((REG_I2C_SR0 & MBB));     //等待总线数据释放
 403   1        
 404   1        return 0;
 405   1      
 406   1      }
