 333          /************************************************************************
 334          * Function    : i2c_master_write_data
 335          * Description : i2c_master_write_data
 336          * Input       : uint8_t slave_addr: 从机地址
 337          *               uint8_t *buffer: 要发送的数据
 338          *               uint16_t len： 数据传输长度
 339          * Output      : none  
 340          * Return      : 1：fail 0:success
 341          ************************************************************************/
 342          uint8_t i2c_master_write_data(uint8_t slave_addr, uint8_t *buffer, uint16_t len)
 343          { 
 344   1        i2c_write_addr(slave_addr);     //设备地址+W
 345   1        i2c_start();            //发送起始信号(先写DR再使能start信号的原因是,start开始后会立马发DR的数据出去)
 346   1        if(i2c_wait_ack() != 0)
 347   1        {
 348   2          i2c_stop();
 349   2          return 1;
 350   2        }
 351   1        
 352   1        while(len--)                
 353   1        {   
 354   2          i2c_write_byte(*buffer++);
 355   2          if(len == 0)          //最后一个字节发送完后发送停止位
 356   2          {
 357   3            i2c_stop();         //TACK,传输应答位/STOP条件
 358   3          }
 359   2        }
 360   1        while((REG_I2C_SR0 & MBB));     //等待总线数据释放
 361   1          
 362   1        return 0;
 363   1        
 364   1                    
C51 COMPILER V9.60.0.0   I2C                                                               04/24/2022 14:27:27 PAGE 7   

 365   1      }
