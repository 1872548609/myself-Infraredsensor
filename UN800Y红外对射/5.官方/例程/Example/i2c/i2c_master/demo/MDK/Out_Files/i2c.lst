  72          /************************************************************************
  73           * Function     : i2c_master_init
  74           * Description  : i2c_master_init I2C主机初始化
  75           * Input        : uint32_t i2c_speed  I2C速率 = (fSYSCLK)/(4*(CLK_DIV+1))
  76           * Output       : none  
  77           * Return       : none   
  78           ************************************************************************/
  79          void i2c_master_init(uint32_t i2c_speed)
  80          {
  81   1        PCLK0 |= (1<<7);              //打开I2C模块时钟
  82   1        PRESET0 |= (1<<7);            //释放I2C复位
  83   1                  
  84   1        P0PU &= ~(1<<4);              //P04上拉
  85   1        P1PU &= ~(1<<0);              //P10上拉
  86   1        
  87   1        REG_P04_CFG = 0x03;           //I2C_SDA     
  88   1        REG_P10_CFG = 0x04;           //I2C_SCL 
  89   1        
  90   1        
  91   1        REG_I2C_CLK_DIV = 16000000 / (4 * i2c_speed) - 1;   //I2C速率 = (fSYSCLK)/(4*(CLK_DIV+1))
  92   1        REG_I2C_CR1 |= (1<<5);        //使能开漏模式
  93   1        REG_I2C_CR0 |= MEN;           //I2C使能   
  94   1      }
