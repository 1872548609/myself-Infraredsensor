 216          uint8_t i2c_read_byte(void)
 217          {
 218   1        uint8_t byte;
 219   1        
 220   1        REG_I2C_CR0 &= ~MTX;          //作为接收器
 221   1        
 222   1        while(!(REG_I2C_SR1 & RXNE));       //等待接收数据寄存器非空
 223   1      
