 331          /************************************************************************
 332          * Function    : i2c_slave_read
 333          * Description : i2c_slave_read
 334          * Input       : uint8_t *rxdata: 要接收的数据
 335          * Output      : none  
 336          * Return      : datalen 数据传输长度
 337          ************************************************************************/
 338          uint8_t i2c_slave_read(uint8_t *rxdata)
 339          {
 340   1        uint8_t datalen;
 341   1        
 342   1        datalen = 0;
 343   1        
 344   1        while((REG_I2C_SR0 & MBB)) //MBB
 345   1        {
 346   2          if((REG_I2C_SR1 & RXNE) == RXNE) //接收时数据寄存器非空
 347   2          { 
 348   3            rxdata[datalen] = i2c_read_byte();
 349   3            datalen++;
 350   3          }
 351   2        }
 352   1        REG_I2C_SR0 = MTF;
 353   1      
 354   1        return datalen;
 355   1      } 
