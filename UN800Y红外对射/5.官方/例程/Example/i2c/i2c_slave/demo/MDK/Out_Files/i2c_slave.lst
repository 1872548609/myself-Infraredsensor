 285          void i2c_slave_init(void)
 286          {
 287   1        PCLK0 |= (1<<7);              //打开I2C模块时钟
 288   1        PRESET0 |= (1<<7);            //释放I2C复位
 289   1              
 290   1        P0PU &= ~(1<<4);              //P04上拉
 291   1        P1PU &= ~(1<<0);              //P10上拉
 292   1        
 293   1        REG_P04_CFG = 0x03;           //I2C_SDA     
 294   1        REG_P10_CFG = 0x04;           //I2C_SCL 
 295   1        
 296   1        REG_I2C_CR1 |= (1<<5);        //使能开漏模式    
 297   1        REG_I2C_SR0 |= MTF;           //清除传输完成状态位
 298   1        REG_I2C_CR1 |= MTX_ANTO_EN;   //SLAVE模式下自动切换SDA传输方向
 299   1      
 300   1        REG_I2C_CR0 |= (1<<1);        //hold_en使能
 301   1        REG_I2C_CR0 |= MEN;           //I2C使能
