 120          /************************************************************************
 121           * Function     : uart0_send_byte
 122           * Description  : uart0 发送一个字节数据
 123           * Input    : char c: out byte
 124           * Output   : none  
 125           * Return   : none
 126           ************************************************************************/
 127          void uart0_send_byte(char c)
 128          {
 129   1        //输出一个字符
 130   1        uint16_t timeout;
 131   1        timeout = 65535;
 132   1        
 133   1        S0BUF = c;
 134   1      
 135   1      #ifdef UART0_TX_INT_MODE          //中断方式
                while(!tx_flag);
                tx_flag = 0; 
              #else 
 139   1        //查询方式
 140   1          while(!(TI0))                 //等待数据发送完成
 141   1        {
 142   2          if((timeout--) == 0)        //超时等待退出
 143   2              {
 144   3            break;
 145   3              }
 146   2        }
 147   1        TI0 = 0;                      //清除发送完成标志位
 148   1      #endif
 149   1      }
