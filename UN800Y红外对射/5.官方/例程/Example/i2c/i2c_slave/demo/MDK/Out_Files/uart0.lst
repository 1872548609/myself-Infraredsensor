  51           ************************************************************************/
  52          static void uart0_set_baud_rate(uint32_t clk_hz, uint32_t baud_rate)  
C51 COMPILER V9.60.0.0   UART0                                                             07/13/2022 13:34:25 PAGE 2   

  53          { 
  54   1        uint32_t temp;
  55   1        uint8_t MSbyte, LSbyte;
  56   1          
  57   1        temp = baud_rate * 16;
  58   1          temp = (clk_hz + (temp / 2))/ temp;
  59   1        temp = 1024 - temp ;
  60   1        
  61   1        MSbyte = temp>>8;
  62   1        LSbyte = temp;
  63   1        
  64   1        S0RELH = MSbyte & 0x3;
  65   1        S0RELL = LSbyte;    
  66   1      }
