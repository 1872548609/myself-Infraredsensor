  68          /************************************************************************
  69           * Function     : uart0_init
  70           * Description  : uart0 initial for  baud_rate
  71           * Input    : uint32_t baud_rate: Series rate 
  72           * Output   : none
  73           * Return   : none
  74           ************************************************************************/
  75          void uart0_init(uint32_t baud_rate)
  76          {
  77   1        
  78   1        PCLK0 |= (1<<0);                         //开UART0时钟使能  
  79   1        PRESET0 |= (1<<0);                       //UART0正常工作
  80   1        EUARTEN |= (1<<0);                       //打开EUART0功能，P2.6作UART0_TX，P2.7作UART0_RX
  81   1      
  82   1        tx_flag = 0;
  83   1          
  84   1        SM0 = 0;
  85   1        SM1 = 1;                                              //选择模式一
  86   1                      
  87   1        TI0 = 0;                                                  //发送完成中断状态清除
  88   1        RI0 = 0;                                                //接收完成中断状态清除
  89   1        
  90   1        uart0_set_baud_rate(system_core_clock, baud_rate);        //设置波特率
  91   1        REN0 = 1;                                                 //使能接收    
  92   1        
  93   1        P2PU &= ~(3<<6);                        //使能P2.6,P2.7内部上拉  
  94   1      }
