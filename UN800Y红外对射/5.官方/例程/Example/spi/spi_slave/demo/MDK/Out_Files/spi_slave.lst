 244          //全双工
 245          uint8_t spi0_master_full_duplex_tranfer(uint8_t *send_buff, uint8_t *rec_buff, uint32_t length)
 246          {
 247   1        while(length--)
 248   1        {
 249   2          while(!(REG_SPI_SPSR & (1<<SPI_TXE_IF)));   //等待发送缓存为空
 250   2          
 251   2          REG_SPI_TXBUF = *send_buff++;
 252   2          
 253   2          while(!(REG_SPI_SPSR & (1<<SPI_RXF_IF)));       //等待接收缓存非空，RXBF事件    
 254   2          
 255   2          *rec_buff++ = REG_SPI_RXBUF;
 256   2        }
 257   1        
 258   1        return 0;
 259   1      }
 260          
 261          
 262          //半双工传输
 263          uint8_t spi_master_half_duplex_send_bytes(uint8_t *buff, uint32_t length)
 264          {
 265   1        REG_SPI_SPCR3 |= (1<<3);          //txonly
 266   1        while(length--)
 267   1        {
 268   2          while(!(REG_SPI_SPSR & (1<<SPI_TXE_IF)));   //等待发送缓存为空
 269   2        
 270   2          REG_SPI_TXBUF = *buff++;
 271   2        }
 272   1        while((REG_SPI_SPSR & (1<<SPI_BUSY_IF)));       //等待BUSY=0
 273   1        
 274   1        REG_SPI_SPCR3 &= ~(1<<3);               //关闭txonly
 275   1        
 276   1        return 0;
 277   1      }
 278           
 279          uint8_t  spi_master_half_duplex_receive_bytes(uint8_t *buff, uint32_t length)
 280          {
 281   1        uint32_t time_out = 0xFFFFFFFF;
 282   1        while(length--)
 283   1        {
 284   2          while(!(REG_SPI_SPSR & (1<<SPI_RXF_IF)))  //等待接收缓存非空
 285   2          {
 286   3            if((time_out--) == 0) 
 287   3            {
 288   4              return 1;
 289   4            }
 290   3          }
 291   2          *buff++ = REG_SPI_RXBUF;
 292   2        }
 293   1      
 294   1          return 0;
 295   1      
 296   1      }
