 146           * Output   : none   
 147           * Return   : none
 148           ************************************************************************/
 149          void spi_irq_init(uint8_t irq_enable, uint8_t spi_irq_type,void (*pfunc)())
 150          {
 151   1        if(irq_enable == SPI_IRQ_ENABLE)
 152   1        {
 153   2          switch(spi_irq_type)
 154   2          {
 155   3            case SPI_RXNE_IE:
 156   3              REG_SPI_SPIIE |= (1<<SPI_RXNE_IE);      //SPI错误中断使能
 157   3              break;
 158   3            case SPI_TXE_IE:
 159   3              REG_SPI_SPIIE |= (1<<SPI_TXE_IE);     //SPI TXBUF空中断使能
 160   3              break;
 161   3            case SPI_ERROR_IE:
 162   3              REG_SPI_SPIIE |= (1<<SPI_ERROR_IE);     //SPI RXBUF非空中断使能
 163   3              break;
 164   3            default:
 165   3              break;
 166   3          }
 167   2          
 168   2        spi_func = pfunc;                 //SPI中断回调函数
 169   2        SPIINTEN = 1;                   //使能SPI中断
 170   2        EA = 1;                       //使能总中断
 171   2        }
 172   1        else
 173   1        {
 174   2          REG_SPI_SPIIE = 0x00;
 175   2          
 176   2          spi_func = NULL;
 177   2          SPIINTEN = 0;                   //关闭SPI中断
