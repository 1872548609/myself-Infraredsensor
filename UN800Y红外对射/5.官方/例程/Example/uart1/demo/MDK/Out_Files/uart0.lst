 103           ************************************************************************/
 104          void uart0_irq_init(uint8_t irqstate,void (*pfunc_recv)())
 105          {
 106   1          if(irqstate == UART0_IRQ_ENABLE)
 107   1          {
 108   2              EA = 1;                                         //EA总中断开启
 109   2              ES0 = 1;                                        //UART0中断使能   
 110   2              
 111   2              uart0_func = pfunc_recv;       
 112   2          } 
 113   1          else
 114   1          {
 115   2      //      EA = 0;                                         //EA总中断关闭
