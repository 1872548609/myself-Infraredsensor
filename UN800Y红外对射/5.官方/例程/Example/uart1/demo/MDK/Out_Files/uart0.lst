  43          /************************************************************************
  44           * Function     : uart0_set_baud_rate
  45           * Description  : uart0 set baud rate
  46           * Input                : uint32_t clk_hz: cpu frequency
  47           *                        uint32_t baud_rate: Series rate         Baud Rate = SYSCK/(16*(1024-S0REL))   SYSCK:RC16M                             
             -                
  48           * Output               : none  
  49           * Return               : none
  50           ************************************************************************/
  51          static void uart0_set_baud_rate(uint32_t clk_hz, uint32_t baud_rate)    
  52          {       
  53   1              uint32_t temp;
C51 COMPILER V9.60.0.0   UART0                                                             01/12/2022 14:46:16 PAGE 2   

  54   1              uint8_t MSbyte, LSbyte;
  55   1          
  56   1              temp = baud_rate * 16;
  57   1          temp = (clk_hz + (temp / 2))/ temp;
  58   1              temp = 1024 - temp ;
  59   1        
  60   1              MSbyte = temp>>8;
  61   1              LSbyte = temp;
  62   1              
  63   1              S0RELH = MSbyte & 0x3;
  64   1              S0RELL = LSbyte;                
  65   1      }
  66          
  67          /************************************************************************
  68           * Function     : uart0_init
  69           * Description  : uart0 initial for  baud_rate
  70           * Input                : uint32_t baud_rate: Series rate 
  71           * Output               : none
  72           * Return               : none
  73           ************************************************************************/
  74          void uart0_init(uint32_t baud_rate)
  75          {
  76   1              uint32_t uart_clk_hz;
  77   1              uart_clk_hz = FCLK;             
  78   1              
  79   1              PCLK0 |= (1<<0);                                                                               //开UART0时钟使能        
  80   1              PRESET0 |= (1<<0);                                                                                 //UART0正常工作
  81   1              EUARTEN |= (1<<0);                                                                                 //打开EUART0功能，P2.6作UART0_TX，P2.7作UART0_RX
  82   1      
  83   1          tx_flag = 0;
  84   1          
  85   1              SM0 = 0;
  86   1              SM1 = 1;                                                          //选择模式一
  87   1                      
  88   1              TI0 = 0;                                                  //发送完成中断状态清除
  89   1              RI0 = 0;                                                      //接收完成中断状态清除
  90   1              
  91   1              uart0_set_baud_rate(uart_clk_hz, baud_rate);              //设置波特率
  92   1              REN0 = 1;                                                 //使能接收    
  93   1          
  94   1      }
