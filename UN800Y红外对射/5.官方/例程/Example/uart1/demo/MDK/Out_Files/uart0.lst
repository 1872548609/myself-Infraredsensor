 151          /************************************************************************
 152           * Function     : uart0_send_bytes
 153           * Description  : uart0 send bytes      发送多个字节
 154           * Input                : uint8_t* buff: out buffer
 155           *                        uint32_t length: buffer length
 156           * Output               : none  
 157           * Return               : none
 158           ************************************************************************/
 159          void uart0_send_bytes(uint8_t *buff, uint32_t length)
 160          {
 161   1              while(length--)
 162   1              {
 163   2                      uart0_send_byte(*buff++);
 164   2              }       
 165   1      }
