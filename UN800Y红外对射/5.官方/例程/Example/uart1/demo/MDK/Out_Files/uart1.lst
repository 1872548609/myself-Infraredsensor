 152          /************************************************************************
 153           * Function     : uart1_send_bytes
 154           * Description  : uart1 send bytes  发送多个字节
 155           * Input    : uint8_t* buff: out buffer
 156           *            uint32_t length: buffer length
 157           * Output   : none  
 158           * Return   : none
 159           ************************************************************************/
 160          void uart1_send_bytes(uint8_t *buff, uint32_t length)
 161          {
 162   1        while(length--)
 163   1        {
 164   2          uart1_send_byte(*buff++);
 165   2        } 
 166   1      }
