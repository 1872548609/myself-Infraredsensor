 120          /************************************************************************
 121           * Function     : uart1_send_byte
 122           * Description  : uart1 发送一个字节数据
 123           * Input    : char c: out byte
 124           * Output   : none  
 125           * Return   : none
 126           ************************************************************************/
 127          void uart1_send_byte(char c)
 128          {
 129   1        //输出一个字符
 130   1        uint16_t timeout;
 131   1        timeout = 65535;
 132   1          
 133   1        S1BUF = c;
 134   1      
 135   1      #ifdef UART1_TX_INT_MODE                //中断方式
                while(!tx_flag);
                tx_flag = 0;  
              #else 
 139   1        //查询方式
 140   1          while(((S1CON&0x2)!=0x2))               //等待数据发送完成
 141   1          {
 142   2              if((timeout--)==0)                  //超时等待退出
 143   2              {
 144   3            break;
 145   3              }
 146   2          }
 147   1          S1CON &= ~(0x1<<1);                     //清除发送完成标志位
 148   1      
 149   1      #endif
 150   1      }
