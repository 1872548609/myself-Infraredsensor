  45          /************************************************************************
  46           * Function     : uart1_set_baud_rate
  47           * Description  : uart1 set baud rate
  48           * Input    : uint32_t clk_hz: cpu frequency
  49           *              uint32_t baud_rate: Series rate   Baud Rate = SYSCK/(16*(1024-S1REL))   SYSCK:RC16M           
             -    
  50           * Output   : none  
  51           * Return   : none
  52           ************************************************************************/
C51 COMPILER V9.60.0.0   UART1                                                             07/12/2022 18:20:16 PAGE 2   

  53          static void uart1_set_baud_rate(uint32_t clk_hz, uint32_t baud_rate)  
  54          { 
  55   1        uint32_t temp;
  56   1        uint8_t MSbyte, LSbyte;
  57   1          
  58   1          temp = baud_rate * 16;
  59   1          temp = (clk_hz + (temp / 2))/ temp;
  60   1        temp = 1024 - temp ;
  61   1      
  62   1        MSbyte = temp>>8;
  63   1        LSbyte = temp;
  64   1        
  65   1        S1RELH = MSbyte & 0x3;
  66   1        S1RELL = LSbyte;      
  67   1      }
  68          
  69          /************************************************************************
  70           * Function     : uart1_init
  71           * Description  : uart1 initial for  baud_rate
  72           * Input    : uint32_t baud_rate: Series rate 
  73           * Output   : none
  74           * Return   : none
  75           ************************************************************************/
  76          void uart1_init(uint32_t baud_rate)
  77          {
  78   1      
  79   1        PCLK0 |= (1<<1);                      //开UART1时钟使能 
  80   1        PRESET0 |= (1<<1);                    //UART1正常工作
  81   1        EUARTEN |= (1<<1);                    //打开EUART1功能，P1.5作UART1_TX，P1.4作UART1_RX
  82   1      
  83   1        tx_flag = 0;
  84   1          
  85   1        S1CON |= (0x1<<7);                    //选择mode B 8位通信
  86   1                    
  87   1        S1CON &= ~(0x1<<1);                 //发送完成中断状态清除
  88   1        S1CON &= ~(0x1<<0);                 //接收完成中断状态清除
  89   1        
  90   1        uart1_set_baud_rate(system_core_clock, baud_rate);    //设置波特率
  91   1        S1CON |= (0x1<<4);                    //使能接收
  92   1        
  93   1        P1PU &= ~(3<<4);                      //使能P1.5,P1.4内部上拉 
  94   1      }
  95          
  96          /************************************************************************
  97           * Function     : uart1_irq_init
  98           * Description  : uart1 interrupt enable
  99           * Input    : uint8_t irqstate: 0 中断失能，1 中断使能
 100           *            *pfunc_recv)(): 接收处理回调函数
 101           * Output   : none
 102           * Return   : none
 103           ************************************************************************/
 104          void uart1_irq_init(uint8_t irqstate,void (*pfunc_recv)())
 105          {
 106   1          if(irqstate == UART1_IRQ_ENABLE)
 107   1          {
 108   2              EA = 1;                     //EA总中断开启
 109   2              ES1 = 1;                    //UART1中断使能   
 110   2              
 111   2              uart1_func = pfunc_recv;       
 112   2          } 
 113   1          else
 114   1          {
