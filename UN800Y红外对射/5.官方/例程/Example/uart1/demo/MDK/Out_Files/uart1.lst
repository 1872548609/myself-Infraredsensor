  17          /************************************************************************
  18           * Function     : UART1_IRQHandler
  19           * Description  : uart interrupt handling
  20           * Input    : none
  21           * Output   : none   
  22           * Return   : none
  23           ************************************************************************/
  24          void UART1_IRQHandler(void) interrupt 2
  25          {
  26   1      
  27   1        if((S1CON&0x1) == 0x1)            //Rx int
  28   1        { 
  29   2          if(uart1_func != NULL)
  30   2          {
  31   3            ((void(*)())(uart1_func))();      //uart1的接收处理回调函数
  32   3          }
  33   2          S1CON &= ~(0x1<<0);             //清除接收完成标志位
  34   2        } 
  35   1        
  36   1      #ifdef UART1_TX_INT_MODE            //中断方式
                else if((S1CON&0x2) == 0x2)           // Tx int
                {
                  tx_flag = 1;
                  S1CON &= ~(0x1<<1);             //清除发送完成标志位
                } 
              #endif    
  43   1      }
