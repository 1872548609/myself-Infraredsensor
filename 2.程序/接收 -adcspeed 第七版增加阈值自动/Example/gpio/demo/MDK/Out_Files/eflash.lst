  15          void eflash_init(uint32_t system_clk_hz)  
  16          {       
  17   1              uint8_t system_clk_mhz;
  18   1              
  19   1              if(system_clk_hz < 2000000)
  20   1              {
  21   2                      return;
  22   2              }
  23   1              
  24   1              system_clk_mhz = system_clk_hz/1000000;
  25   1              
  26   1              OPSET |= (0<<3);                                 //RD_WAIT = 0
  27   1          
  28   1              //OUS = (system_clk_mhz/2)-1;                    //系统时钟频率(MHz)/2-1
  29   1          OUS = 0x0f; 
  30   1              OINTUS = 0x3f;                                   //清除所有中断标志位
  31   1              OINTEN = 0x00;                                   //关闭所有中断功能
  32   1                      
  33   1      }
