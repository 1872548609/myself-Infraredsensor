  35          void eflash_erase_page(uint16_t page_addr)      
  36          {
  37   1          bit temp;
  38   1          temp = EA;    
  39   1          EA = 0;                             //关闭总中断
  40   1          
  41   1              OPSET &= ~(7<<0);
  42   1              OPSET |= EFC_PAGE_ERASE_MODE;           //开启page擦除模式
  43   1              
  44   1              OADR = page_addr;
  45   1              OCTRL |= (0x1<<3);                                      //PUMP_SEL = 6.75v
  46   1              OCTRL |= (1<<6);                                        //PUMP_EN=1
  47   1              while(!(OCTRL & (1<<1)));                       //wait for PUMP OK
  48   1              OCTRL |= (1<<7);                                        //VPPO_EN = 1
  49   1              while((OCTRL & (1<<7)));                        //wait for VPPO_EN = 0
  50   1              OCTRL &= ~(1<<6);                                       //PUMP_EN=0
  51   1              
  52   1              OPSET &= ~EFC_PAGE_ERASE_MODE;          //关闭page擦除模式
  53   1          
