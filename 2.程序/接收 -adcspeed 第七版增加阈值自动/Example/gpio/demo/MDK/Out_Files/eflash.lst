  80          
  81          void eflash_write_bytes(uint16_t addr, uint8_t *buff, uint32_t length)   
  82          {     
  83   1          bit temp;
  84   1          temp = EA;    
  85   1          EA = 0;                             //关闭总中断
  86   1          
  87   1              OPSET &= ~(7<<0);
  88   1              OPSET |= EFC_WRITE_MODE;                        //使能写模式
  89   1          
  90   1          while(length--)
  91   1          {
  92   2              OADR = addr++;
  93   2              ODATA = *buff++;
  94   2              OCTRL |= (0x1<<3);                              //PUMP_SEL = 6.75v
  95   2              OCTRL |= (1<<6);                                //PUMP_EN=1
  96   2              while(!(OCTRL & (1<<1)));           //wait for PUMP OK;
  97   2              OCTRL |= (1<<7);                                //VPPO_EN = 1
  98   2              while((OCTRL & (1<<7)));            //wait for VPPO_EN = 0
  99   2              OCTRL &= ~(1<<6);                               //PUMP_EN=0     
 100   2          }
 101   1      
 102   1              OPSET &= ~EFC_WRITE_MODE;                       //关闭写模式
 103   1            
 104   1          EA = temp;                          //恢复中断源状态
 105   1      }
