  11          #include "system_um800y.h"
  12          #include "config.h"
  13          
  14          volatile uint32_t system_core_clock = 0;                        //core时钟 , (uint:Hz)
  15          volatile uint32_t xdata rch24m = 0;
  16          
  17          /************************************************************************
  18           * Function     : clock_init
  19           * Description  : clock init, initil several clock variables
  20           * Input                : uint32_t system_clk_hz
  21           * Output               : none
  22           * Return               : none
  23           ************************************************************************/
  24          
  25          
  26          void clock_init(uint32_t system_clk_hz)
  27          {       
  28   1              uint32_t crystal_clk = 0;    
  29   1              CLKCON |= (0x1<<2);                        //RCH时钟源打开
  30   1              while((CLKCON&0x20) != 0x20);  //等待RC16M时钟稳定
  31   1      
  32   1      
  33   1              rch24m = ((uint32_t)(*(volatile uint8_t xdata*)(0x91AB))<<24) |  \
  34   1                           ((uint32_t)(*(volatile uint8_t xdata*)(0x91AA))<<16) |  \
  35   1                               ((uint32_t)(*(volatile uint8_t xdata*)(0x91A9))<<8)  |  \
  36   1                                (uint32_t)(*(volatile uint8_t xdata*)(0x91A8));   
  37   1                              
  38   1              if ((rch24m <= 24120000) && (rch24m >= 23880000))    //实际值如果是24M的-+0.5%以内
  39   1          {
  40   2              crystal_clk = 24000000*2;      
  41   2          }
  42   1              else if(rch24m == 0xFFFFFFFF)
  43   1              {
  44   2                      crystal_clk = 24000000*2;
  45   2              }
  46   1          else
  47   1              {
  48   2                      crystal_clk = rch24m*2;  
  49   2              }    
  50   1          switch(system_clk_hz)
  51   1          {
  52   2              case 24000000:
  53   2                  RCHDIV = (0x1<<0);                          //RCH 2分频
C51 COMPILER V9.57.0.0   SYSTEM_UM800Y                                                     06/04/2026 15:08:28 PAGE 2   

  54   2                  system_core_clock = crystal_clk/2;
  55   2                  break;
  56   2              case 16000000:
  57   2                  RCHDIV = (0x2<<0);                          //RCH 3分频
  58   2                  system_core_clock = crystal_clk/3;
  59   2                  break;
  60   2              case 12000000:
  61   2                  RCHDIV = (0x3<<0);                          //RCH 4分频
  62   2                  system_core_clock = crystal_clk/4;
  63   2                  break;
  64   2              default:
  65   2                  RCHDIV = (0x2<<0);                          //RCH 3分频
  66   2                  system_core_clock = crystal_clk/3;
  67   2                  break;
  68   2                 
  69   2          }
  70   1                                                              
  71   1              CLKCON &= ~(0x1<<0);                                    //RCH为系统时钟
  72   1              SYSDIV &= ~(7<<0);                                              //系统时钟不分频                        
  73   1      }
  74          
  75          /************************************************************************
  76           * Function     : system_init
  77           * Description  : system_init
  78           * Input                : none
  79           * Output               : none
  80           * Return               : none
  81           ************************************************************************/
  82          void system_init(void)
  83          {
  84   1          clock_init(FCLK); 
  85   1      }
