 114           /************************************************************************
 115           * function     : adc_continuous_mode_test
C51 COMPILER V9.57.0.0   APP                                                               06/06/2026 18:20:25 PAGE 3   

 116           * Description  : adc_continuous_mode_test 
 117           * input                : none
 118           * return               : none
 119           ************************************************************************/
 120          void adc_continuous_mode_test(void)
 121          {
 122   1              if(adcget)
 123   1              {
 124   2                      adcget=0;
 125   2                      adc_datav/=adtime;              //求平均
 126   2                      if(adc_datav >500)              //大于阈值
 127   2                      {
 128   3                              gpio_io_set(P1_3, GPIO_LOW);            //拉低信号
 129   3                              cleanadctime=1;                                                                 //延时拉高
 130   3                      }
 131   2                      adc_datav=0;                                    //清除十次计数
 132   2                      adc_count=0;                                    //清除ad值
 133   2                              adc_controller_config(ADC_ENABLE);                                                                      //ADC控制器启动 
 134   2                              adc_convert_start(ADC_CHANNEL_1);                                                                       //启动转换      
 135   2              }
 136   1                      
 137   1      }
