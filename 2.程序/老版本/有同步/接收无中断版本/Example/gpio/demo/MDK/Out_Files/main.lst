1213   1          th = g_threshold + RX_ON_MARGIN_ADC;
1214   1      
1215   1          /*
1216   1           * 防止阈值超过 ADC 最大值。
1217   1           */
1218   1          if(th > ADC_MAX_VALUE)
1219   1          {
1220   2              th = ADC_MAX_VALUE;
1221   2          }
1222   1      
1223   1          if(adc_value >= th)
1224   1          {
1225   2              return 1;
1226   2          }
1227   1      
1228   1      #else
              
                  /*
C51 COMPILER V9.57.0.0   MAIN                                                              06/06/2026 11:08:49 PAGE 21  

                   * 低脉冲有效：
                   *
                   * 只有 ADC 低于：
                   *  g_threshold - RX_ON_MARGIN_ADC
                   * 才认为进入有效脉冲。
