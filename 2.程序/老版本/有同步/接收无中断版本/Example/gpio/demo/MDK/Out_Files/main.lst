1269   1          if(g_threshold > RX_OFF_MARGIN_ADC)
1270   1          {
1271   2              th = g_threshold - RX_OFF_MARGIN_ADC;
1272   2          }
1273   1          else
1274   1          {
1275   2              th = 0;
1276   2          }
1277   1      
1278   1          if(adc_value <= th)
1279   1          {
1280   2              return 1;
1281   2          }
1282   1      
1283   1      #else
              
                  /*
                   * 低脉冲有效：
                   *
                   * 当 ADC 高于：
                   *  g_threshold + RX_OFF_MARGIN_ADC
                   * 认为脉冲已经结束。
                   */
                  th = g_threshold + RX_OFF_MARGIN_ADC;
C51 COMPILER V9.57.0.0   MAIN                                                              06/06/2026 11:08:49 PAGE 22  

              
                  if(th > ADC_MAX_VALUE)
                  {
                      th = ADC_MAX_VALUE;
                  }
              
                  if(adc_value >= th)
                  {
                      return 1;
                  }
              
              #endif
1305   1      
1306   1          return 0;
1307   1      }
