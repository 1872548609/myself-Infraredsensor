 920   1      
C51 COMPILER V9.57.0.0   MAIN                                                              06/06/2026 11:08:49 PAGE 16  

 921   1          /*
 922   1           * 保存到全局变量，方便调试观察。
 923   1           */
 924   1          g_adc_signal = signal;
 925   1      
 926   1          /*
 927   1           * 本次采样达到“进入有效脉冲”的阈值。
 928   1           *
 929   1           * 只要读到有效电平，就说明光路仍然存在，
 930   1           * 所以必须立即清零连续无效读取次数。
 931   1           */
 932   1          if(signal_enter_active(signal))
 933   1          {
 934   2              /*
 935   2               * 串口调试只记录有效脉冲幅度。
 936   2               *
 937   2               * 这里不会记录 S=0 或背景值；
 938   2               * 只有超过进入阈值的 ADC 值才进入串口调试缓存。
 939   2               */
 940   2              uart_adc_debug_record_valid_signal(signal);
 941   2      
 942   2              g_invalid_sample_count = 0;
 943   2      
 944   2              /*
 945   2               * 只有从“脉冲外”进入“脉冲内”时，才计 1 个有效脉冲。
 946   2               *
 947   2               * 如果一个脉冲持续了多个 ADC 扫描周期，
 948   2               * 后续扫描虽然仍然有效，但不能重复计数，
 949   2               * 否则一个宽脉冲会被误认为很多个脉冲。
 950   2               */
 951   2              if(g_in_pulse == 0)
 952   2              {
 953   3                  g_in_pulse = 1;
 954   3                  valid_pulse_process();
 955   3              }
 956   2      
 957   2              return;
 958   2          }
 959   1      
 960   1          /*
 961   1           * 走到这里，说明本次 ADC 读取没有达到有效脉冲阈值。
