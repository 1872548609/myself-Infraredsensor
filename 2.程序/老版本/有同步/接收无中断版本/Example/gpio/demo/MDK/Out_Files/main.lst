1313          static void uart_adc_debug_record_valid_signal(uint16_t signal)
1314          {
1315   1      #if UART_ADC_DEBUG_ENABLE
1316   1          /*
1317   1           * 只记录已经超过有效阈值的 ADC 值。
1318   1           *
