1027          static void invalid_sample_process(void)
1028          {
1029   1          /*
1030   1           * 连续无效 ADC 读取计数累加。
1031   1           *
1032   1           * 这里统计的是“ADC 采样次数”，不是毫秒数。
1033   1           * 因此它和 adc_read_once() 的耗时、ADJ 更新占用时间、主频有关。
1034   1           */
1035   1          if(g_invalid_sample_count < 65535U)
1036   1          {
1037   2              g_invalid_sample_count++;
1038   2          }
1039   1      
1040   1          /*
1041   1           * 连续无效次数没有达到确认值之前，不改变输出。
1042   1           *
