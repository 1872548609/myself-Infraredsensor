 857           *====================================================================*/
 858          
C51 COMPILER V9.57.0.0   MAIN                                                              06/06/2026 11:08:49 PAGE 15  

 859          static uint16_t adc_read_once(uint8_t ch)
 860          {
 861   1          uint16_t value;
 862   1      
 863   1          /*
 864   1           * 启动指定通道 ADC 转换。
 865   1           */
 866   1          adc_convert_start(ch);
 867   1      
 868   1          /*
 869   1           * 等待 ADC 启动/忙状态结束。
 870   1           *
 871   1           * 这里沿用旧代码的等待方式。
 872   1           */
 873   1          while((ADCGCR1 & 0x04) != 0);
 874   1      
 875   1          /*
 876   1           * 等待 ADC 转换完成。
 877   1           */
 878   1          while(!(ADCCSTAT & 0x01));
 879   1      
 880   1          /*
 881   1           * 清除 ADC 转换完成标志。
 882   1           */
 883   1          ADCCSTAT = 0x01;
 884   1      
 885   1          /*
 886   1           * 读取 ADC 转换值。
 887   1           */
 888   1          value = adc_get_value();
 889   1      
 890   1          /*
 891   1           * 限幅，防止异常值超过 12 位范围。
 892   1           */
 893   1          if(value > ADC_MAX_VALUE)
 894   1          {
 895   2              value = ADC_MAX_VALUE;
 896   2          }
 897   1      
 898   1          return value;
 899   1      }
