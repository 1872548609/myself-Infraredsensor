 179          /*======================================================================
 180           * 五、Timer0 软件时间基准
 181           *====================================================================*/
 182          
 183          /*
 184           * Timer0 配置为 10us 溢出一次。
 185           *
 186           * 计算方式：
 187           *  主频 24MHz；
 188           *  TIMER0_PRESCALER = 24 - 1；
 189           *  Timer 计数频率 = 24MHz / 24 = 1MHz；
 190           *  1 个计数周期 = 1us；
 191           *  自动重装值 10，约等于 10us 溢出一次。
 192           *
 193           * 注意：
 194           *  Timer0 这里只提供时间基准。
 195           *  ADC 不等 Timer0；
 196           *  ADC 在 while(1) 里一直扫。
 197           */
 198          #define TIMER0_TICK_US                  10U
 199          #define TIMER0_10US_RELOAD              10U
 200          #define TIMER0_PRESCALER                (24U - 1U)
 201          
 202          /*
 203           * 时间换算宏。
 204           *
 205           * 后续所有“超时 / 周期”都先写成 ms 或 us，
 206           * 再统一换算成 Timer0 tick。
 207           *
 208           * 这样以后如果 Timer0 从 10us 改成 20us / 50us，
 209           * 只需要改 TIMER0_TICK_US 和 TIMER0_xxUS_RELOAD，
 210           * 不需要到处手动改计数值，避免时间错误。
 211           */
 212          #define TIMER0_US_TO_TICKS(us)          ((uint16_t)(((uint32_t)(us) + (TIMER0_TICK_US - 1U)) / TIMER0_TICK
             -_US))
 213          #define TIMER0_MS_TO_TICKS(ms)          TIMER0_US_TO_TICKS((uint32_t)(ms) * 1000UL)
 214          
 215          /*
 216           * 有些库文件里已经定义了 GTIMER0_UIF。
 217           * 如果没有定义，这里补一个默认值。
 218           * UIF 是 Timer0 溢出标志位。
 219           */
 220          #ifndef GTIMER0_UIF
              #define GTIMER0_UIF                     0x01
              #endif
 223          
