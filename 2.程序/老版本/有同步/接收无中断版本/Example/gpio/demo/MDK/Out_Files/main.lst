 985          /*======================================================================
 986           * 十五、有效脉冲处理
 987           *====================================================================*/
 988          
 989          static void valid_pulse_process(void)
 990          {
 991   1          /*
 992   1           * 捕捉到有效脉冲后，连续无效读取次数必须清零。
 993   1           *
 994   1           * 这是本次取消定时器超时后的关键点：
 995   1           *  遮光只看“连续无效读取次数”；
 996   1           *  只要中途出现一次有效脉冲，就不能继续沿用之前的无效计数。
 997   1           */
 998   1          g_invalid_sample_count = 0;
 999   1      
1000   1          /*
1001   1           * 连续有效脉冲计数累加。
1002   1           *
1003   1           * 限制最大 255，防止溢出。
1004   1           */
1005   1          if(g_valid_pulse_count < 255U)
1006   1          {
1007   2              g_valid_pulse_count++;
1008   2          }
1009   1      
1010   1          /*
1011   1           * 连续有效脉冲达到确认次数后，判定收到光。
1012   1           */
1013   1          if(g_valid_pulse_count >= RX_PULSE_CONFIRM_COUNT)
1014   1          {
1015   2              /*
1016   2               * 状态从遮光变为有光时，才刷新输出。
1017   2               * 如果原来已经是有光状态，则不重复写 GPIO。
1018   2               */
1019   2              if(g_light_ok == 0)
1020   2              {
1021   3                  g_light_ok = 1;
1022   3                  output_apply(1);
1023   3              }
1024   2          }
1025   1      }
