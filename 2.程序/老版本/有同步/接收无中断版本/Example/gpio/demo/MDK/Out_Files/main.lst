 808   1          if(REG_GTIM0_SR & GTIMER0_UIF)
 809   1          {
 810   2              /*
 811   2               * 清除 UIF 标志。
 812   2               */
 813   2              REG_GTIM0_SR = GTIMER0_UIF;
 814   2      
 815   2              /*
 816   2               * 软件时间 +1。
 817   2               *
 818   2               * 单位：10us。
 819   2               */
 820   2              g_tick_10us++;
 821   2      
 822   2              /*
 823   2               * ADJ 阈值低速更新计数。
 824   2               */
 825   2              g_adj_update_tick++;
 826   2      
 827   2              /*
 828   2               * 到达 ADJ 更新周期后，读取电位器并更新阈值。
 829   2               */
 830   2              if(g_adj_update_tick >= ADJ_UPDATE_PERIOD_TICKS)
 831   2              {
 832   3                  g_adj_update_tick = 0;
 833   3                  threshold_update_process();
 834   3              }
 835   2      
 836   2      
 837   2      #if UART_ADC_DEBUG_ENABLE
 838   2              /*
 839   2               * 串口有效脉冲幅度调试周期计数。
 840   2               *
 841   2               * 这里只置位发送标志，不在这里直接 printfS，
 842   2               * 避免把 Timer0 轮询处理变得太重。
 843   2               */
 844   2              g_uart_adc_debug_tick++;
 845   2              if(g_uart_adc_debug_tick >= UART_ADC_DEBUG_PERIOD_TICKS)
 846   2              {
 847   3                  g_uart_adc_debug_tick = 0;
 848   3                  g_uart_adc_debug_send_flag = 1;
 849   3              }
 850   2      #endif
 851   2          }
 852   1      }
