 971   2              g_in_pulse = 0;
 972   2          }
 973   1      
 974   1          /*
 975   1           * 连续无效 ADC 读取计数。
 976   1           *
 977   1           * 两个有效脉冲之间会自然出现很多次无效读取，
 978   1           * 所以 RX_INVALID_SAMPLE_CONFIRM_COUNT 必须根据实际 ADC 扫描速度
 979   1           * 和发射周期调整，不能过小。
 980   1           */
 981   1          invalid_sample_process();
 982   1      }
