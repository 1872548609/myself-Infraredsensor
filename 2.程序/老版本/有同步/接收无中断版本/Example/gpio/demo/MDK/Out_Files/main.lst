 428          static void capture_timer_start(void)
 429          {
 430   1          /*
 431   1           * 每一帧重新从 0 开始计时。
 432   1           * 这里相当于打开本帧采集定时。
 433   1           */
 434   1          REG_GTIM0_SR = 0x07;
 435   1          REG_GTIM0_CNT0 = 0x00;
 436   1          REG_GTIM0_CNT1 = 0x00;
 437   1          gtimer0_start();
 438   1      }
 439          
 440          static void capture_timer_close(void)
 441          {
 442   1          /*
 443   1           * 旧工程库里只使用 gtimer0_start()，没有统一暴露 stop 接口。
 444   1           * 所以这里做“逻辑关闭”：本帧结束后不再读取 Timer0 判断采集时间，
 445   1           * 下一帧开始时重新清零计数器。
 446   1           */
 447   1          REG_GTIM0_SR = 0x07;
 448   1      }
 449          
 450          static uint16_t capture_timer_us(void)
 451          {
 452   1          uint8_t hi1;
 453   1          uint8_t hi2;
 454   1          uint8_t lo;
 455   1      
 456   1          do
 457   1          {
 458   2              hi1 = REG_GTIM0_CNT1;
 459   2              lo  = REG_GTIM0_CNT0;
 460   2              hi2 = REG_GTIM0_CNT1;
 461   2          } while(hi1 != hi2);
 462   1      
 463   1          return ((uint16_t)hi1 << 8) | (uint16_t)lo;
 464   1      }
