1200          static uint8_t signal_enter_active(uint16_t adc_value)
1201          {
1202   1          uint16_t th;
1203   1      
1204   1      #if RX_SIGNAL_ACTIVE_HIGH
1205   1      
1206   1          /*
1207   1           * 高脉冲有效：
1208   1           *
1209   1           * 只有 ADC 高于：
