1330   1           */
1331   1          if(signal > g_uart_valid_pulse_amp_max)
1332   1          {
1333   2              g_uart_valid_pulse_amp_max = signal;
1334   2          }
1335   1      
1336   1          /*
1337   1           * 统计本周期内采到过多少个有效 ADC 点。
1338   1           *
