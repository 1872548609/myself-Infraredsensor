1068          /*======================================================================
1069           * 十六、遮光判断说明
1070           *====================================================================*/
1071          /*
1072           * 本版本不再使用定时器遮光超时函数。
1073           *
1074           * 旧逻辑：
1075           *  Timer0 每 10us 计数，超过固定毫秒数没有收到脉冲，就认为遮光。
1076           *
1077           * 新逻辑：
1078           *  不再用时间判断遮光，而是用“连续无效 ADC 读取次数”判断遮光。
1079           *  也就是：
1080           *      有效脉冲出现 -> g_invalid_sample_count 清 0；
1081           *      明确无效读取 -> g_invalid_sample_count 加 1；
1082           *      连续无效超过 RX_INVALID_SAMPLE_CONFIRM_COUNT -> 遮光。
1083           *
1084           * 优点：
1085           *  去掉了遮光判定对 Timer0 超时时间的依赖。
1086           *
1087           * 注意：
1088           *  因为这是按 ADC 读取次数计数，不是按真实时间计数，
1089           *  所以 RX_INVALID_SAMPLE_CONFIRM_COUNT 需要结合现场发射周期和 ADC 扫描速度调整。
1090           */
1091          
1092          
1093          /*======================================================================
1094           * 十七、ADJ 阈值更新
1095           *====================================================================*/
1096          static void threshold_update_process(void)
1097          {
1098   1          uint16_t adj;
1099   1          uint16_t new_threshold;
1100   1      
1101   1          /*
1102   1           * 读取 ADJ 电位器。
1103   1           *
1104   1           * 这里只读取一次，不做多次平均。
1105   1           * 原因：
1106   1           *  ADJ 更新函数虽然是低速运行，
C51 COMPILER V9.57.0.0   MAIN                                                              06/06/2026 11:08:49 PAGE 19  

1107   1           *  但也不应该长时间占用 ADC，
1108   1           *  否则可能影响接收脉冲捕捉。
1109   1           */
1110   1          adj = adc_read_once(IR_ADJ_ADC_CHANNEL);
1111   1      
1112   1          /*
1113   1           * 保存 ADJ 原始值，方便调试观察。
1114   1           */
1115   1          g_adc_adj = adj;
1116   1      
1117   1          /*
1118   1           * 把 ADJ 原始 ADC 值映射成实际接收阈值。
1119   1           */
1120   1          new_threshold = threshold_map_from_adj(adj);
1121   1      
1122   1          /*
1123   1           * 第一次初始化时，直接同步阈值。
1124   1           *
1125   1           * 不做 IIR，否则刚上电阈值会慢慢逼近，导致前几十毫秒判断不准。
1126   1           */
1127   1          if(g_threshold_init == 0)
1128   1          {
1129   2              g_threshold_init = 1;
1130   2              g_threshold_filter = ((uint32_t)new_threshold << ADJ_FILTER_SHIFT);
1131   2              g_threshold = new_threshold;
1132   2              return;
1133   2          }
1134   1      
1135   1          /*
1136   1           * IIR 平滑滤波。
1137   1           *
1138   1           * 等价于：
1139   1           *  g_threshold = 7/8 * old + 1/8 * new
1140   1           *
1141   1           * 目的：
1142   1           *  避免电位器轻微抖动导致阈值抖动；
1143   1           *  避免输出在临界点来回跳。
1144   1           */
1145   1          g_threshold_filter -= (g_threshold_filter >> ADJ_FILTER_SHIFT);
1146   1          g_threshold_filter += new_threshold;
1147   1      
1148   1          /*
1149   1           * 还原成实际阈值。
1150   1           */
1151   1          g_threshold = (uint16_t)(g_threshold_filter >> ADJ_FILTER_SHIFT);
1152   1      
1153   1          /*
1154   1           * 阈值限幅。
1155   1           */
1156   1          if(g_threshold < THRESHOLD_MIN_ADC)
1157   1          {
1158   2              g_threshold = THRESHOLD_MIN_ADC;
1159   2          }
1160   1          else if(g_threshold > THRESHOLD_MAX_ADC)
1161   1          {
1162   2              g_threshold = THRESHOLD_MAX_ADC;
1163   2          }
1164   1      }
1165          
1166          static uint16_t threshold_map_from_adj(uint16_t adj)
1167          {
1168   1          uint32_t span;
C51 COMPILER V9.57.0.0   MAIN                                                              06/06/2026 11:08:49 PAGE 20  

1169   1          uint16_t threshold;
1170   1      
1171   1          /*
1172   1           * ADJ 限幅到 12 位 ADC 范围。
1173   1           */
1174   1          if(adj > ADC_MAX_VALUE)
1175   1          {
1176   2              adj = ADC_MAX_VALUE;
1177   2          }
1178   1      
1179   1          /*
1180   1           * 阈值范围跨度。
1181   1           */
1182   1          span = (uint32_t)(THRESHOLD_MAX_ADC - THRESHOLD_MIN_ADC);
1183   1      
1184   1          /*
1185   1           * 线性映射：
1186   1           *
1187   1           *  adj = 0    -> threshold = THRESHOLD_MIN_ADC
1188   1           *  adj = 4095 -> threshold = THRESHOLD_MAX_ADC
1189   1           */
1190   1          threshold = (uint16_t)(THRESHOLD_MIN_ADC +
1191   1                      ((uint32_t)adj * span) / ADC_MAX_VALUE);
1192   1      
1193   1          return threshold;
1194   1      }
