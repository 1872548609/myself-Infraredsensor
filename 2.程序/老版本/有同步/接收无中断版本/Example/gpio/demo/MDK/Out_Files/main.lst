1408          static void output_apply(uint8_t light_ok)
1409          {
1410   1          uint8_t output_active;
1411   1      
1412   1          /*
1413   1           * 根据亮通/暗通模式，决定输出是否动作。
1414   1           */
1415   1      #if SENSOR_DARK_ON
                  /*
C51 COMPILER V9.57.0.0   MAIN                                                              06/06/2026 11:08:49 PAGE 24  

                   * 暗通：
                   *  有光 -> 输出不动作
                   *  遮光 -> 输出动作
                   */
                  output_active = light_ok ? 0 : 1;
              #else
1423   1          /*
1424   1           * 亮通：
1425   1           *  有光 -> 输出动作
1426   1           *  遮光 -> 输出不动作
1427   1           */
1428   1          output_active = light_ok ? 1 : 0;
1429   1      #endif
1430   1      
1431   1          /*
1432   1           * NO / NC 互补输出。
1433   1           */
1434   1          if(output_active)
1435   1          {
1436   2              /*
1437   2               * 输出动作：
1438   2               *  NO 动作；
1439   2               *  NC 释放。
1440   2               */
1441   2              gpio_io_set(IR_OUT_NO_PIN, OUT_ACTIVE_LEVEL);
1442   2              gpio_io_set(IR_OUT_NC_PIN, OUT_INACTIVE_LEVEL);
1443   2          }
1444   1          else
1445   1          {
1446   2              /*
1447   2               * 输出不动作：
1448   2               *  NO 释放；
1449   2               *  NC 动作。
1450   2               */
1451   2              gpio_io_set(IR_OUT_NO_PIN, OUT_INACTIVE_LEVEL);
1452   2              gpio_io_set(IR_OUT_NC_PIN, OUT_ACTIVE_LEVEL);
1453   2          }
1454   1      
1455   1          /*
1456   1           * LED 显示收到光状态。
1457   1           *
1458   1           * 注意：
1459   1           *  LED 不跟随亮通/暗通模式；
1460   1           *  LED 只表示光路是否通。
1461   1           */
1462   1          if(light_ok)
1463   1          {
1464   2              gpio_io_set(IR_LED_PIN, LED_ACTIVE_LEVEL);
1465   2          }
1466   1          else
1467   1          {
1468   2              gpio_io_set(IR_LED_PIN, LED_INACTIVE_LEVEL);
1469   2          }
1470   1      
1471   1          /*
1472   1           * 保存当前输出状态，方便调试观察。
1473   1           */
1474   1          g_output_state = output_active;
1475   1      }
