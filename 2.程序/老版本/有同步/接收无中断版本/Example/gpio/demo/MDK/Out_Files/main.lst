 902          /*======================================================================
 903           * 十四、连续快速扫描接收信号
 904           *====================================================================*/
 905          
 906          static void signal_fast_scan_process(void)
 907          {
 908   1          uint16_t signal;
 909   1      
 910   1          /*
 911   1           * 每次主循环只读取一次接收信号 ADC。
 912   1           *
 913   1           * 这里不要做多次平均。
 914   1           * 原因：
 915   1           *  发射有效光是窄脉冲；
 916   1           *  多次平均会把脉冲峰值平均掉；
