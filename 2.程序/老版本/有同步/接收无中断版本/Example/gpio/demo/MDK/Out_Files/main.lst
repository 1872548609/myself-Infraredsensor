 228          
 229          /*
 230           * 电位器 ADJ 映射出来的阈值范围。
 231           *
 232           * ADJ 的 ADC 范围理论是 0 ~ 4095。
 233           * 这里把它映射成 THRESHOLD_MIN_ADC ~ THRESHOLD_MAX_ADC。
 234           *
 235           * 如果距离不够：
 236           *  说明要求的信号太高，阈值太高；
 237           *  可以降低 THRESHOLD_MIN_ADC 和 THRESHOLD_MAX_ADC。
 238           *
C51 COMPILER V9.57.0.0   MAIN                                                              06/06/2026 11:08:49 PAGE 5   

 239           * 如果误触发多：
 240           *  说明阈值太低；
 241           *  可以提高 THRESHOLD_MIN_ADC 和 THRESHOLD_MAX_ADC。
 242           */
 243          #define THRESHOLD_MIN_ADC               800U    //650U
 244          #define THRESHOLD_MAX_ADC               3200U   //2800U
 245          #define THRESHOLD_DEFAULT_ADC           1300U
 246          
 247          /*
 248           * 脉冲进入阈值迟滞。
 249           *
 250           * 高脉冲有效时：
 251           *  ADC >= g_threshold + RX_ON_MARGIN_ADC
 252           *  才认为进入有效脉冲。
 253           *
 254           * 这样可以避免 ADC 在阈值附近轻微波动时误触发。
 255           */
 256          #define RX_ON_MARGIN_ADC                100U
 257          
 258          /*
 259           * 脉冲离开阈值迟滞。
 260           *
 261           * 高脉冲有效时：
 262           *  ADC <= g_threshold - RX_OFF_MARGIN_ADC
 263           *  才认为当前脉冲已经结束。
 264           *
 265           * 这样可以保证一个宽脉冲只计一次，不会在一个脉冲内部重复计数。
 266           */
 267          #define RX_OFF_MARGIN_ADC               100U
 268          
 269          /*
 270           * 连续有效脉冲确认次数。
 271           *
 272           * 捕捉到 1 个脉冲，不一定马上认为有光；
 273           * 连续捕捉到 RX_PULSE_CONFIRM_COUNT 个有效脉冲后，才确认有光。
 274           *
 275           * 值越大：
 276           *  抗干扰越强；
 277           *  响应越慢。
 278           *
 279           * 值越小：
 280           *  响应越快；
 281           *  但容易被单个干扰脉冲误触发。
 282           */
 283          #define RX_PULSE_CONFIRM_COUNT          2U
 284          
 285          
 286          /*
 287           * 连续无效 ADC 读取确认次数。
 288           *
 289           * 这版取消了“定时器遮光超时”，遮光判定改成：
 290           *  连续 RX_INVALID_SAMPLE_CONFIRM_COUNT 次 ADC 读取都处于无效区，
 291           *  才认为遮光。
 292           *
 293           * 注意：
 294           *  发射端是窄脉冲，两个有效脉冲之间本来就会读到很多次无效值。
 295           *  所以这个值不能太小。
 296           *  如果无遮挡时也容易误判遮光，就增大这个值。
 297           *  如果遮光响应太慢，就减小这个值。
 298           */
 299          #define RX_INVALID_SAMPLE_CONFIRM_COUNT 100U
 300          
