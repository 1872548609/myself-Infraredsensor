 539           *====================================================================*/
 540          
 541          void main(void)
 542          {
 543   1          /*
 544   1           * 系统初始化。
 545   1           *
 546   1           * system_init() 内部会根据 config.h 的 FCLK 配置系统时钟。
 547   1           * 这里要求 config.h 中：
 548   1           *  #define FCLK 24000000
C51 COMPILER V9.57.0.0   MAIN                                                              06/06/2026 11:08:49 PAGE 10  

 549   1           */
 550   1          system_init();
 551   1      
 552   1          /*
 553   1           * 初始化 GPIO。
 554   1           *
 555   1           * 包括：
 556   1           *  P1.0 NO 输出
 557   1           *  P1.2 NC 输出
 558   1           *  P1.3 LED 输出
 559   1           *  P1.5 接收信号 ADC 脚
 560   1           */
 561   1          GPIO_Init();
 562   1      
 563   1          /*
 564   1           * 串口初始化。
 565   1           *
 566   1           * 注意：
 567   1           *  app.c 里的 uart_init() 要关闭 uart0_irq_init()。
 568   1           *  这版不使用 UART 中断。
 569   1           */
 570   1          uart_init();
 571   1      
 572   1          /*
 573   1           * ADC 初始化。
 574   1           *
 575   1           * 配置接收信号 ADC 通道和 ADJ 阈值 ADC 通道。
 576   1           */
 577   1          ADC_Init();
 578   1      
 579   1          /*
 580   1           * Timer0 初始化为 10us 轮询时间基准。
 581   1           *
 582   1           * 不打开 Timer0 中断。
 583   1           */
 584   1          timer0_init_poll_10us();
 585   1      
 586   1          /*
 587   1           * 上电后先读取一次 ADJ。
 588   1           *
 589   1           * 这样可以避免刚上电时使用默认阈值太久。
 590   1           */
 591   1          threshold_update_process();
 592   1      
 593   1          /*
 594   1           * 全局关闭中断。
 595   1           *
 596   1           * 这个是兜底处理。
 597   1           * 即使某些库函数不小心开了中断，也在这里关闭。
 598   1           */
 599   1          EA = 0;
 600   1      
 601   1          /*
 602   1           * 上电默认输出为遮光 / 未收到光状态。
 603   1           */
 604   1          output_apply(0);
 605   1      
 606   1          /*
 607   1           * 主循环。
 608   1           *
 609   1           * 重点：
 610   1           *  signal_fast_scan_process() 每一轮都执行。
C51 COMPILER V9.57.0.0   MAIN                                                              06/06/2026 11:08:49 PAGE 11  

 611   1           *  不等待 1ms；
 612   1           *  不等待 Timer；
 613   1           *  不做多次平均；
 614   1           *  目的就是尽量快地捕捉发射端窄脉冲。
 615   1           */
 616   1          while(1)
 617   1          {
 618   2              /*
 619   2               * 轮询 Timer0 溢出标志。
 620   2               *
 621   2               * 只更新时间基准和慢任务：
 622   2               *  1. Timer0 不再参与遮光判断；
 623   2               *  2. ADJ 阈值低速更新。
 624   2               */
 625   2              timer0_poll_process();
 626   2      
 627   2              /*
 628   2               * 连续快速扫描接收 ADC。
 629   2               *
 630   2               * 这是本程序最核心的部分。
 631   2               */
 632   2              signal_fast_scan_process();
 633   2      
 634   2      
 635   2              /*
 636   2               * 串口只回传有效脉冲幅度。
 637   2               *
 638   2               * 注意：
 639   2               *  没有有效脉冲时不会发送 S=0；
 640   2               *  只在本周期内捕捉到有效脉冲后，才发送该周期有效幅度最大值。
 641   2               */
 642   2              uart_adc_debug_process();
 643   2          }
 644   1      }
