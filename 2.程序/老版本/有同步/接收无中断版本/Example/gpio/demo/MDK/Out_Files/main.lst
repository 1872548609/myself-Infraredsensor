 216           */
 217          void GPIO_Init(void);
 218          /*
 219           * ADC_Init()：
 220           * 配置 ADC 时钟、参考电压、采样时间和通道。
 221           * 采样时间设置较短，是为了在 200us 窗口内尽量多采样，
 222           * 从而更容易抓到 25us 的窄脉冲峰值。
 223           */
 224          void ADC_Init(void);
 225          
 226          /*
 227           * timer0_init_1us_free_run()：
 228           * 把 Timer0 配置为 1us 自由运行计数器。
 229           * 本程序不依赖 Timer0 中断，只反复读取计数值作为时间戳。
 230           * uint16_t 计数会在 65.536ms 回绕，程序中的 time_sub_u16() 会处理回绕。
 231           */
 232          static void timer0_init_1us_free_run(void);
 233          /*
 234           * time_us16()：
 235           * 安全读取 Timer0 的 16 位计数值。
 236           * 由于高/低字节分开读取，所以采用“高-低-高”方式，
 237           * 两次高字节一致才认为读取稳定，避免低字节溢出时读错。
 238           */
 239          static uint16_t time_us16(void);
