  14           * Function     : PWM_IRQHandler
  15           * Description  : PWM中断处理函数   
  16           * Input        : none
  17           * Output               : none
  18           * Return               : none
  19           ***********************************************************************/
  20          void PWM_IRQHandler(void) interrupt 5
  21          {
  22   1              if((PWM0CON & (1<<1)))
  23   1              {
  24   2                      PWM0CON &= ~(1<<1);                                     // 清除PWM0溢出标志
  25   2                      if(pwmfunc_callback[0] != NULL)
  26   2                      {
  27   3                              pwmfunc_callback[0]();
  28   3                      }
  29   2              }
  30   1      
  31   1              if((PWM1CON & (1<<1)))
  32   1              {
  33   2                      PWM1CON &= ~(1<<1);                                     // 清除PWM1溢出标志     
  34   2                      if(pwmfunc_callback[1] != NULL)
  35   2                      {
  36   3                              pwmfunc_callback[1]();
  37   3                      }
  38   2              }
  39   1      
  40   1              if((PWM2CON & (1<<1)))
  41   1              {
  42   2                      PWM2CON &= ~(1<<1);                                     // 清除PWM2溢出标志
  43   2                      if(pwmfunc_callback[2] != NULL)
  44   2                      {
  45   3                              pwmfunc_callback[2]();
  46   3                      }
  47   2              }
  48   1      }
