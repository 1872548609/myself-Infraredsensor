  54           *                uint16_t duty  占空比
  55           *                uint8_t  level HIGH:占空比期间输出高电平；LOW:占空比期间输出低电平
  56           * Output               : none
  57           * Return               : none
  58           ***********************************************************************/
  59          void pwm0_init(uint16_t cycle, uint16_t duty, uint8_t level)  
  60          {
  61   1              REG_P10_CFG = 0x03;
  62   1              if(level == LOW)
  63   1              {
  64   2                  PWM0CON |= (1<<6);          // 占空比期间输出低电平 
  65   2              }
  66   1              else
  67   1              { 
  68   2                  PWM0CON &= ~(1<<6);         // 占空比期间输出高电平 
  69   2              }
  70   1               
  71   1          PWM0DL = duty&0xFF;                         // 占空比低8位 
  72   1          PWM0DH = (duty>>8)&0xFF;            // 占空比高8位 
  73   1              
  74   1          PWM0PL = cycle&0xFF;                        // 周期低8位 
  75   1          PWM0PH = (cycle>>8)&0xFF;           // 周期高8位 
  76   1                      
  77   1          PWM0CON |= (1<<7);                          //使能PWM0模块
  78   1      }       
  79          
  80          /***********************************************************************
  81           * Function     : pwm0_irq_init
