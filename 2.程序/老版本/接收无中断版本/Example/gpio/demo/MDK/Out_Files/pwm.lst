  84           * Output               : none
  85           * Return               : none
  86           ***********************************************************************/
  87          void pwm0_irq_init(em_pwm_irq mode,void (*pfunc)())
  88          {
  89   1              if(mode == PWM_IRQ_ENABLE)
  90   1              {
  91   2                      EA = 1;                                                         // 打开总中断 
  92   2                      EPWM = 1;                                                       // 打开PWM中断 
  93   2                      PWM0CON |= (1<<2);                                      // 允许PWM0中断 
  94   2                      pwmfunc_callback[0] = pfunc;
  95   2              }
  96   1              else
  97   1              {
  98   2                      EA = 0;                                                         // 关闭总中断，注意如果存在中断，关闭总中断时需要注意 
  99   2                      EPWM = 0;                                                       // 关闭PWM中断 
 100   2                      PWM0CON &= ~(1<<2);                                     //不允许PWM0中断 
 101   2              }
 102   1      }
