  44          {
  45   1              if(newstate == ADC_ENABLE)
  46   1              {
  47   2                      PCLK0 |= (1<<4);                                                                        //ADC时钟使能
  48   2                      PRESET0 |= (1<<4);                                                                      //ADC复位释放
  49   2                      
  50   2                      ADCGCR0 = (ADCGCR0 & (~(1<<6))) | (clksource<<6);       //ADC时钟源选择
  51   2                      
  52   2                      ADCCDR0 = 0;                                                                            //清零CLKDIV
  53   2                      ADCCDR1 = 0;
