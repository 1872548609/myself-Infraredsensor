 294           /************************************************************************
 295           * function     : adc_wait_state
 296           * Description  : adc_wait_state 
 297           * input                :       
 298           *                              uint8_t state    ：ADC STATE
 299           *                              uint16_t timeout ：ADC TIME OUT
 300           * return               : 
 301           *                              1：FAIL
C51 COMPILER V9.57.0.0   ADC                                                               06/04/2026 16:03:51 PAGE 6   

 302           *                              0：SUCCESS      
 303           ************************************************************************/
 304          uint8_t adc_wait_state(uint8_t state, uint16_t timeout)
 305          {
 306   1              if(state == ADC_STATE_CONVERT)
 307   1              {
 308   2                      while(timeout--)
 309   2                      {
 310   3                              if((ADCGCR1 & 0x04) == 0)                                               //转换完成，信号置0
 311   3                              {
 312   4                                      return ADC_SUCCESS;
 313   4                              }
 314   3                      }       
 315   2              }
 316   1              else
 317   1              {
 318   2                      while(timeout--)
 319   2                      {
 320   3                              if(ADCCSTAT & 0x01)                                                             //接收器BUF存有数据，信号置1
 321   3                              {
 322   4                                      return ADC_SUCCESS;
 323   4                              }
 324   3                      }       
 325   2              }
 326   1      
 327   1              return ADC_FAIL;
 328   1      }
