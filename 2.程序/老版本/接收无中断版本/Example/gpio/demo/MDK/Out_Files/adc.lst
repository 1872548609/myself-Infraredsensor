 378           /************************************************************************
 379           * function     : adc_get_ch_value
 380           * Description  : adc_get_ch_value 
 381           * input                :       
 382           *                              uint8_t ch      ：ADC Channel
 383           * return               : 12bit convert value of adc
 384           ************************************************************************/
 385          uint16_t adc_get_ch_value(uint8_t ch)
 386          {
 387   1              uint16_t status = 0;
 388   1              adc_convert_start(ch);                                                                  //选择转换通道并启动转换
 389   1              
 390   1              status = adc_wait_state(ADC_STATE_CONVERT, ADC_TIMEOUT);//等待转换结束
 391   1              if(status == ADC_FAIL)
 392   1              {
 393   2                      return ADC_INVALID;
 394   2              }
 395   1              
 396   1              status = adc_wait_state(ADC_STATE_BUF, ADC_TIMEOUT);    //等待接收器BUF存有数据
 397   1              if(status == ADC_FAIL)
 398   1              {
 399   2                      return ADC_INVALID;
 400   2              }
 401   1              
 402   1              adc_clear_buf_state();                                                                  //清除BUF状态位
 403   1              
 404   1              return adc_get_value();
 405   1      }
