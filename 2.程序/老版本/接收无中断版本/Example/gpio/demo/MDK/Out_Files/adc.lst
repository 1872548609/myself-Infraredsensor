 357           ************************************************************************/
 358          uint16_t adc_get_value(void)
 359          {
 360   1              /*做速率补偿*/
 361   1              uint16_t temp = 0;
 362   1              
 363   1              temp = ADCDR & 0x0FFF;
C51 COMPILER V9.57.0.0   ADC                                                               06/04/2026 16:03:51 PAGE 7   

 364   1              
 365   1              if(temp > 1)
 366   1              {
 367   2                      temp += 5;
 368   2              }
 369   1              if(temp > 4095)
 370   1              {
 371   2                      temp = 4095;
 372   2              }
 373   1              
 374   1              return temp;                                                            //12bit转换数据
 375   1      
 376   1      }
