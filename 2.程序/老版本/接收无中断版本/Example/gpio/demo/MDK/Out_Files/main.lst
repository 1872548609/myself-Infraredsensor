 936          static void threshold_update_process(void)
 937          {
 938   1          uint16_t adj;
 939   1          uint16_t new_threshold;
 940   1      
 941   1          /*
 942   1           * 读取 ADJ 电位器。
 943   1           *
 944   1           * 这里只读取一次，不做多次平均。
 945   1           * 原因：
 946   1           *  ADJ 更新函数虽然是低速运行，
 947   1           *  但也不应该长时间占用 ADC，
 948   1           *  否则可能影响接收脉冲捕捉。
 949   1           */
 950   1          adj = adc_read_once(IR_ADJ_ADC_CHANNEL);
 951   1      
 952   1          /*
 953   1           * 保存 ADJ 原始值，方便调试观察。
 954   1           */
 955   1          g_adc_adj = adj;
 956   1      
 957   1          /*
 958   1           * 把 ADJ 原始 ADC 值映射成实际接收阈值。
 959   1           */
 960   1          new_threshold = threshold_map_from_adj(adj);
 961   1      
 962   1          /*
 963   1           * 第一次初始化时，直接同步阈值。
 964   1           *
 965   1           * 不做 IIR，否则刚上电阈值会慢慢逼近，导致前几十毫秒判断不准。
 966   1           */
 967   1          if(g_threshold_init == 0)
 968   1          {
 969   2              g_threshold_init = 1;
 970   2              g_threshold_filter = ((uint32_t)new_threshold << ADJ_FILTER_SHIFT);
 971   2              g_threshold = new_threshold;
 972   2              return;
 973   2          }
 974   1      
 975   1          /*
 976   1           * IIR 平滑滤波。
 977   1           *
 978   1           * 等价于：
 979   1           *  g_threshold = 7/8 * old + 1/8 * new
 980   1           *
 981   1           * 目的：
 982   1           *  避免电位器轻微抖动导致阈值抖动；
 983   1           *  避免输出在临界点来回跳。
C51 COMPILER V9.57.0.0   MAIN                                                              06/04/2026 16:03:50 PAGE 17  

 984   1           */
 985   1          g_threshold_filter -= (g_threshold_filter >> ADJ_FILTER_SHIFT);
 986   1          g_threshold_filter += new_threshold;
 987   1      
 988   1          /*
 989   1           * 还原成实际阈值。
 990   1           */
 991   1          g_threshold = (uint16_t)(g_threshold_filter >> ADJ_FILTER_SHIFT);
 992   1      
 993   1          /*
 994   1           * 阈值限幅。
 995   1           */
 996   1          if(g_threshold < THRESHOLD_MIN_ADC)
 997   1          {
 998   2              g_threshold = THRESHOLD_MIN_ADC;
 999   2          }
1000   1          else if(g_threshold > THRESHOLD_MAX_ADC)
1001   1          {
1002   2              g_threshold = THRESHOLD_MAX_ADC;
1003   2          }
1004   1      }
1005          
1006          static uint16_t threshold_map_from_adj(uint16_t adj)
1007          {
1008   1          uint32_t span;
1009   1          uint16_t threshold;
1010   1      
1011   1          /*
1012   1           * ADJ 限幅到 12 位 ADC 范围。
1013   1           */
1014   1          if(adj > ADC_MAX_VALUE)
1015   1          {
1016   2              adj = ADC_MAX_VALUE;
1017   2          }
1018   1      
1019   1          /*
1020   1           * 阈值范围跨度。
1021   1           */
1022   1          span = (uint32_t)(THRESHOLD_MAX_ADC - THRESHOLD_MIN_ADC);
1023   1      
1024   1          /*
1025   1           * 线性映射：
1026   1           *
1027   1           *  adj = 0    -> threshold = THRESHOLD_MIN_ADC
1028   1           *  adj = 4095 -> threshold = THRESHOLD_MAX_ADC
1029   1           */
1030   1          threshold = (uint16_t)(THRESHOLD_MIN_ADC +
1031   1                      ((uint32_t)adj * span) / ADC_MAX_VALUE);
1032   1      
1033   1          return threshold;
1034   1      }
