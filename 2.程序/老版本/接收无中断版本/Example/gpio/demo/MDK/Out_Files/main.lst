 208          
 209          /*
 210           * 电位器 ADJ 映射出来的阈值范围。
 211           *
 212           * ADJ 的 ADC 范围理论是 0 ~ 4095。
 213           * 这里把它映射成 THRESHOLD_MIN_ADC ~ THRESHOLD_MAX_ADC。
 214           *
 215           * 如果距离不够：
 216           *  说明要求的信号太高，阈值太高；
 217           *  可以降低 THRESHOLD_MIN_ADC 和 THRESHOLD_MAX_ADC。
 218           *
 219           * 如果误触发多：
 220           *  说明阈值太低；
 221           *  可以提高 THRESHOLD_MIN_ADC 和 THRESHOLD_MAX_ADC。
 222           */
 223          #define THRESHOLD_MIN_ADC               650U
 224          #define THRESHOLD_MAX_ADC               2800U
 225          #define THRESHOLD_DEFAULT_ADC           1300U
 226          
 227          /*
 228           * 脉冲进入阈值迟滞。
 229           *
 230           * 高脉冲有效时：
 231           *  ADC >= g_threshold + RX_ON_MARGIN_ADC
 232           *  才认为进入有效脉冲。
 233           *
 234           * 这样可以避免 ADC 在阈值附近轻微波动时误触发。
 235           */
 236          #define RX_ON_MARGIN_ADC                80U
 237          
 238          /*
 239           * 脉冲离开阈值迟滞。
C51 COMPILER V9.57.0.0   MAIN                                                              06/04/2026 16:03:50 PAGE 5   

 240           *
 241           * 高脉冲有效时：
 242           *  ADC <= g_threshold - RX_OFF_MARGIN_ADC
 243           *  才认为当前脉冲已经结束。
 244           *
 245           * 这样可以保证一个宽脉冲只计一次，不会在一个脉冲内部重复计数。
 246           */
 247          #define RX_OFF_MARGIN_ADC               80U
 248          
 249          /*
 250           * 连续有效脉冲确认次数。
 251           *
 252           * 捕捉到 1 个脉冲，不一定马上认为有光；
 253           * 连续捕捉到 RX_PULSE_CONFIRM_COUNT 个有效脉冲后，才确认有光。
 254           *
 255           * 值越大：
 256           *  抗干扰越强；
 257           *  响应越慢。
 258           *
 259           * 值越小：
 260           *  响应越快；
 261           *  但容易被单个干扰脉冲误触发。
 262           */
 263          #define RX_PULSE_CONFIRM_COUNT          2U
 264          
 265          /*
 266           * 丢光超时时间。
 267           *
 268           * 单位：100us。
 269           *
 270           * 50 * 100us = 5ms。
 271           *
 272           * 如果 5ms 内没有捕捉到任何有效脉冲，就认为遮光。
 273           *
 274           * 如果你的发射频率较低，或者脉冲周期较长，可以把这个值加大：
 275           *  80  -> 8ms
 276           *  100 -> 10ms
 277           *  150 -> 15ms
 278           */
 279          #define RX_LOST_TIMEOUT_100US           50U
 280          
 281          /*
 282           * ADJ 阈值更新周期。
 283           *
 284           * 单位：100us。
 285           *
 286           * 500 * 100us = 50ms。
 287           *
 288           * 为什么 ADJ 不一直扫？
 289           *  因为发射有效信号是窄脉冲；
 290           *  ADC 时间应该尽量让给接收信号；
 291           *  电位器变化很慢，50ms 更新一次足够。
 292           */
 293          #define ADJ_UPDATE_PERIOD_100US         500U
 294          
 295          /*
 296           * 阈值 IIR 滤波系数。
 297           *
 298           * ADJ_FILTER_SHIFT = 3 表示：
 299           *  新阈值 = 7/8 旧阈值 + 1/8 新采样值
 300           *
 301           * 这样电位器轻微抖动不会导致输出抖动。
C51 COMPILER V9.57.0.0   MAIN                                                              06/04/2026 16:03:50 PAGE 6   

 302           */
 303          #define ADJ_FILTER_SHIFT                3U
 304          
 305          /*
 306           * ADC 最大有效值。
 307           *
 308           * 12 位 ADC 理论最大 4095。
 309           */
 310          #define ADC_MAX_VALUE                   4095U
