 262   1      
 263   1          if(times == 0)
 264   1          {
 265   2              return adc_read_once(ch);
 266   2          }
 267   1      
 268   1          for(i = 0; i < times; i++)
 269   1          {
 270   2              value = adc_read_once(ch);
 271   2              sum += value;
 272   2      
 273   2              if(value < min_value)
 274   2              {
 275   3                  min_value = value;
 276   3              }
 277   2      
 278   2              if(value > max_value)
 279   2              {
 280   3                  max_value = value;
 281   3              }
 282   2          }
 283   1      
 284   1          /*
 285   1           * 4 点采样，去掉最大最小，提高电位器阈值抗抖。
 286   1           */
 287   1          if(times >= 4)
 288   1          {
 289   2              sum -= min_value;
 290   2              sum -= max_value;
 291   2              return (uint16_t)(sum / (times - 2));
 292   2          }
 293   1      
 294   1          return (uint16_t)(sum / times);
 295   1      }
