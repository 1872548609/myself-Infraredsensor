 255          static uint16_t adc_read_average(uint8_t ch, uint8_t times)
 256          {
 257   1          uint8_t i;
 258   1          uint16_t value;
 259   1          uint16_t min_value = 0xFFFF;
 260   1          uint16_t max_value = 0;
