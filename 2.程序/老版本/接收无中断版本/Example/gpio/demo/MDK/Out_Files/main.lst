 246   1          while((ADCGCR1 & 0x04) != 0);
 247   1          while(!(ADCCSTAT & 0x01));
 248   1      
 249   1          ADCCSTAT = 0x01;
 250   1          value = adc_get_value();
 251   1      
 252   1          return value;
 253   1      }
