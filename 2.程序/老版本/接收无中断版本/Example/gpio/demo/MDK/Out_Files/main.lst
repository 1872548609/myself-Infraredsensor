1150          /*======================================================================
1151           * 十九、输出控制
1152           *====================================================================*/
1153          static void output_apply(uint8_t light_ok)
1154          {
1155   1          uint8_t output_active;
1156   1      
1157   1          /*
1158   1           * 根据亮通/暗通模式，决定输出是否动作。
1159   1           */
1160   1      #if SENSOR_DARK_ON
                  /*
                   * 暗通：
                   *  有光 -> 输出不动作
                   *  遮光 -> 输出动作
                   */
                  output_active = light_ok ? 0 : 1;
              #else
1168   1          /*
1169   1           * 亮通：
C51 COMPILER V9.57.0.0   MAIN                                                              06/04/2026 16:03:50 PAGE 20  

1170   1           *  有光 -> 输出动作
1171   1           *  遮光 -> 输出不动作
1172   1           */
1173   1          output_active = light_ok ? 1 : 0;
1174   1      #endif
1175   1      
1176   1          /*
1177   1           * NO / NC 互补输出。
1178   1           */
1179   1          if(output_active)
1180   1          {
1181   2              /*
1182   2               * 输出动作：
1183   2               *  NO 动作；
1184   2               *  NC 释放。
1185   2               */
1186   2              gpio_io_set(IR_OUT_NO_PIN, OUT_ACTIVE_LEVEL);
1187   2              gpio_io_set(IR_OUT_NC_PIN, OUT_INACTIVE_LEVEL);
1188   2          }
1189   1          else
1190   1          {
1191   2              /*
1192   2               * 输出不动作：
1193   2               *  NO 释放；
1194   2               *  NC 动作。
1195   2               */
1196   2              gpio_io_set(IR_OUT_NO_PIN, OUT_INACTIVE_LEVEL);
1197   2              gpio_io_set(IR_OUT_NC_PIN, OUT_ACTIVE_LEVEL);
1198   2          }
1199   1      
1200   1          /*
1201   1           * LED 显示收到光状态。
1202   1           *
1203   1           * 注意：
1204   1           *  LED 不跟随亮通/暗通模式；
1205   1           *  LED 只表示光路是否通。
1206   1           */
1207   1          if(light_ok)
1208   1          {
1209   2              gpio_io_set(IR_LED_PIN, LED_ACTIVE_LEVEL);
1210   2          }
1211   1          else
1212   1          {
1213   2              gpio_io_set(IR_LED_PIN, LED_INACTIVE_LEVEL);
1214   2          }
1215   1      
1216   1          /*
1217   1           * 保存当前输出状态，方便调试观察。
1218   1           */
1219   1          g_output_state = output_active;
1220   1      }
