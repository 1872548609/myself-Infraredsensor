  10          #include  "beeper.h"
  11          
  12          
  13          /************************************************************************
  14           * function   : beeper_init
  15           * Description: beeper init
  16           * input : none
  17           * Output: none
  18           * return: none
  19           ************************************************************************/
  20          void beeper_init(void)
  21          {
  22   1               BEEPCTR |= (1<<4);         //BEEPER使能,P2.5作为BEEP功能
  23   1      }
  24          
  25          /************************************************************************
  26           * function   : beeper_level_set
  27           * Description: set beeper output polarity 
  28           * input : level ：0 低电平
  29                             1 高电平
  30           *         sel
  31           * Output: none
  32           * return: none
  33           ************************************************************************/
  34          void beeper_level_set(uint8_t level,uint8_t freq)
  35          {
  36   1              if(LOW == level)
  37   1              {
  38   2                  BEEPCTR &= ~(1<<2);         //BEEP输出低电平
  39   2              }
  40   1              else
  41   1              {
  42   2                  BEEPCTR |= (1<<2);         //BEEP输出高电平
  43   2              }
  44   1              BEEPCTR &= ~(3<<0);
  45   1              BEEPCTR |= (freq<<0);          //输出频率
  46   1      }
